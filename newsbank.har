          "content": {
            "size": 3369,
            "mimeType": "application/javascript",
            "text": "(function($) {\n  Drupal.behaviors.ActionBarEmailZustats = {\n    attach: function (context, settings) {\n\n      // Add the pbi hidden field to the form on the doc page only.\n      $('body.page-document-view .actions-bar__button--email', context).click(function() {\n        $('<input>').attr({\n          type: 'hidden',\n          value: settings.nbbase.pbi,\n          name: 'pbi'\n        }).appendTo(\"#nbcore-email-send-email-form\");\n      });\n    }\n  };\n\n  Drupal.behaviors.ActionBarRemoveButton = {\n    attach: function (context, settings) {\n      // If a hidden action bar form is present, remove the button because the\n      // mask and gradient ID's of the SVG's are duplicated and it breaks their\n      // functionality.\n      var $sendEmailPane = $('.pane-nbcore-email-send-email-pane', context);\n      if ($sendEmailPane.hasClass('hidden')) {\n        $sendEmailPane.find('.actions-bar__button--email').remove();\n      }\n    }\n  };\n\n  Drupal.behaviors.ActionBarEmailSendAnother = {\n    attach: function (context, settings) {\n      var $emailFormContainer = $('#action-bar-ascii-email-form, #action-bar-ha-email-form, #nbcore-email-form-search-results, #action-bar-headline-activity-email-form');\n      var $drawer = $emailFormContainer.parents('.actions-bar__drawer');\n\n      if ($emailFormContainer.hasClass('email-form-success')) {\n        // Reanimate the drawer and document body to take into account new drawer height.\n        Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n      }\n\n      // Remove any status/error messages from Email form.\n      function showFormHideLabel() {\n        // Re-query the DOM for the updated DOM node after Drupal's AJAX event.\n        $emailFormContainer = $('#action-bar-ascii-email-form, #action-bar-ha-email-form, #nbcore-email-form-search-results, #action-bar-headline-activity-email-form');\n\n        $emailFormContainer.removeClass('email-form-success');\n        $('.status', $emailFormContainer).css({'display' : 'none'});\n        $('.email-send-another', context).css({'display' : 'none'});\n      }\n\n      // Show email form when \"Send another email\" is clicked\n      $('.email-send-another', context).click(function() {\n        showFormHideLabel();\n\n        // Reanimate the drawer and document body to take into account new drawer height.\n        Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n      });\n\n      // Remove any email status messages when any action bar button is clicked.\n      $('.actions-bar__button', context).click(function() {\n        showFormHideLabel();\n      });\n    }\n  };\n\n  // Adds wrappers around email drawer labels for KidsPage styling.\n  Drupal.behaviors.ActionBarEmailLabels = {\n    attach: function (context, settings) {\n      // Labels.\n      $('.nb-product__JRKP .gnus-actions-bar-email label').once(function() {\n        var html = $(this).html();\n        html = html.replace(':', '');\n        var regex = /\\(required\\)/gi;\n        html = html.replace(regex, '<span class=\"label__required\">(required)</span>');\n        $(this).html(html);\n      });\n      // Subject.\n      $('.nb-product__JRKP .gnus-actions-bar-email .message-subject').once(function() {\n        var html = $(this).html();\n        var regex = /Subject:/gi;\n        html = html.replace(regex, '<span class=\"label__bold\">Subject</span>');\n        $(this).html(html);\n      });\n    }\n  };\n\n})(jQuery);\n"
          },
