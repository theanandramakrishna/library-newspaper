            "mimeType": "application/javascript",
            "text": "/**\r\n * @file\r\n * JavaScript file for nbcore_google module.\r\n */\r\n\r\n/**\r\n * Class to represent NB Google Drive functionality.\r\n * Manage: https://console.developers.google.com/apis/api/drive.googleapis.com/overview\r\n * See:\r\n *  - https://developers.google.com/drive/v3/web/branding\r\n *  - https://developers.google.com/drive/v3/reference/\r\n *  - https://developers.google.com/drive/v3/reference/files\r\n */\r\nvar NBGoogleDrive = function() {\r\n\r\n  // Custom appProperties used for all of our files/folders.\r\n  var appProperties = {\r\n    'appName': 'newsbank',\r\n  };\r\n\r\n  var folderCache = [];\r\n\r\n  /**\r\n   * Saves the file to google drive.\r\n   * See:\r\n   *  - https://developers.google.com/drive/v3/web/mime-types\r\n   *  - https://developers.google.com/drive/v3/reference/files/create\r\n   *\r\n   * @param {object} file\r\n   *   The file object which contains information to save.\r\n   *   NOTE: Some valid mimeTypes:\r\n   *         - 'application/vnd.google-apps.document'\r\n   *         - 'application/vnd.google-apps.file'\r\n   *         - 'application/pdf'\r\n   * @param {string} folderName\r\n   *   The folder this file will be saved to.\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function saveFile(file, folderName, callback) {\r\n    initFolder(folderName, function(folderId) {\r\n      if (folderId) {\r\n        // If we already have file.id, we just update.\r\n        if (file.id) {\r\n          updateFileContent(file.id, file.content, callback);\r\n        } else {\r\n          var metadata = {\r\n            name: file.name,\r\n            mimeType: file.mimeType,\r\n            appProperties: appProperties,\r\n            parents: [ folderId ],\r\n            fields: 'id'\r\n          };\r\n\r\n          var url = Drupal.settings.nbcore_google.endpoints.file_create;\r\n          NBGoogleRequest.httpRequest({\r\n            url: url,\r\n            data: JSON.stringify(metadata)\r\n          }).then(function(response) {\r\n            file.id = response.result.id;\r\n            updateFileContent(file.id, file.content, callback);\r\n          }, function(error) {\r\n            callback({error: \"NBGoogleDrive.saveFile request failure\"});\r\n            console.warn('Error in NBGoogleDrive.saveFile: ', error);\r\n          });\r\n        }\r\n      } else {\r\n        callback({error: \"NBGoogleDrive.saveFile folder missing: \" + folderName});\r\n        console.warn('Error in NBGoogleDrive.saveFile (FOLDER MISSING): ', folderName);\r\n      }\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Updates the file contents (secondary process of saveFile() function.\r\n   * See: https://developers.google.com/drive/v3/web/simple-upload\r\n   *\r\n   * @param {string} fileId\r\n   *   The Google file id reference to update.\r\n   * @param {object} contentBlob\r\n   *   The content in form of a response blob. eg. xhr.responseType = \"blob\".\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function updateFileContent(fileId, contentBlob, callback) {\r\n    var url = Drupal.settings.nbcore_google.endpoints.file_update;\r\n    NBGoogleRequest.httpRequest({\r\n      url: url,\r\n      params: { content_type: 'application/octet-stream', fileId: fileId },\r\n      data: contentBlob\r\n    }).then(function(response) {\r\n      callback(response.result);\r\n    }, function(error) {\r\n      console.warn(\"NBGoogleDrive.saveFile error!\", error);\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Initializes a google drive folder based on the folderName.\r\n   * NOTE: Automatically generates folder based on name if needed.\r\n   *\r\n   * @param {string} folderName\r\n   *   The folder's name to look for or create.\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function initFolder(folderName, callback) {\r\n    if (NBGoogleClient.isSignedIn()) {\r\n      // Try to get the folder if not create it.\r\n      getFolderByName(folderName, function(files) {\r\n        // First check to see if we have a folder that matches.\r\n        // If not, create the folder.\r\n        if (files.length > 0 && files[0].id) {\r\n          callback(files[0].id);\r\n        } else {\r\n          var metadata = {\r\n            name : folderName,\r\n            appProperties: appProperties,\r\n            mimeType : 'application/vnd.google-apps.folder',\r\n            folderColorRgb: '#4986e7'\r\n          };\r\n\r\n          var url = Drupal.settings.nbcore_google.endpoints.file_create;\r\n          NBGoogleRequest.httpRequest({\r\n            url: url,\r\n            data: JSON.stringify(metadata)\r\n          }).then(function(response) {\r\n            callback(response.result.id);\r\n          }, function(error) {\r\n            console.warn(\"NBGoogleDrive.initFolder error!\", error);\r\n          });\r\n        }\r\n      });\r\n    } else {\r\n      callback({});\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Gets the list of files based on the qryFilter argument..\r\n   * See: https://developers.google.com/drive/v3/web/search-parameters\r\n   * NOTE: All query params listed in reference above should be available,\r\n   *       With the exception of 'q' param which must be replaced with 'filter.\r\n   *       This is because Drupal reserves the 'q' param for their requests.\r\n   *\r\n   * @param {object} qryFilter\r\n   *   Object containing properties to various query filter options.\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function list(qryFilter, callback) {\r\n    if (NBGoogleClient.isSignedIn()) {\r\n      // Always search for files from our app.\r\n      var query = [getAppPropQuery()];\r\n      if (qryFilter.exactName) {\r\n        query.push('name = \"' + qryFilter.exactName + '\"');\r\n      }\r\n      if (qryFilter.containsName) {\r\n        query.push('name contains \"' + qryFilter.containsName + '\"');\r\n      }\r\n      if (qryFilter.parents) {\r\n        query.push('\"' + qryFilter.parents + '\" in parents');\r\n      }\r\n      if (qryFilter.mimeType) {\r\n        query.push('mimeType=\"' + qryFilter.mimeType + '\"');\r\n      }\r\n      if (qryFilter.excludeMimeType) {\r\n        query.push('mimeType!=\"' + qryFilter.excludeMimeType + '\"');\r\n      }\r\n      if (qryFilter.trashed != undefined) {\r\n        query.push('trashed=' + qryFilter.trashed + '');\r\n      }\r\n\r\n      // Join the query using the boolean AND keyword.\r\n      var queryStr = query.join(' and ');\r\n\r\n      var url = Drupal.settings.nbcore_google.endpoints.file_list;\r\n      NBGoogleRequest.httpRequest({\r\n        url: url,\r\n        params: {\r\n          filter: queryStr,\r\n          orderBy: 'createdTime desc',\r\n          fields: 'files(id, name, createdTime, modifiedTime, mimeType, appProperties, folderColorRgb, webContentLink, webViewLink), nextPageToken',\r\n          pageSize: 20\r\n        }\r\n      }).then(function(response) {\r\n        // Unfortunately for backwards compatibility response we can't simply send response.\r\n        var bkwrdResponse = (response.result.error)\r\n          ? response.result : response.result.files;\r\n        callback(bkwrdResponse);\r\n      }, function(error) {\r\n        console.warning(\"NBGoogleDrive.fileList error!\", error);\r\n      });\r\n    }\r\n    else {\r\n      return callback({});\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Gets the list of files based on folder name.\r\n   *\r\n   * @param {string} folderName\r\n   *   The file are in this folder.\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function listFiles(folderName, callback) {\r\n    getFolderByName(folderName, function(folder) {\r\n      if (folder.length > 0 && folder[0].id) {\r\n        list({\r\n          excludeMimeType: 'application/vnd.google-apps.folder',\r\n          parents: folder[0].id,\r\n          trashed: false\r\n        }, callback);\r\n      } else {\r\n        callback({});\r\n      }\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Get the folder reference by name.\r\n   *\r\n   * @param {string} folderName\r\n   *   The exact folder name to find.\r\n   * @param {function} callback\r\n   *   A function to callback response notifications.\r\n   */\r\n  function getFolderByName(folderName, callback) {\r\n    if (folderCache[folderName]) {\r\n      callback(folderCache[folderName]);\r\n    } else {\r\n      list({\r\n        exactName: folderName,\r\n        mimeType: 'application/vnd.google-apps.folder',\r\n        trashed: false\r\n      }, function(payload) {\r\n        // Stash the folder if all is well.\r\n        if (payload && payload.length > 0 && !payload.error) {\r\n          folderCache[folderName] = payload;\r\n        }\r\n        callback(payload);\r\n      });\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Creates and returns the app property query string object reference.\r\n   *  - appProperties has { key='additionalID' and value='8e8aceg2af2ge72e78' }\r\n   *\r\n   * @return {object}\r\n   *   This is the app prop query needed to isolate our instance.\r\n   */\r\n  function getAppPropQuery() {\r\n    var appPropertiesStr = '{';\r\n    for (var p in appProperties) {\r\n      if (appProperties.hasOwnProperty(p)) {\r\n        appPropertiesStr += \"key='\" + p + \"' and value='\" + appProperties[p] + \"'\";\r\n      }\r\n    }\r\n    appPropertiesStr += \"}\";\r\n    return 'appProperties has ' + appPropertiesStr;\r\n  }\r\n\r\n  // Public methods and properties for this module instance.\r\n  return {\r\n    saveFile: saveFile,\r\n    updateFileContent: updateFileContent,\r\n    listFiles: listFiles,\r\n    initFolder: initFolder,\r\n    getFolderByName: getFolderByName\r\n  };\r\n\r\n};\r\n"
          },
