          "cookies": [],
          "content": {
            "size": 3162,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Nbcore source landing page.\n */\n\n(function ($) {\n\n  /*\n   * Selects the correct date in the dropdown when using the browser's back-button.\n   */\n  Drupal.behaviors.issueBrowseYearSelect = {\n    attach: function (context, settings) {\n\n      // The original title when page loaded.\n      var pageTitle = document.title;\n\n      /**\n       * Updates the document.title based on the selected year.\n       *\n       * @param {string} selectedYear\n       */\n      function updateTitle(selectedYear) {\n        var findExp = new RegExp(/- Year:.*/)\n        if (findExp.test(document.title)) {\n          document.title = document.title.replace(findExp, '- Year: ' + selectedYear);\n        } else {\n          document.title = pageTitle + \" - Year: \" + selectedYear;\n        }\n      }\n\n      /**\n       * Updates the windows history based on the selected year.\n       *\n       * @param {object} selectedYear\n       *   The year selector (this) that is triggered or loaded.\n       */\n      function updateHistoryState(yearSelector) {\n        if (history.pushState && 'URLSearchParams' in window) {\n          var selectedYear = $(yearSelector).find(\":selected\").text();\n          var searchParams = new URLSearchParams(window.location.search);\n\n          if (searchParams.get(\"year\") !== selectedYear) {\n            searchParams.set(\"year\", selectedYear);\n            var newurl = window.location.protocol + '//' + window.location.host +\n              window.location.pathname + '?' + searchParams.toString();\n            // Updates page title, URL, and history without browser refresh.\n            updateTitle(selectedYear);\n            // Use push state to update history for each year selected (requires popstate event listener).\n            // window.history.pushState({year:selectedYear}, document.title, newurl);\n            // Replace state updates current page history to this selected year (no popstate needed).\n            window.history.replaceState({year:selectedYear}, document.title, newurl);\n          }\n        }\n      }\n\n      // Listens for year changes so that we can keep track of browser history.\n      $('#edit-year-select').on('change', function() {\n        updateHistoryState(this);\n      });\n\n      // When the pageshow event is finally triggered we can update the state.\n      window.addEventListener(\"pageshow\", () => {\n        $('#nbcore-browse-source-landing-form').once('year-select', function() {\n          updateHistoryState(this);\n        });\n      });\n\n      // This will only be used if we decide to use pushState vs. replaceState.\n      // Leaving for quick refrence.\n      $(window).on(\"popstate\", function(e) {\n        if (e.originalEvent.state !== null) {\n          var selectedYear = $('#edit-year-select').find(\":selected\").text();\n          var stateYear = e.originalEvent.state.year;\n          if (stateYear !== selectedYear) {\n            // Dynamically update calendar.\n            $('#edit-year-select').val(stateYear).change();\n            // Or we could reload page (not needed... and is not a fun user experience).\n            //window.location.reload();\n          }\n        }\n      });\n\n    }\n  };\n\n}(jQuery));\n"
          },
          "redirectURL": "",
