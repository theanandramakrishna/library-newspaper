            "size": 1193,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Accessibility Features.\n *\n */\n\n(function ($) {\n\n    Drupal.behaviors.accessibilityFeatures = {\n\n      attach: function (context, settings) {\n\n        // MAIN SKIP LINK\n\n        // Show skip link when focus is on main skip link.\n        $('.u-skip-main').focusin(function() {\n         $('#skip-link').css({\n            \"height\": \"auto\",\n            \"padding\": \"10px\"\n          });\n        });\n\n        // Hide skip link when focus leaves main skip link.\n        $('.u-skip-main').focusout(function() {\n          $('#skip-link').css({\n             \"height\": \"0\",\n             \"padding\": \"0\"\n           });\n         });\n\n\n        // SEARCH RESULT CHECKBOXES\n\n        // Add an aria-label to each checkbox.\n        $('.search-hits input.search-hits__select').each(function( index ) {\n            var aria_label = $(this).attr('data-title');\n            $(this).attr('aria-label', aria_label);\n        });\n\n        $('.search-hits__selectall--wrapper input.search-hits__select-all').attr('aria-label', 'Select All Articles');\n\n\n        $('.field-name-field-essay-image .field-items .field-item img').attr('alt', 'essay image');\n        // NEXT ITEM\n\n\n\n      }\n    };\n  }(jQuery));\n"
          },
