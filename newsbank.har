            "text": "process_downtime_message({\"style\": \"   #downtime-msg{\\r\\n      display: none;\\r\\n      position: relative;\\r\\n      text-align: left;\\r\\n      margin: 10px auto 20px auto;\\r\\n      padding: 10px;\\r\\n      background: #ffc;\\r\\n      border: 1px solid #DDA;\\r\\n      border-radius: 4px;\\r\\n      width: 500px;\\r\\n    }\\r\\n    #downtime-msg h2, #downtime-msg p{\\r\\n      font-family: sans-serif;\\r\\n      margin: 0.2em 0 0.4em;\\r\\n      color: #800;\\r\\n    }\\r\\n    #downtime-msg h2{\\r\\n      font-size: 14px;\\r\\n      font-weight: bold;\\r\\n      margin: 0.2em 0 0.4em;\\r\\n    }\\r\\n    #downtime-msg p{\\r\\n      font-size: 12px;\\r\\n      margin: 0.2em 0 0.4em;\\r\\n      white-space: pre-wrap;\\r\\n    }\\r\\n    #downtime-dismiss{\\r\\n      text-align: center;\\r\\n      font-size: 14px;\\r\\n      line-height: 0.7em;\\r\\n    }\\r\\n    #downtime-dismiss a:link, #downtime-dismiss a:visited{\\r\\n      position: absolute;\\r\\n      top: 0px;\\r\\n      right: 0px;\\r\\n      padding: 10px;\\r\\n      border-bottom: 0;\\r\\n      font-weight: bold;\\r\\n      text-decoration: none;\\r\\n      font-family: \\\"Verdana\\\";\\r\\n      color: #b00;\\r\\n    }\\r\\n    #downtime-dismiss a:hover{ \\r\\n      color: #f00;\\r\\n    }\", \"dependencies\": [[\"Image Retrieval\", 1], [\"Ecommerce\", 2], [\"General Outage\", 3], [\"ASCII News\", 99], [\"EAN\", 99], [\"ASCII Obituaries\", 99], [\"EAI\", 99], [\"Serial Set\\/ASP\", 99], [\"SSDI\", 99]], \"sites\": {\"nl\": {\"name\": \"NewsLibrary\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/nl.newsbank.com\\/\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"ASCII News\"], \"message\": \"We are experiencing issues with image content. Thank you for your patience.\"}, \"obar\": {\"name\": \"Obits Archive\", \"headline\": \"System Upgrade\", \"enabled\": false, \"href\": \"https:\\/\\/www.obitsarchive.com\\/\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"ASCII Obituaries\"], \"message\": \"We are currently in the process of upgrading our systems. We apologize for the inconvenience. Please check back shortly.\"}, \"allsearch\": {\"name\": \"Readex AllSearch\", \"headline\": \"Important notice\", \"enabled\": false, \"href\": \"https:\\/\\/infoweb.newsbank.com\\/apps\\/readex\\/?p=ARDX\", \"dependencies\": [\"General Outage\", \"Image Retrieval\", \"EAI\", \"EAN\", \"ASCII Obituaries\", \"ASCII News\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"Page images are currently not loading for several Readex products. Thank you for your patience as we work to resolve the problem. Note that Readex historical newspaper products and historical imprints products are not impacted and are fully functional.\"}, \"gb4\": {\"name\": \"GenealogyBank 4.0\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/www.genealogybank.com\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"EAI\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"We are experiencing issues with image content. Thank you for your patience.\"}, \"pf\": {\"name\": \"Platform\", \"headline\": \"Product Migration\", \"enabled\": false, \"href\": \"http:\\/\\/infoweb.newsbank.com\\/resources\\/?p=AMNEWS\", \"dependencies\": [\"General Outage\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"ASCII News\"], \"message\": \"Later this month, America’s Obituaries and Death Notices (AODN) will be replaced by HeritageHub, NewsBank’s flagship genealogy product. HeritageHub contains all the content in AODN . . . and a lot more. Users will be redirected to HeritageHub automatically. \"}, \"gb3\": {\"name\": \"GenealogyBank 3.0\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/wma-gb001.genealogybank.com\\/\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"EAI\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"We are experiencing issues with image content. Thank you for your patience.\"}, \"infoweb\": {\"name\": \"Infoweb\\\\/WebEngine (Homepage)\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/infoweb.newsbank.com\", \"dependencies\": [\"Image Retrieval\", \"General Outage\", \"Ecommerce\", \"ASCII News\", \"EAN\", \"ASCII Obituaries\", \"EAI\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"We are experiencing issues with image content. Thank you for your patience.\"}, \"gnus\": {\"name\": \"Gnu News\", \"headline\": \"New content update\", \"enabled\": false, \"href\": \"http:\\/\\/infoweb.newsbank.com\\/apps\\/news\\/?p=AWNB\", \"dependencies\": [\"General Outage\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"ASCII News\"], \"message\": \"NewsBank continues to make significant progress in updating our online content. Users will see the pace of recovery increase in the coming days as we work toward a full restoration of all content.\"}}, \"script\": \"\\/\\/ jQuery Cookie plugin\\r\\nif (!window.jQuery.cookie)\\r\\njQuery.cookie=function(b,j,m){if(typeof j!=\\\"undefined\\\"){m=m||{};if(j===null){j=\\\"\\\";m.expires=-1}var e=\\\"\\\";if(m.expires&&(typeof m.expires==\\\"number\\\"||m.expires.toUTCString)){var f;if(typeof m.expires==\\\"number\\\"){f=new Date();f.setTime(f.getTime()+(m.expires*24*60*60*1000))}else{f=m.expires}e=\\\"; expires=\\\"+f.toUTCString()}var l=m.path?\\\"; path=\\\"+(m.path):\\\"\\\";var g=m.domain?\\\"; domain=\\\"+(m.domain):\\\"\\\";var a=m.secure?\\\"; secure\\\":\\\"\\\";document.cookie=[b,\\\"=\\\",encodeURIComponent(j),e,l,g,a].join(\\\"\\\")}else{var d=null;if(document.cookie&&document.cookie!=\\\"\\\"){var k=document.cookie.split(\\\";\\\");for(var h=0;h<k.length;h++){var c=jQuery.trim(k[h]);if(c.substring(0,b.length+1)==(b+\\\"=\\\")){d=decodeURIComponent(c.substring(b.length+1));break}}}return d}};\\r\\n\\r\\nfunction downtime_dismiss(){\\r\