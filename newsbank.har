            "text": "/**\r\n * @file\r\n * JavaScript file for nbcore_pdf module.\r\n */\r\n\r\nvar $ = jQuery;\r\n\r\n/**\r\n * Class to represent the NewsBank File Download object.\r\n * NOTE: Use Drupal.settings.nbcore_pdf_global.events.PROGRESS to display progress information.\r\n *       - The payload = { step: step, timeElapsed: timeElapsed, progress: 0, error: error }.\r\n *\r\n * @param {string} targetId\r\n *   The id of the target element we will trigger events on.\r\n * @param {string} filename\r\n *   The filename for the file that will be returned to the user.\r\n * @param {boolean} debugOn\r\n *   Setting this to true will allow you to listen for debug events.\r\n *   - Listen for Drupal.settings.nbcore_pdf_global.events.DEBUG events.\r\n */\r\nvar NBFileDownload = function(targetId, filename, debugOn) {\r\n  'use strict';\r\n\r\n  // Used to keep track of status and timing.\r\n  var lastProgress = 0;\r\n  var maxProgress = 90;\r\n  var startTime = 0;\r\n  var storeBlob = false;\r\n  var storedBlob = {};\r\n  var errors = [];\r\n  var url = null;\r\n  var params = null;\r\n  var PROGRESS_EVENT = Drupal.settings.nbcore_pdf_global.events.PROGRESS;\r\n  var DEBUG_EVENT = Drupal.settings.nbcore_pdf_global.events.DEBUG;\r\n  // Global XMLHttpRequest object so it can be hooked into (eg. abort).\r\n  var xhr = new XMLHttpRequest();\r\n\r\n  /**\r\n   * Private method to update progress (for building progress bar interface).\r\n   *\r\n   * @param {string} step\r\n   *   A visual step indicator of where the progress is at.\r\n   * @param {int} progress\r\n   *   A number between 0-100 to indicate a percentage of the progress.\r\n   * @param {string} error\r\n   *   Any error that might have occured\r\n   *\r\n   * @return {int}\r\n   *   The lastProgress value after this runs.\r\n   */\r\n  function updateProgress(step, progress, error) {\r\n    var timeElapsed = (new Date().getTime() - startTime)  / 1000;\r\n\r\n    // Debug: output the progress.\r\n    if (debugOn) {\r\n      var payload = {\r\n        function: 'NBFileDownload.updateProgress',\r\n        info: step + ' is at ' + progress + '%' + ' completed, Time elapsed: ' + timeElapsed\r\n      };\r\n      $('#' + targetId).trigger(DEBUG_EVENT, payload);\r\n      console.debug(payload);\r\n    }\r\n\r\n    // Prevents triggering invalid progress to interfaces.\r\n    if ((error || progress == 0 || lastProgress <= progress) && progress <= 100) {\r\n      var payload = {\r\n        step: step,\r\n        timeElapsed: timeElapsed,\r\n        progress: (!error) ? progress : lastProgress,\r\n        error: (error) ? error : ''\r\n      };\r\n      lastProgress = payload.progress;\r\n      $('#' + targetId).trigger(PROGRESS_EVENT, payload);\r\n    }\r\n    else if (progress > 100)\r\n      console.info(\"Progress is overloaded: \", {step: step, progress: progress, error: error});\r\n    else\r\n      console.info(\"Progress is going backwards: \", {step: step, progress: progress, error: error});\r\n\r\n    return lastProgress;\r\n  }\r\n\r\n  /**\r\n   * Increments the progress by adding the incrementVal to the last progress ammount.\r\n   *\r\n   * @param {string} step\r\n   *   A visual step indicator of where the progress is at.\r\n   * @param {int} incrementVal\r\n   *   A number between 0-100 to add to the progress.\r\n   */\r\n  function incrementProgress(step, incrementVal) {\r\n    return updateProgress(step, (lastProgress + incrementVal), '');\r\n  }\r\n\r\n  /**\r\n   * Reports error and updates the progress event trigger.\r\n   *\r\n   * @param {string} step\r\n   *   A visual step indicator of where the progress is at.\r\n   * @param {string} error\r\n   *   The string representation of the error (usually a short blurb about what happened).\r\n   * @param {object} xhrObject\r\n   *   The optional XMLHttpRequest object for this error (only use when xhrObject error occurs).\r\n   */\r\n  function reportError(step, error, xhrObject) {\r\n    errors.push({\r\n      step: step,\r\n      error: error,\r\n      xhr: xhrObject\r\n    });\r\n    updateProgress(step, -1, error);\r\n    if (xhrObject) {\r\n      console.warn('FileDownload Error: step = ' + step, 'XMLHttpRequest Object', xhrObject);\r\n      if (xhrObject.responseType == \"blob\" && xhrObject.response) {\r\n        var reader = new FileReader();\r\n        reader.onload = function() {\r\n          console.warn('FileDownload Error information: xhr-response-text', reader.result);\r\n        }\r\n        reader.readAsText(xhrObject.response);\r\n      }\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get the FormData from a params object to make a XMLHttpRequest.\r\n   * This interface allows for large POST data to be sent to endpoint without corrupting data.\r\n   * It uses the same format a form would use if the encoding type were set to\r\n   * \"multipart/form-data\"\r\n   *\r\n   * @param {object} params\r\n   *   The params as a set of properties.\r\n   */\r\n  function getXHRData(params) {\r\n    var data = {};\r\n    if (typeof window.FormData != 'undefined') {\r\n      data = new FormData();\r\n      for (var key in params) {\r\n        data.append(key, params[key]);\r\n      }\r\n    }\r\n    else {\r\n      data = (params) ? $.param(params) : null;\r\n    }\r\n\r\n    return data;\r\n  }\r\n\r\n  /**\r\n   * Downloads a file while tracking progress on the client.\r\n   *\r\n   * @param {function} callback\r\n   *   An optional callback function to notify success (return: false/true).\r\n   * @param {boolean} retry\r\n   *   An option to allow for a retry if XMLHttpRequest fails.\r\n   *   NOTE: By default this will retry once unless you pass in false.\r\n   */\r\n  function downloadFile(callback, retry) {\r\n    var method = (params) ? 'POST' : 'GET';\r\n    var data = (method == 'POST') ? getXHRData(params) : null;\r\n\r\n    incrementProgress('downloadfilestarted', 5);\r\n\r\n    // Starting timer for continuos progress updates.\r\n    var dTimer = window.setInterval(function(){\r\n      var progress = incrementProgress('downloading', 1);\r\n      if (progress >= maxProgress) { clearInterval(dTimer); };\r\n    }, 500);\r\n\r\n    xhr.open(method, url, true);\r\n\r\n    // Required setRequestHeader with url encoded params when using send(...).\r\n    xhr.responseType = \"blob\";\r\n\r\n    xhr.onreadystatechange = function() {\r\n      // Headers are not available, so we can check the status, before the next state change.\r\n      if (xhr.readyState == XMLHttpRequest.HEADERS_RECEIVED) {\r\n        // If this is not a good status, set response to text so we can output error messages below.\r\n        if (xhr.status != 200) {\r\n          xhr.responseType = \"text\";\r\n        }\r\n      }\r\n      else if (xhr.readyState == XMLHttpRequest.DONE) {\r\n        window.clearInterval(dTimer);\r\n        if (xhr.status == 200) {\r\n          try {\r\n            if (storeBlob) {\r\n              storedBlob = xhr.response;\r\n              return callback(true);\r\n            }\r\n            else {\r\n              // IE has a method to download the blob data.\r\n              if (window.navigator && window.navigator.msSaveOrOpenBlob) {\r\n                return callback(window.navigator.msSaveOrOpenBlob(xhr.response, filename));\r\n              }\r\n              else {\r\n                var a = document.createElement(\"a\");\r\n                // Safari doesn't support the download attribute.\r\n                if (typeof a.download === 'undefined') {\r\n                  var reader = new FileReader();\r\n                  reader.onloadend = function(e) {\r\n                    // Sadly: this doesn't work either -> window.open(reader.result);\r\n                    window.location.href = reader.result;\r\n                    return callback(true);\r\n                  }\r\n                  reader.readAsDataURL(xhr.response);\r\n                }\r\n                // Try to use HTML5 a[download] attribute to trigger download.\r\n                else {\r\n                  // Create object url using browser specific kit.\r\n                  var URL = window.URL || window.webkitURL;\r\n                  var downloadUrl = URL.createObjectURL(xhr.response);\r\n                  var downloadName = (filename) ? filename : 'file-' + (new Date()).getTime();\r\n\r\n                  var a = $('<a/>', {\r\n                    href: downloadUrl,\r\n                    download: downloadName\r\n                  })\r\n                  .on(\"click\", function(event) {\r\n                    var $self = $(this);\r\n                    $(this).promise().done(function(data) {\r\n                      setTimeout(function() {\r\n                        $self.remove();\r\n                        URL.revokeObjectURL(downloadUrl);\r\n                        return callback(true);\r\n                      }, 50);\r\n                    });\r\n                  })\r\n                  .appendTo($('#' + targetId))\r\n                  .get(0).click();\r\n                }\r\n              }\r\n            }\r\n          }\r\n          catch (e) {\r\n            reportError('Exception', e.message, xhr);\r\n            return callback(false);\r\n          }\r\n        }\r\n        else {\r\n          // Report info to console.\r\n          console.warn('FILE DOWNLOAD FAILURE: ' + xhr.response);\r\n          // Attempt a retry on failure if needed.  If not report failure and callback to client.\r\n          if (typeof retry === 'undefined' || !retry) {\r\n            console.info('Attempting to retry download of ' + filename);\r\n            incrementProgress('downloadretry', 1);\r\n            downloadFile(callback, true);\r\n          }\r\n          else {\r\n            reportError('downloadfailed', \"Download failed: status = \" +\r\n              xhr.status + \": \" + xhr.statusText, xhr);\r\n            if (typeof callback == 'function') { return callback(false); }\r\n          }\r\n        }\r\n      }\r\n    };\r\n\r\n    // Download progress to fill remaining progress (a bit of a hack but works).\r\n    var diff = 100 - lastProgress;\r\n    xhr.onprogress = function(event) {\r\n      if (event.lengthComputable) {\r\n        var progress = Math.ceil(event.loaded / event.total * diff) + lastProgress;\r\n        // Leave a little progress remaining as needed.\r\n        if (progress >= maxProgress) {\r\n          progress = maxProgress\r\n        }\r\n        else {\r\n          updateProgress('xhr.onprogress', progress);\r\n        }\r\n      }\r\n    };\r\n    // On abort, report error and clear the progress timer.\r\n    xhr.onabort = function(event) {\r\n      reportError('download aborted', \"Download aborted\", xhr);\r\n      window.clearInterval(dTimer);\r\n      return callback(false);\r\n    };\r\n    // The default timeout is 0 (there is no timeout). Set timeout in milliseconds.\r\n    xhr.ontimeout = function () {\r\n      reportError('download_timeout', \"Download has timed out\", xhr);\r\n      window.clearInterval(dTimer);\r\n      return callback(false);\r\n    }\r\n    // Debug: output the request.\r\n    if (debugOn) {\r\n      var dbugParams = params;\r\n      if (dbugParams && dbugParams.body) {\r\n        dbugParams.body = ''; // Clear the body for debugging purposes.\r\n      }\r\n      var payload = {\r\n        function: 'NBFileDownload.downloadfile',\r\n        info: 'Download method: ' + method +\r\n          ((method == 'POST' && typeof data == 'object') ? ':{FormData}' : ''),\r\n        url: url + ((dbugParams) ? '?' + $.param(dbugParams) : '')\r\n      };\r\n      $('#' + targetId).trigger(DEBUG_EVENT, payload);\r\n      console.debug(payload);\r\n    }\r\n\r\n    xhr.send(data);\r\n  }\r\n\r\n  /**\r\n   * Initializes this object by setting progress to started.\r\n   * - NOTE: Mainly this reserves an initialization feature that may be required\r\n   *   at some point in the future.\r\n   */\r\n  function init() {\r\n    updateProgress('started', 0);\r\n  }\r\n\r\n  /**\r\n   * A mechanism to abort a download (if the download hasn't been finished.\r\n   * NOTE: This will trigger the xhr.onabort property function defined in downloadFile().\r\n   */\r\n  function abort() {\r\n    if(xhr && xhr.readyState !== XMLHttpRequest.DONE) {\r\n      // IMPORTANT: Required to clear onreadystatechange property.\r\n      xhr.onreadystatechange = function() { };\r\n      xhr.abort();\r\n    }\r\n  }\r\n\r\n  // Public methods and properties for this module instance.\r\n  return {\r\n    init: init,\r\n    abort: abort,\r\n    downloadFile: downloadFile,\r\n    updateProgress: updateProgress,\r\n    incrementProgress: incrementProgress,\r\n    reportError: reportError,\r\n    storeBlob: function(store) { storeBlob = store; },\r\n    getStoredBlob: function() { return storedBlob; },\r\n    getXHRData: getXHRData,\r\n    getFilename: function() { return filename; },\r\n    setFilename: function(newFilename) { filename = newFilename; },\r\n    getURL: function() { return url; },\r\n    setURL: function(newUrl) { url = newUrl; },\r\n    getParams: function() { return params; },\r\n    setParams: function(newParams) { params = newParams; },\r\n    hasErrors: function() { return (errors.length > 0) },\r\n    getErrors: function() { return errors }\r\n  };\r\n\r\n};\r\n\r\n\r\n"
          },
