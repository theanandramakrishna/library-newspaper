          "content": {
            "size": 6874,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Initialize nbcore_action_button.\n */\n\n(function ($) {\n  $.fn.extend({\n    /**\n     * Primary initialization wrapper for nbcore_action_button component.\n     */\n    initButtons: function () {\n      this.each(function () {\n        var buttonSettings = $(this).getButtonSettings();\n\n        var urlParams = null;\n        if (typeof URLSearchParams !== 'undefined') {\n          urlParams = new URLSearchParams(window.location.search);\n        }\n        // Enable debug mode when &__ACTION_BUTTON_DEBUG is present in the query string.\n        buttonSettings.debug = (urlParams !== null && urlParams.has('__ACTION_BUTTON_DEBUG'));\n\n\n        if (!Object.prototype.hasOwnProperty.call(buttonSettings, 'stageData')) {\n          buttonSettings.stageData = {};\n        }\n        if (!Object.prototype.hasOwnProperty.call(buttonSettings, 'sendData')) {\n          buttonSettings.sendData = {};\n        }\n        if (!Object.prototype.hasOwnProperty.call(buttonSettings, 'returnData')) {\n          buttonSettings.returnData = {};\n        }\n\n        if (!Object.prototype.hasOwnProperty.call(buttonSettings, 'functions')) {\n          buttonSettings.functions = {\n            init: [],\n            process: [],\n            submit: [],\n            complete: []\n          };\n        }\n\n        // Set up a Deferred object array in case the app needs to wait for feedback.\n        $(this).setupDeferred();\n\n        // Compile lifecycle functions from source, then target plugins.\n        $(this).compileFunctions('source');\n        $(this).compileFunctions('target');\n\n        // Run alterSettings trigger handler to let apps modify button setup.\n        $(this).alterButtonSettings();\n\n        // Run init lifecycle.\n        $(this).runFunctions(['init']);\n\n        // Set up click event handler for the primary button.\n        $(this).off('click').on('click', 'button.nbcore-action-button', function () {\n          var btnSettings = $(this).getButtonSettings();\n\n          // Run alterClick trigger handler to let apps modify button click.\n          $(this).alterButtonClick();\n\n          if (btnSettings.reset) {\n            btnSettings.runOnce = false;\n            delete btnSettings.reset;\n          }\n\n          $.when.apply($, btnSettings.defer).done(function ($button) {\n            var bSettings = $button.getButtonSettings();\n            $button.runFunctions(['process', 'submit', 'complete']);\n            bSettings.runOnce = true;\n\n            $('#' + bSettings.instance_id).resetButton();\n          });\n        });\n      });\n    },\n    /**\n     * Gets the buttonSettings object. Will work on both container and button.\n     * @return {Object}\n     */\n    getButtonSettings: function () {\n      var id = ($(this).is('div')) ? $(this).attr('id') : $(this).data('instance-id');\n      return Drupal.settings.nbcore_action_buttons[id];\n    },\n    /**\n     * Get functions from defined plugins and sort them in the lifecycle.\n     * @param {string} type\n     *   source or target\n     */\n    compileFunctions: function (type) {\n      var buttonSettings = $(this).getButtonSettings();\n      var plugin;\n\n      if (Object.prototype.hasOwnProperty.call(Drupal.behaviors.nbcoreActionButton, buttonSettings[type + '_type'])) {\n        plugin = Drupal.behaviors.nbcoreActionButton[buttonSettings[type + '_type']];\n        Object.keys(plugin).forEach(function (funcArray) {\n          if (Object.prototype.hasOwnProperty.call(plugin, funcArray)) {\n            if (plugin[funcArray].length > 0) {\n              Array.prototype.push.apply(\n                buttonSettings.functions[funcArray],\n                plugin[funcArray]\n              );\n            }\n          }\n        });\n      }\n    },\n    /**\n     * Create a defer array in the settings object and start it off with a\n     * Deferred object that is immediately resolved.\n     */\n    setupDeferred: function () {\n      var buttonSettings = $(this).getButtonSettings();\n      buttonSettings.defer = [$.Deferred()];\n      buttonSettings.defer[0].resolve($(this));\n    },\n    /**\n     * Run alterSettings trigger handler to let apps modify button setup.\n     * @return {Object}\n     */\n    alterButtonSettings: function () {\n      var oldData = $(this).getButtonSettings();\n      var newData = $(this).triggerHandler('nbcore_action_button.alterSettings', oldData);\n      return newData || oldData;\n    },\n    /**\n     * Run alterClick trigger handler to let apps modify button click.\n     * @return {Object}\n     */\n    alterButtonClick: function () {\n      var oldData = $(this).getButtonSettings();\n      var newData = $(this).triggerHandler('nbcore_action_button.alterClick', oldData);\n      return newData || oldData;\n    },\n    /**\n     * Run a set of lifecycle functions. Takes an array of lifecycle section keys,\n     * and will flatten into a single array so any failure (return false) stops\n     * the entire set.\n     * @param {Array} types\n     * @return {boolean}\n     */\n    runFunctions: function (types) {\n      var buttonSettings = $(this).getButtonSettings();\n      var $button = $('#' + buttonSettings.instance_id + ' .nbcore-action-button');\n      var runArrays = [];\n      var run;\n      var i;\n\n      if (buttonSettings.runOnce === true) {\n        return false;\n      }\n\n      for (i = 0; i < types.length; i += 1) {\n        runArrays.push(buttonSettings.functions[types[i]]);\n      }\n      run = [].concat.apply([], runArrays);\n\n      if (types.length > 1) {\n        $button.attr('disabled', 'disabled').addClass('nbcore-action-button--working');\n      }\n\n      $.each(run, function (idx) {\n        return run[idx](buttonSettings);\n      });\n\n      if (types.length > 1) {\n        setTimeout(function () {\n          $button.attr('disabled', null).removeClass('nbcore-action-button--working');\n        }, 500);\n      }\n\n      return true;\n    },\n    /**\n     * Run after each lifecycle to reinitialize button for multiple uses.\n     * @return {boolean}\n     */\n    resetButton: function () {\n      var buttonSettings = $(this).getButtonSettings();\n      if (buttonSettings.reset === false) {\n        return false;\n      }\n      buttonSettings.stageData = {};\n      buttonSettings.sendData = {};\n      buttonSettings.returnData = {};\n      buttonSettings.functions = {\n        init: [],\n        process: [],\n        submit: [],\n        complete: []\n      };\n      buttonSettings.reset = true;\n\n      $(this).initButtons();\n      return true;\n    },\n    /**\n     * Allow apps to force a single use button, turning off default behavior\n     * that resets the button after each click.\n     */\n    disableReset: function () {\n      var buttonSettings = $(this).getButtonSettings();\n      buttonSettings.reset = false;\n    }\n  });\n\n  Drupal.behaviors.nbcoreActionButton = {\n    attach: function (context, settings) {\n      $('.nbcore-action-button-container', context).initButtons();\n    }\n  };\n}(jQuery));\n"
