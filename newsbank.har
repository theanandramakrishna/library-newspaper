            "text": "(function($) {\n\n  /*\n   * Move Back to Advanced Search button to browsepub_meta section.\n   */\n  Drupal.behaviors.gnusBreadcrumbsBackToMap = {\n    attach: function (context, settings) {\n      if ($('.gnus-breadcrumbs-back-to-map-browse-multi', context).length) {\n        if ($('.gnus-breadcrumbs-back-to-map-browse-multi', context).html().trim()) {\n          $('.pane-gnus-breadcrumbs-back-to-map', context).prependTo('.browsepub_meta');\n        }\n      }\n    }\n  };\n\n  Drupal.behaviors.gnusTimelineDocBreadcrumb = {\n    attach: function (context, settings) {\n      var $results_crumb = $('.timeline__breadcrumbs .timeline-document-breadcrumb--results');\n      if ($results_crumb.length) {\n        var $resultsLink = $('.back-to-results a').clone();\n        var resultsText = Drupal.t('Search results');\n        $resultsLink.html(resultsText);\n        $results_crumb.append($resultsLink);\n      }\n      var $doc_crumb = $('.timeline__breadcrumbs .timeline-document-breadcrumb--document');\n      if ($doc_crumb.length) {\n        var pubText = $('.gnus_doc_pubname--pubname a').html();\n        $doc_crumb.html(pubText);\n      }\n    }\n  };\n\n})(jQuery);\n"
