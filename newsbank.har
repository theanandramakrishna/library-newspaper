          "content": {
            "size": 17079,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  /*\n   * Custom function to get exact selector of jQuery object\n   * from http://stackoverflow.com/a/15623322\n   */\n  var get_selector = function (element) {\n    var pieces = [];\n\n    for (; element && element.tagName !== undefined && element.tagName != 'BODY'; element = element.parentNode) {\n      if (element.className) {\n        var classes = element.className.split(' ');\n        for (var i in classes) {\n          if (classes.hasOwnProperty(i) && classes[i]) {\n            pieces.unshift(classes[i]);\n            pieces.unshift('.');\n          }\n        }\n      }\n      if (element.id && !/\\s/.test(element.id)) {\n        pieces.unshift(element.id);\n        pieces.unshift('#');\n      }\n      pieces.unshift(element.tagName);\n      pieces.unshift(' > ');\n    }\n\n    return pieces.slice(1).join('');\n  };\n\n  $.fn.getSelector = function (only_one) {\n    if (true === only_one) {\n      return get_selector(this[0]);\n    } else {\n      return $.map(this, function (el) {\n        return get_selector(el);\n      });\n    }\n  };\n\n  /*\n   * Create click handlers for modal.\n   * @param {object} modalContainer - jQuery object that contains an already existing (yet hidden) modal.\n   * @param {requestCallback} callback - Function to be executed after modal is generated.\n   */\n  $.fn.gnusModal = function(modalContainer, callback) {\n    return this.each(function() {\n\n      var $modalOriginElement = $(this),\n          $modalOriginElementClass = $modalOriginElement.getSelector()['0'],\n          $modalContainer = modalContainer,\n          hrefAttr = $(this).attr('href');\n\n      // Necessary to specify that this was generated from gnusModal, so that remove gnusModalClose function knows\n      // whether to hide the modal or remove it.\n      var data = {\n        origin: 'gnusModal'\n      };\n\n      // If origin element is a hyperlink, disable the link.\n      if (typeof hrefAttr !== undefined && hrefAttr !== false) {\n        $(this).removeAttr('href').removeAttr('target').css({'cursor' : 'pointer'});\n      }\n\n      $(document).on('click.gnusModalOpen', $modalOriginElementClass, data, function (e) {\n\n        if (typeof callback == 'function') {\n          callback();\n        }\n\n        // Open the overlay modal.\n        gnusModalGenerate($modalContainer, $modalOriginElement, e.data);\n      });\n    });\n  };\n\n  /**\n   * Adds a drupal_set_message type message to the target element.\n   *\n   * Usage Examples:\n   *\n   *   $('.message-container').gnusSetMessage('Hello world!', 'status');\n   *   $('.message-container').gnusSetMessage('Hello world!', 'status', ['my-message']);\n   *   $('.message-container').gnusSetMessage('Hello world!', 'status', function () {\n   *     console.log('Message created');\n   *   });\n   *   $('.message-container').gnusSetMessage('Hello world!', 'status', ['my-message'], function () {\n   *     console.log('Message created');\n   *   });\n   *\n   * @param {string} content\n   *   The content of the message container.\n   * @param {string} type\n   *   The message type, one of ['status', 'error', 'warning'].\n   * @param {array} classes\n   *   Optional array of additional classes to add to the message container.\n   * @param {function} callback\n   *   Optional callback function to fire upon completion.\n   */\n  $.fn.gnusSetMessage = function (content, type) {\n    var numArgs = arguments.length;\n    var arg2;\n    var arg3;\n    var classes;\n    var callBack;\n    var $this = $(this);\n    var msgClasses = ['messages'];\n    var msgId = 'message-' + Math.floor(Date.now());\n\n    if (numArgs === 3) {\n      arg2 = arguments[2];\n\n      if ($.isArray(arg2)) {\n        classes = arg2;\n        callback = null;\n      } else if ($.isFunction(arg2)) {\n        classes = [];\n        callback = arg2;\n      }\n    } else if (numArgs === 4) {\n      arg2 = arguments[2];\n      arg3 = arguments[3];\n      classes = $.isArray(arg2) ? arg2 : [];\n      callBack= $.isFunction(arg3) ? arg3 : null;\n    } else {\n      classes = [];\n      callBack = null;\n    }\n\n    msgClasses.push(type);\n    classes = $.isArray(classes) ? classes : [];\n    msgClasses = msgClasses.concat(classes);\n\n    $this\n      .prepend($('<dialog/>', {\n        id: msgId,\n        class: msgClasses.join(' '),\n        html: content\n      }));\n\n    $('#' + msgId)\n      .css({\n        position: 'relative',\n        'padding-right': '40px'\n      })\n      .append(\n        $('<button/>', {\n          class: 'messages__close-button',\n          html: '&times;',\n          title: Drupal.t('Close this message')\n        })\n      )\n      .find('.messages__close-button').click(function () {\n        $(this).parent('.messages').remove();\n      });\n\n    if ($.isFunction(callback)) {\n      callback();\n    }\n  };\n\n  /*\n   * Generate the modals.\n   * @param {object} modalContainer - jQuery object that contains an already existing (yet hidden) modal.\n   * @param {object} modalOriginElement - Optional jQuery object that contains the element that was clicked.\n   * @param {object} data - Contains any data to be passed through.\n   */\n  function gnusModalGenerate(modalContainer, modalOriginElement, data) {\n    var scrollTop = $(window).scrollTop();\n    var overlayActiveClass = 'js-overlay--active';\n    var modalActiveClass = 'js-modal--active';\n    var $body = $('body');\n    var $modalContainer = modalContainer;\n    var $modalOriginElement = modalOriginElement;\n\n    // If $modalContainer doesn't exist in DOM, add it in.\n    if (!$.contains(document, $modalContainer[0])) {\n\n      // Remove active modal before creating new one.\n      $('.' + modalActiveClass).remove();\n\n      $body.append($modalContainer);\n    }\n\n    $body.addClass(overlayActiveClass).css({'top' : '-' + scrollTop + 'px'});\n    $modalContainer.addClass(modalActiveClass);\n    $modalContainer.attr('aria-hidden', false);\n\n    // Focus on the first form element.\n    $('input:not([type=\"hidden\"]), textarea, .modal-footer button', $modalContainer).eq(0).focus();\n\n    $(document).on('click.gnusModalClose', '.modal-close, .site-overlay', function () {\n      gnusModalClose();\n    });\n\n    $(document).on('keyup.gnusModalClose', function (e) {\n      if (e.keyCode == 27) {\n        gnusModalClose();\n      }\n    });\n\n    // Close any modals and set focus back to modal origin.\n    function gnusModalClose() {\n      // Remove overlay\n      $body.removeClass(overlayActiveClass).css({'top' : ''});\n\n      // Clean up event bindings.\n      $(document).off('.gnusModalClose');\n\n      // If generated via gnusModal plugin, hide. Otherwise, remove from DOM.\n      if (data !== undefined && data.origin === 'gnusModal') {\n        $modalContainer.removeClass(modalActiveClass);\n        $modalContainer.attr('aria-hidden', true);\n\n        $body.scrollTop(scrollTop);\n\n        if ($modalOriginElement.length) {\n          // Set focus back to original element.\n          $modalOriginElement.focus();\n\n          // Close tooltip if one exists.\n          if ($modalOriginElement.data('ui-tooltip') !== undefined) {\n            $modalOriginElement.tooltip('close');\n          }\n        }\n      }\n      else {\n        $modalContainer.remove();\n      }\n    }\n\n    Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n    Drupal.gnusFunctions.gnusModalClose = gnusModalClose;\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.gnusModalGenerate = gnusModalGenerate;\n\n  /*\n   * Function used by jQuery UI Tooltip that automatically adds CSS classes when tooltip is near edge of viewport.\n   * (The CSS class changes will reposition the little arrows)\n   * @see http://api.jqueryui.com/position/\n   */\n  function addToolTipClass(obj, info) {\n    if (info.vertical != \"bottom\") {\n      $(this).addClass(\"flippedy\");\n    } else {\n      $(this).removeClass(\"flippedy\");\n    }\n    if (info.horizontal != \"center\") {\n      $(this).addClass(\"flippedx\");\n    } else {\n      $(this).removeClass(\"flippedx\");\n    }\n    $(this).css({\n      left: obj.left + 'px',\n      top: obj.top + 'px'\n    });\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.addToolTipClass = addToolTipClass;\n\n  /*\n   * Helper function to inline SVG into elements that are created by JavaScript.\n   *\n   * @param icon - string - Name of the SVG icon (eg 'icon-preview.svg')\n   * @param element - jQuery object - jQuery object to attach the SVG to.\n   * @param operation - string, either 'before', 'after, 'prepend', or 'append'. Defaults to 'append'\n   *\n   * Usage:\n   * Drupal.gnusFunctions.svgInline('icon-preview.svg', $('.search-hit-extended-preview-button__wrapper button'), 'prepend');\n   *\n   * Note:\n   * Be sure you use this function **after** the element exists in the DOM.\n   */\n\n  function svgInline(icon, $element, operation) {\n    var url = Drupal.settings.basePath + 'sites/all/themes/nb_gnus/images/svg/' + icon;\n    var operation = operation || 'append';\n\n    var svg = $.ajax({\n      url: url,\n      dataType: 'text'\n    }).done(function (svg) {\n      switch(operation) {\n        case 'before':\n        $element.before(svg);\n        break;\n        case 'after':\n          $element.after(svg);\n          break;\n        case 'prepend':\n          $element.prepend(svg);\n          break;\n        default:\n          $element.append(svg);\n      }\n    });\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.svgInline = svgInline;\n\n\n  // Toggling the header on HA Documents.\n  Drupal.behaviors.headerCollapse = {\n    attach: function(context, settings) {\n\n      // Don't run on ResearchRocket pages.\n      if ($('body').hasClass('nb-product__JRKP')) {\n        return;\n      }\n\n      // Don't do anything on a print page.\n      if ($('body').hasClass('page-nb-pdf-render')) {\n        return;\n      }\n      // If page is not a HA Doc, remove the localStorage variable and return.\n      // This is also the reason this code lives in gnus-starter-feature.js\n      // because it needs this check on all pages.\n      if ($('.page-document-view--ha').length == 0) {\n        try {\n          localStorage.removeItem('HADocHeaderCollapsed');\n        } catch(e) {}\n\n        return;\n      }\n\n      // Get collapsed state variable.\n      var collapsed = false;\n      var HADocHeaderCollapsed\n\n      try {\n        HADocHeaderCollapsed = localStorage.getItem('HADocHeaderCollapsed');\n      } catch (e) {\n        HADocHeaderCollapsed = false;\n      }\n\n      if (typeof HADocHeaderCollapsed !== 'undefined') {\n        collapsed = (HADocHeaderCollapsed == 'true');\n      }\n\n      // Starting state.\n      var $header = $('.layout__header-wrapper, #special-banner--wrapper');\n      var $toggleButtonWrapper = $('.layout__header-toggle-wrapper');\n      var $toggleButton = $toggleButtonWrapper.find('.layout__header-toggle-button');\n      var $image = $('.nbcore-openseadragon');\n      var $filmstripInner = $('.filmstrip__inner');\n      var $enhancedData = $('.document-view__obit-enhanced-data-ha .obit-enhanced-data__inner');\n      if (collapsed) {\n        $header\n          .css('height', '0px')\n          .addClass('layout__header-wrapper--collapsed');\n        $toggleButtonWrapper\n          .removeClass('layout__header-toggle-wrapper--expanded')\n          .addClass('layout__header-toggle-wrapper--collapsed');\n        $toggleButton.text($toggleButton.data('label-show'));\n        $image.css('height', 'calc(100vh - 145px)');\n        $filmstripInner.css('height', 'calc(100vh - 145px)');\n        $enhancedData.css('height', 'calc(100vh - 132px)');\n      }\n      else {\n        $header.addClass('layout__header-wrapper--expanded');\n        $toggleButtonWrapper\n          .removeClass('layout__header-toggle-wrapper--collapsed')\n          .addClass('layout__header-toggle-wrapper--expanded');\n        $toggleButton.text($toggleButton.data('label-hide'));\n      }\n      // Whether or not the header is collapsed, we can remove the class on the\n      // wrapper that hides everything.\n      $('.header-toggle__wrapper').removeClass('element-invisible');\n\n      // Button click event.\n      $(document).on('click', '.layout__header-toggle-button', function(e) {\n        e.preventDefault();\n        var $this = $(this);\n        // Collapsed to Expanded.\n        if ($header.hasClass('layout__header-wrapper--collapsed')) {\n          // Trigger JS expand: https://stackoverflow.com/a/24762848/477949\n          $header.animate({\n            height: $header.get(0).scrollHeight\n          }, 200, function() {\n            // Height: auto + add classes for opacity.\n            $header\n              .css('height', 'auto')\n              .removeClass('layout__header-wrapper--collapsed')\n              .addClass('layout__header-wrapper--expanded');\n            $toggleButtonWrapper\n              .removeClass('layout__header-toggle-wrapper--collapsed')\n              .addClass('layout__header-toggle-wrapper--expanded');\n            // Button text.\n            $this.text($this.data('label-hide'));\n            // Update image height.\n            $image.css('height', '');\n            $filmstripInner.css('height', '');\n            $enhancedData.css('height', '');\n            // Update localStorage.\n            localStorage.setItem('HADocHeaderCollapsed', false);\n          });\n        }\n        // Expanded to Collapsed.\n        else {\n          // Trigger JS collapse: https://stackoverflow.com/a/24762848/477949\n          setTimeout(function() {\n            $header.height($header.get(0).scrollHeight);\n            $header.animate({\n              height: '0px'\n            }, 200, function() {\n              $header\n                .removeClass('layout__header-wrapper--expanded')\n                .addClass('layout__header-wrapper--collapsed');\n              $toggleButtonWrapper\n                .removeClass('layout__header-toggle-wrapper--expanded')\n                .addClass('layout__header-toggle-wrapper--collapsed');\n              // Button text.\n              $this.text($this.data('label-show'));\n              // Update image height.\n              $image.css('height', 'calc(100vh - 145px)');\n              $filmstripInner.css('height', 'calc(100vh - 145px)');\n              $enhancedData.css('height', 'calc(100vh - 132px)');\n              // Update localStorage.\n              localStorage.setItem('HADocHeaderCollapsed', true);\n            });\n          }, 200);\n        }\n      });\n    }\n  };\n\n  Drupal.behaviors.openSeaDragonZoomLevels = {\n    attach: function (context, settings) {\n      // Don't do anything on a print page.\n      if ($('body').hasClass('page-nb-pdf-render')) {\n        return;\n      }\n\n      // Storage ID.\n      var storageID = 'openSeaDragonZoom_' + window.origin + Drupal.settings.basePath;\n\n      // If page is not a HA Doc, remove the localStorage variable and return.\n      // This is also the reason this code lives in gnus-starter-feature.js\n      // because it needs this check on all pages.\n      if ($('.page-document-view--ha').length == 0) {\n        try {\n          localStorage.removeItem(storageID);\n        } catch(e) {}\n\n        return;\n      }\n\n      // Get viewer.\n      var currentViewer = NBViewerStore.getViewer();\n\n      // Get stored zoom level.\n      var storedZoom;\n\n      try {\n        storedZoom = localStorage.getItem(storageID);\n      } catch (e) {\n        storedZoom = null;\n      }\n\n      // If we have a stored value, update the initial zoom level.\n      if (storedZoom !== null) {\n        handleZoomAndPan();\n      }\n\n      function handleZoomAndPan() {\n        if (typeof currentViewer.nbHighlights !== 'undefined') {\n          if (!currentViewer.nbHighlights.length) {\n            currentViewer.viewport.zoomTo(+storedZoom);\n            var point = currentViewer.viewport.getCenter();\n            currentViewer.viewport.panTo({x: point.x, y: 0}, true);\n          }\n        }\n        else {\n          // Poll at 200ms intervals until we have a set of highlights to work with.\n          setTimeout(handleZoomAndPan, 200);\n        }\n      }\n\n      // Collect zoom value from zoom callback.\n      currentViewer.addHandler('zoom', function (event) {\n        // When the openSeaDragon loads, it triggers 2 zoom events. Those have a\n        // property named \"immediately\" set to true. In subsequential manual\n        // zoom events is property is 'undefined'. We only want to update the\n        // stored value on manual events. And only when the value is different\n        // than the stored one.\n        if (event.zoom !== +storedZoom && typeof event.immediately == 'undefined') {\n          localStorage.setItem(storageID, event.zoom);\n          storedZoom = localStorage.getItem(storageID);\n        }\n      }, {});\n    },\n  };\n  Drupal.behaviors.loginHash = {\n    attach: function (context, settings) {\n      // Check for has value on login form.\n      var loginForm = $(\"form#user-login\");\n      if (loginForm.length > 0) {\n        // Login form exists. Let's see if it has a hash value now.\n        var hash = window.location.hash;\n        if (hash) {\n          // Hash exists. Let's add it to the form action.\n          loginForm.attr('action', loginForm.attr('action') + hash);\n        }\n      }\n    }\n  }\n\n})(jQuery);\n"
