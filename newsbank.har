            "text": "<!doctype html>\n\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Log In Databases | King County Library System</title>\n    <script type=\"text/javascript\">\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\n\n  ga('create', 'UA-3018520-29', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n    <script src=\"https://evgcatalog.kcls.org/js/ui/default/common/build/js/jquery.min.js\"></script>\n    <script src=\"https://evgcatalog.kcls.org/js/ui/default/opac/handlebars-v4.7.7.js\"></script>\n\n    <!-- NOTE: BootstrapCSS v4 does not play nicely with BC headers -->\n    <link rel=\"stylesheet\" href=\"/js/ui/default/staff/build/css/bootstrap.min.css\" />\n\n    <!-- local CSS -->\n    <style>\n      /* BC screen reader links are not correctly hidden via their API.\n         Add some additional CSS to hide them */\n      .screen_reader_nav {\n        position: absolute;\n        top: -1000px;\n        left: -1000px;\n        z-index: 0;\n      }\n\n      @media (min-width: 1200px) {\n        #ezproxy-container-wrapper {\n          width: 1360px;\n        }\n      }\n\n      #ezproxy-container {\n        margin-bottom: 20px;\n        color: #585d5e;\n        font-family: 'Open Sans', sans-serif;\n        letter-spacing: .5pt;\n        font-size: 15px;\n        /*width: 900px; \n        margin-left: auto;\n        margin-right: auto;\n        */\n      }\n      .margin-top {\n        margin-top: 20px;\n      }\n\n      input[type=\"text\"], input[type=\"password\"] {\n        width: 200px;\n      }\n\n      .blue-stuff {\n        color: #003f6b;\n      }\n\n    </style>\n\n    <!-- BC CSS -->\n    <link href=\"//cor-cdn-static.bibliocommons.com/assets/responsive_external_header-28ceacad02a76938bab0b59430ba90d4.css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\" />\n<link href=\"//cor-liv-cdn-static.bibliocommons.com/dynamic_stylesheet/WA-KCLS/external_library_branding.css?1793538135593\" media=\"all\" rel=\"stylesheet\" type=\"text/css\" />\n<link href=\"//cor-liv-cdn-static.bibliocommons.com/dynamic_stylesheet/WA-KCLS/stylesheet.css?1793538135593\" media=\"all\" rel=\"stylesheet\" type=\"text/css\" />\n\n    <!-- BC END CSS -->\n\n  </head>\n  <body>\n\n    <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-W6HMZ4L\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n\n    <!-- BC SCREEN READER NAVIGATION -->\n    <span class=\"bc_core_external\">\n  <a class=\"hidden-xs hidden-sm screen_reader_nav\" href=\"#header_main_nav\" data-js=\"skip_to_main_nav\">\n    Skip to main navigation\n  </a>\n  <a class=\"hidden-lg hidden-md screen_reader_nav\" href=\"#header_main_nav\" data-js=\"header_nav_xs_trigger\" data-target = \"header-main-nav\">\n    Skip to main navigation\n  </a>\n    <a class=\"hidden-xs hidden-sm screen_reader_nav\" href=\"#desktop_search_form\" data-js=\"skip_to_search_field\">\n      Skip to search\n    </a>\n  <a class=\"hidden-lg hidden-md screen_reader_nav\" href=\"#mobile_search_form\" data-js=\"header_search_xs_trigger\">\n    Skip to search\n  </a>\n</span>\n    <!-- BC END SCREEN READER NAVIGATION -->\n\n    <!-- BC HEADER -->\n    <header>\n\n  <script type=\"text/javascript\">\n  window.BC_API_GATEWAY_URL = window.BC_API_GATEWAY_URL || \"//gateway.bibliocommons.com/v2/\";\n\n  window.BCHeaderConfig = {\"google_translate_widget\":{\"is_enabled\":false,\"language_codes\":[\"zh-CN\",\"zh-TW\",\"fr-CA\",\"de\",\"it\",\"ja\",\"ko\",\"ru\",\"es\",\"ta\",\"uk\",\"vi\",\"tl\",\"a