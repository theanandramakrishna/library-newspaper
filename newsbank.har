          "content": {
            "size": 1677,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * JavaScript for nbcore_cite.\n */\n\n/* global clipboard */\n\n(function ($) {\n  Drupal.behaviors.nbcore_cite = {\n    attach: function (context, settings) {\n      var $risForm = $('.ris-export__form', context);\n      var action;\n\n      // On the citation \"copy links\".\n      $('li.citation a', context).click(function () {\n        var text = $(this).data('clipboard-text');\n        // Using clipboard-js https://www.npmjs.com/package/clipboard-js.\n        clipboard.copy({\n          'text/plain': text,\n          'text/html': text\n        }).then(\n          function () {\n            // Notifiy the copy event happened for apps to use their own js.\n            // Pass in citation text to be used.\n            $(document).trigger('Drupal.nbcore_cite_copied', [text]);\n          },\n          function (err) {\n            // If error, notify of the error, and pass citation text.\n            $(document).trigger('Drupal.nbcore_cite_not_copied', [text]);\n            console.error(err);\n          }\n        );\n      });\n\n      // EasyBib & RefWorks integration, silent \"hidden form\" submit here.\n      $('li.cite-export__download a', context).click(function () {\n        var $clicked = $(this).parent();\n        $('form', $clicked).submit();\n      });\n\n      // Automatically submit EasyBib intermediary page.\n      if ($risForm.length) {\n        action = $risForm.attr('data-action');\n        $risForm.attr('action', action).submit();\n      }\n\n      // Close button for EasyBib intermediary page. (If something goes wrong).\n      $('.ris-export__close', context).click(function (e) {\n        e.preventDefault();\n        window.close();\n      });\n    }\n  };\n}(jQuery));\n"
          },
