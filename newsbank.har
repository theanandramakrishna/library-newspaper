          "content": {
            "size": 5124,
            "mimeType": "application/javascript",
            "text": "(function($) {\n  'use strict';\n\n  /*\n   * Show/hide header PRM menu\n   */\n  Drupal.behaviors.prm_menu = {\n    attach: function (context, settings) {\n      var $prmMenu = $('.layout__header-second .prm-menu', context);\n      var activeClass = 'js-prm-menu--active';\n\n      function toggleMenu(e) {\n        if ($(this).hasClass(activeClass)) {\n          $(this).removeClass(activeClass);\n        }\n        else {\n          $(this).addClass(activeClass);\n        }\n      }\n\n      function hideMenu(e) {\n        $(this).removeClass(activeClass);\n      }\n\n      $prmMenu.hover(toggleMenu, hideMenu);\n      $prmMenu.click(toggleMenu);\n    }\n  };\n\n  /*\n   * Generate Name within the PRM menu title and show/hide menu items based on PRM authentication.\n   */\n  Drupal.behaviors.prm_menu_display = {\n    attach: function (context, settings) {\n\n      var $nameContainer = $('.prm-menu__title__name', context);\n\n      // Event listener triggers when PRM info is updated.\n      $(document, context).on('gnus_prm.info_update', updatePrmMenu);\n\n      function updatePrmMenu() {\n        if (Drupal.settings.gnus_prm.isAnonymous) {\n          $nameContainer.text('Session');\n        }\n        else if (Drupal.settings.gnus_prm.firstname != null) {\n          $nameContainer.text(Drupal.settings.gnus_prm.firstname + '\\'s');\n        }\n        else {\n          $nameContainer.text('Your');\n        }\n      }\n\n      // If Drupal.gnusFunctions.gnus_prm_prmGenerateInfo() hasn't been run yet, then run it. Otherwise just run\n      // the UpdatePrmMenu function to update the menu (and skip an API request)\n      if (typeof Drupal.settings.gnus_prm == 'undefined' || typeof Drupal.settings.gnus_prm.isAnonymous == 'undefined') {\n        Drupal.gnusFunctions.gnus_prm_prmGenerateInfo();\n      }\n      else {\n        updatePrmMenu();\n      }\n    }\n  };\n\n  /*\n   * Gnus PRM menu item functionality\n   */\n  Drupal.behaviors.prm_items = {\n    attach: function (context, settings) {\n      // Login to PRM\n      $('.prm-menu__item--login button', context).click(function() {\n        Drupal.gnusFunctions.gnus_prm_gnusPrmLogin(loginSuccess);\n      });\n\n      // Logout of PRM\n      $('.prm-menu__item--logout button', context).click(function() {\n        Drupal.gnusFunctions.gnus_prm_gnusPrmLogout(logoutSuccess);\n      });\n\n      // Create Account on PRM\n      $('.prm-menu__item--create button', context).click(function() {\n        Drupal.gnusFunctions.gnusPrmRegister(registerSuccess);\n      });\n\n      // Edit Account\n      $('.prm-menu__item--edit-account button', context).click(function() {\n        Drupal.gnusFunctions.gnusPrmAccountEdit(editAccountSuccess);\n      });\n\n      function loginSuccess() {\n        $('.layout__content-above .prm-message').remove();\n        $('.layout__content-above').gnusSetMessage('Login successful.', 'status', ['prm-message prm-login-message']);\n      }\n\n      function logoutSuccess() {\n        $('.layout__content-above .prm-message').remove();\n        $('.layout__content-above').gnusSetMessage('Logout successful.', 'status', ['prm-message prm-logout-message']);\n      }\n\n      function registerSuccess() {\n        $('.layout__content-above .prm-message').remove();\n        $('.layout__content-above').gnusSetMessage('Your account has been created, and you are now signed in.', 'status', ['prm-message prm-registration-message']);\n      }\n\n      function editAccountSuccess() {\n        $('.layout__content-above .prm-message').remove();\n        $('.layout__content-above').gnusSetMessage('Your account has been updated.', 'status', ['prm-message prm-update-message']);\n      }\n    }\n  }\n\n  /*\n   * Gnus titles for PRM folder sections.\n   */\n  Drupal.behaviors.prmTitles = {\n    attach: function (context, settings) {\n      var $folderContainer = $('.nbcore-prm-articles-folders', context);\n      var $selectedItem;\n      var $prmTitleTag;\n      var title = '';\n\n      if ($folderContainer.length) {\n        // Get the title from the selected item in the folder pane.\n        $selectedItem = $folderContainer.find('li.selected');\n        if ($selectedItem.hasClass('nb-prm-articles-folders__folder--user-folder')) {\n          // If this is user defined prepend section title.\n          title = 'My Saved Articles: ';\n        }\n        title += $folderContainer.find('li.selected').find('a').text();\n\n        // If nothing was selected use the no results version.\n        if (title === '') {\n          title = $folderContainer.find('li.nb-prm-articles-folders__folder--no-results').text();\n        }\n\n        // Attach title to DOM.\n        $prmTitleTag = $('<h2/>', { text: title, class: 'nb-prm-section-title' });\n        $('section.layout__content-above--prm', context).prepend($prmTitleTag);\n\n        // Set up event handler to update when folder links are clicked.\n        $(document).on('nbcore_prm_articles.folderList.click', function (e, args) {\n          var newTitle = args.name + ' (' + args.count + ')';\n          if (args.type === 'user-folder') {\n            newTitle = 'My Saved Articles: ' + newTitle;\n          }\n          $prmTitleTag.text(newTitle);\n        });\n      }\n    }\n  };\n\n})(jQuery);\n"
