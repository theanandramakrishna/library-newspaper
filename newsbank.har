          "content": {
            "size": 24787,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  /*\n   * Move the \"Navigator Helpers\" to appear below the search form\n   */\n  Drupal.behaviors.contentNavigatorAdvancedHelper = {\n    attach: function (context, settings) {\n      var $feedbackContainer = $('.page-content .nbcore-navigator-items-feedback', context);\n      if ($feedbackContainer.length) {\n        var $elementDestination = $('.page-header', context);\n        $elementDestination.append($feedbackContainer);\n      }\n    }\n  };\n\n  /*\n   * Remove any success messages when action bar button is clicked\n   */\n  Drupal.behaviors.actionBarShowDefaultMessage = {\n    attach: function (context, settings) {\n      $('.actions-bar__button', context).click(function() {\n        $('.actions-bar__drawer', context).removeClass('js-action-success');\n      });\n    }\n  };\n\n  /*\n   * Handle the google classroom action bar button when it is clicked\n   */\n  Drupal.behaviors.actionBarGoogleClassroom = {\n    attach: function (context, settings) {\n      $('.actions-bar__button--googleclassroom', context).on(\"click\", function() {\n        var url_encoded = $(this).data('url_encoded');\n        var share_url = 'https://classroom.google.com/share?url=' + url_encoded;\n        window.open(share_url, 'google_share_popup', 'width=600, height=600');\n\n        // Log zustat for this action.\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_share_google_classroom',\n            'pbi': settings.nbbase.pbi,\n            'docid': settings.nbbase.docref\n          });\n        }\n        catch (ex) {}\n      });\n    }\n  };\n\n  /*\n   * Toggle text size button\n   */\n  Drupal.behaviors.actionDrawerFontToggle = {\n    attach: function (context, settings) {\n      var textSize = $.cookie('gnus_actions_bar.textSize');\n\n      if (textSize == 'large') {\n        $('.actions-bar__button--textsize, .document-view__content', context).addClass('js--text-large');\n      }\n\n      $('.actions-bar__button--textsize', context).click(function() {\n        if (textSize != 'large') {\n          $.cookie('gnus_actions_bar.textSize', 'large', { path: '/' });\n          $('.actions-bar__button--textsize, .document-view__content', context).addClass('js--text-large');\n        }\n        else {\n          $.cookie('gnus_actions_bar.textSize', 'normal', { path: '/' });\n          $('.actions-bar__button--textsize, .document-view__content', context).removeClass('js--text-large');\n        }\n        textSize = $.cookie('gnus_actions_bar.textSize');\n      })\n    }\n  };\n\n  // Step through functionality for the search drawer.\n  Drupal.behaviors.actionBarSteps = {\n    attach: function (context, settings) {\n      // Multistep buttons: opens a new step.\n      var $searchWrapper = $('.actions-bar__item--search');\n      var $searchDrawer = $searchWrapper.find('.actions-bar__drawer');\n      var product = Drupal.settings.nbbase.product;\n\n      // Move the Cancel buttons around.\n      var $issueSearchInner = $searchWrapper.find('.issue-search__inner');\n      $('#actions-bar__step-2-search-issue').find('.actions-bar__cancel-wrapper').appendTo($issueSearchInner);\n      var $highlightSearch = $searchWrapper.find('.nbcore-openseadragon__highlight-search');\n      $('#actions-bar__step-2-search-page').find('.actions-bar__cancel-wrapper').appendTo($highlightSearch);\n\n      if (product == 'HHUB') {\n\n        // Go right to page search when search issue is not wanted.\n        $('.actions-bar__step-1--search').remove();\n        $('#actions-bar__step-2-search-page').removeClass('js-hide').attr('aria-hidden', false);\n        $('#actions-bar__step-2-search-page').find('.actions-bar__cancel-wrapper').remove();\n      }\n      else {\n\n        // First step button actions.\n        $('.actions-bar__item--search', context).on('click', '[data-steps-open-id]', function(event) {\n          var id = '#' + $(this).attr('data-steps-open-id');\n          // Hide all.\n          $searchWrapper.find('.actions-bar__step--search').addClass('js-hide').attr('aria-hidden', true);\n          // Unhide target ID.\n          $(id).removeClass('js-hide').attr('aria-hidden', false);\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($searchDrawer);\n        });\n\n        // Cancel button goes back to step 1 buttons.\n        $('.actions-bar__item--search', context).on('click', 'button.actions-bar__steps--cancel', function(e) {\n          e.preventDefault();\n          openStepOne();\n        });\n\n        // Reset to step 1.\n        var openStepOne = function() {\n          // Hide all.\n          $searchWrapper.find('.actions-bar__step--search').addClass('js-hide').attr('aria-hidden', true);\n          // Unhide first step.\n          $searchWrapper.find('.actions-bar__step-1--search').removeClass('js-hide').attr('aria-hidden', false);\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($searchDrawer);\n        };\n      }\n    }\n  };\n\n  Drupal.behaviors.docPDFLinkButton = {\n    attach: function (context, settings) {\n      $('.pdf .actions-bar__action').click(function() {\n      window.location = $(this).find('a').attr('href');\n      return false;\n      });\n    }\n  };\n\n  /*\n   * Show Citation\n   */\n  Drupal.behaviors.showCitation = {\n    attach: function (context, settings) {\n\n      var $citeDrawer = $('.actions-bar__drawer--cite', context);\n\n      $('li.citation a').click(function () {\n        var citationText = $(this).data('clipboard-text');\n        $citeDrawer.addClass('js-citation-view-open');\n        $('.citation-text-display', $citeDrawer).html(citationText);\n        $('.citation-return', context).focus();\n\n        // Reanimate the drawer and document body to take into account new drawer height.\n        Drupal.behaviors.gnus_actions_bar_drawer_slide($citeDrawer);\n      });\n\n      function returnCitations() {\n        $citeDrawer.removeClass('js-citation-view-open');\n      }\n\n      $('.citation-return', context).click(function() {\n        returnCitations();\n        Drupal.behaviors.gnus_actions_bar_drawer_slide($citeDrawer);\n      });\n\n      $('.actions-bar__button', context).click(function() {\n        returnCitations();\n      });\n    }\n  };\n\n  /*\n   * Copy open URL to clipboard\n   */\n  Drupal.behaviors.clipboardCopy = {\n    attach: function (context, settings) {\n      // On the citation \"copy links\"\n      $('.actions-bar__copytext', context).click(function () {\n        var $drawer = $(this).parents('.actions-bar__drawer');\n        var text = $('.actions-bar__urltext', context).text();\n\n        // Using clipboard-js https://www.npmjs.com/package/clipboard-js.\n        clipboard.copy({\n          \"text/plain\": text\n        }).then(\n          function() {\n            $('.gnus-actions-bar-copylink', context).addClass('js-action-success');\n\n            // Reanimate the drawer and document body to take into account new drawer height.\n            Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n          }\n        );\n      });\n    }\n  };\n\n  /*\n   * Enable/disable the actions bar buttons on the search result page when results are selected/deselected.\n   */\n  Drupal.behaviors.enableResultsActionsBar = {\n    attach: function (context, settings) {\n      var $actionsbar_buttons = $('.pane-action-bar-search-results .actions-bar__button', context);\n\n      // Set initial state of the actions bar buttons\n      if ($('.search-hits__selections--feedback', context).hasClass('no-selections')) {\n        $actionsbar_buttons.attr('disabled', 'disabled');\n      }\n\n      // Subscribe to custom event. On trigger, enable or disable the buttons\n      $(document).on('nbcore_search_hits_cache_selections.updateSelectAll', function(e, args) {\n        if (args.totalSelected > 0) {\n          $actionsbar_buttons.removeAttr('disabled');\n        }\n        else {\n          $actionsbar_buttons.attr('disabled', 'disabled');\n        }\n      });\n    }\n  };\n\n   /*\n   * Add page-results__zero-results class to body if exists\n   */\n  Drupal.behaviors.zerohitsClass = {\n    attach: function (context, settings) {\n      var $zerohitstate = $('div.search-hits__zero-hits', context);\n\n      if ($zerohitstate.length) {\n        $('body', context).addClass('page-results__zero-results');\n      }\n    }\n  };\n\n  /**\n   * Adds a special class to each search hit that has been saved in the PRM articles collection.\n   *\n   * @param {Object} buttonSettings\n   */\n  function indicatePrmArticles(buttonSettings) {\n    var prmSavedArticles = nbcore_prm_articles.getIndexedArticles();\n    if (buttonSettings.debug) {\n      console.log({\n        plugin: 'SelectedSearchHitsActionButtonPlugin',\n        fn: 'indicatePrmArticles',\n        prmSavedArticles: prmSavedArticles,\n        buttonSettings: buttonSettings\n      });\n    }\n\n    if (prmSavedArticles !== null) {\n      $('#' + buttonSettings.search_hit_pane_instance_id + ' .search-hits__select')\n        .each(function () {\n          var $this = $(this);\n          var docref = $this.attr('data-docref');\n          var isPrmClass = 'prm__saved-article';\n\n          if (Object.prototype.hasOwnProperty.call(prmSavedArticles, docref)) {\n            $this.closest('.search-hits__hit').addClass(isPrmClass);\n          } else {\n            $this.closest('.search-hits__hit').removeClass(isPrmClass);\n          }\n        });\n    }\n  }\n\n  //  Action button code to save selected search hits to PRM saved articles.\n  Drupal.behaviors.saveSelectedSearchHitsToPrm = {\n    attach: function (context, settings) {\n\n      if ($('.nbcore-action-button').length) {\n        // Ensure that the deferred is only wired up once.\n        var $articlesSave = $('#nbcore-action-button-pane-save-articles .nbcore-action-button', context);\n        var $container = $articlesSave.closest('.nbcore-action-button-container');\n        var readyToSave = $.Deferred();\n        var $messageContainer = $('.layout__content-above--results');\n\n        // Wire up complete callback for saving articles.\n        // IMPORTANT: alterSettings must be called on the button's parent container!!!\n        $container\n          .on('nbcore_action_button.alterSettings', function (e, buttonSettings) {\n            // TODO: Enable the line below if you want to add a special class to saved articles.\n            // buttonSettings.functions.init.push(indicatePrmArticles);\n\n            // Handle the action button complete lifecycle phase.\n            buttonSettings.functions.complete.push(\n              function handleSaveArticlesToPrmComplete(buttonSettings) {\n                var className = 'prm-articles-save-message';\n                var msgType;\n                var msgContent;\n                var $messageContainer = $('.layout__content-above--results');\n                var stageData = buttonSettings.stageData['SelectedSearchHitsActionButtonPlugin'];\n                var articlesToSaveCount = stageData.articlesToSaveCount;\n                var selectedArticlesCount = stageData.selectedArticlesCount;\n\n                if (buttonSettings.returnData.success) {\n                  var p = nbbase.getUrlParam(window.location.href, 'p');\n                  var myFolderUri = Drupal.settings.nbbase.drupalBasePath\n                    + 'my-folder?p=' + p + '&prm-articles=#NO_FOLDERS_ASSIGNED';\n\n                  var myFolderLink = '<strong><a href=\"' + myFolderUri + '\" class=\"prm-my-folder-link\">'\n                    + 'My Saved Articles</a></strong>.';\n\n                  msgType = 'status';\n                  msgContent = (articlesToSaveCount === 1)\n                    ? articlesToSaveCount + Drupal.t(' article has been added to your Folder under ') + myFolderLink\n                    : articlesToSaveCount + Drupal.t(' of ') + selectedArticlesCount +\n                      Drupal.t(' selected articles have been added to your Folder under ') + myFolderLink;\n                } else {\n                  if (Object.prototype.hasOwnProperty.call(buttonSettings.returnData, 'info')) {\n                    msgType = 'warning',\n                    msgContent = buttonSettings.returnData.info;\n                  } else {\n                    msgType = 'error';\n                    msgContent = Drupal.t('An error occurred, and no articles were added to your Folder. Please try again or contact Customer Service.');\n                  }\n                }\n\n                $messageContainer.gnusSetMessage(msgContent, msgType, [className]);\n\n                // TODO: Enable the code below if you want to add a special class to saved articles.\n                // Update PRM article indicators.\n                // setTimeout(function () {\n                //   indicatePrmArticles(buttonSettings)\n                // }, 10);\n\n                if (buttonSettings.debug) {\n                  console.log({\n                    stage: 'complete',\n                    behavior: 'Drupal.behaviors.saveSelectedSearchHitsToPrm',\n                    fn: 'handleSaveArticlesToPrmComplete',\n                    returnData: buttonSettings.returnData\n                  });\n                }\n              });\n          });\n\n        $articlesSave\n          // Push a new deferred into the array to track when we're good to save articles.\n          .on('nbcore_action_button.alterClick', function (e, buttonSettings) {\n            buttonSettings.defer.push(readyToSave);\n          })\n          // Attach a click handler to trigger PRM login if necessary and resolve the deferred.\n          .on('click', function () {\n            // Trigger the PRM login popup form if the user is not logged into PRM.\n            // When the user is logged in, resolve the Deferred so that the action button can do\n            // its thing.\n            if (Drupal.settings.gnus_prm.isAnonymous) {\n              Drupal.gnusFunctions.gnus_prm_gnusPrmLogin(\n                function handlePrmLoginSuccess() {\n                  readyToSave.resolve();\n                }\n              );\n            } else {\n              readyToSave.resolve();\n            }\n          });\n      }\n    }\n  };\n\n  /*\n   * Moves HA continuations button and adds placeholder text if 'Search Page' functionality is unavailable.\n   */\n  Drupal.behaviors.moveHaContinuations = {\n    attach: function (context, settings) {\n      var $continueButton = $('.nbcore-openseadragon__continuations', context);\n      if ($continueButton.length) {\n        $continueButton.prependTo('.openseadragon_controls-on-viewer');\n      }\n\n      // If 'search page' functionality is unavailable (on full page HA documents), show description text.\n      // We check the display property value because that is what is set from\n      // the component, indicating that text highlighting is unavailable.\n      if ($('.nbcore-openseadragon__highlight', context).css('display') == 'none') {\n        $('.nbcore-openseadragon__highlight', context).after('<div class=\"actions-bar__no-highlight-wrapper\"><p>Please select one of the articles below to search.</p><button class=\"actions-bar__steps--cancel\">Cancel</button></div>');\n      }\n    }\n  };\n\n  /*\n   * Toggles openSeaDragon controls.\n   */\n  Drupal.behaviors.openSeaDragonControlsToggle = {\n    attach: function (context, settings) {\n      $(window).on('openSeaDragonControlsToggle', function(event, payload) {\n        if (payload.show) {\n          $('.openseadragon-container .navigator', context).show();\n          $('.openseadragon_controls', context).show();\n          $('.openseadragon__zoom-toolbar', context).removeClass('openseadragon__zoom-toolbar--top');\n        }\n        else {\n          $('.openseadragon-container .navigator', context).hide();\n          $('.openseadragon_controls', context).hide();\n          $('.openseadragon__zoom-toolbar', context).addClass('openseadragon__zoom-toolbar--top');\n        }\n      });\n    }\n  };\n\n  /*\n   * Zone Selector for editors.\n   */\n  Drupal.behaviors.zoneSelector = {\n    attach: function (context, settings) {\n      if (typeof NBViewerStore !== 'undefined') {\n        $clippingZoneInfo = $('.actions-bar__clipping-zone-info', context);\n        $('.actions-bar__drawer').on('click', $clippingZoneInfo, function(event) {\n          var nbViewerSelection = NBViewerStore.nbSelection();\n          let selectionObj = nbViewerSelection.getSelectedRect(true);\n          const zoneSelection = [selectionObj.x, selectionObj.y, selectionObj.width, selectionObj.height].join('|');\n          $('.actions-bar__clipping-zone-info-zone input').val(zoneSelection);\n        });\n      }\n    }\n  };\n\n  /*\n   * Copy HHUB data to clipboard.\n   */\n  Drupal.behaviors.hhubClipboardCopy = {\n    attach: function (context, settings) {\n      $('.actions-bar__hhub-copytext-button', context).click(function () {\n        // var $drawer = $(this).parents('.actions-bar__drawer');\n        var text = $('.actions-bar__hhub-copytext', context).text().trim();\n        // Using clipboard-js https://www.npmjs.com/package/clipboard-js.\n        clipboard.copy({\n          \"text/plain\": text\n        }).then(\n          function() {\n            var $success = $('.actions-bar__hhub-copytext-button-success');\n            var $copyTextButton = $('.actions-bar__hhub-copytext-button');\n            $success.removeClass('hidden');\n            $success.show();\n            $copyTextButton.addClass('hidden');\n            setTimeout(function() {\n              $success.fadeOut(1000, function() {\n              });\n            }, 3000);\n            setTimeout(function() {\n              $copyTextButton.removeClass('hidden');\n            }, 4100);\n          }\n        );\n      });\n    }\n  };\n\n  /*\n   * Copy data to clipboard using natively supported ClipboardEvent.\n   * @see https://developer.mozilla.org/en-US/docs/Web/API/ClipboardEvent/clipboardData\n   */\n  Drupal.behaviors.simpleClipboard = {\n    attach: function (context, settings) {\n\n      // Copy to clipboard.\n      $(\".simple_clip_area\").on(\"click\", \".simple_clip_area-button_event\", function(e) {\n        e.stopImmediatePropagation();\n\n        var textarea = document.createElement(\"textarea\");\n        var html = [];\n        var txt = [];\n        $(e.delegateTarget).find('.clipcopy', context).each(function(index) {\n          html.push($(this).prop('outerHTML'));\n          txt.push($(this).text().replace(/\\s\\s+/g, '\\n'));\n        });\n        var htmlStr = html.join('\\n');\n        var txtStr = txt.join('\\n');\n\n        var listener = function(ev) {\n          ev.preventDefault();\n          ev.clipboardData.setData('text/html', htmlStr);\n          ev.clipboardData.setData('text/plain', txtStr);\n        };\n        document.addEventListener('copy', listener);\n\n        try {\n          return document.execCommand(\"copy\");  // Security exception may be thrown by some browsers.\n        }\n        catch (ex) {\n          alert(\"Copying to clipboard failed.\")\n          console.warn(\"Copy to clipboard failed.\", ex);\n          return false;\n        }\n        finally {\n          document.removeEventListener('copy', listener);\n          $(e.delegateTarget).fadeTo(100, 0.3, function() { $(this).fadeTo(500, 1.0); });\n        }\n\n      });\n\n    }\n  };\n\n  /*\n   * Processes the CSS class to animate the action bar drawer and move the document up/down.\n   * @param {Object} $drawer - jQuery object representing the action bar drawer to be animated.\n   */\n  Drupal.behaviors.gnus_actions_bar_drawer_slide = function($drawer) {\n\n    // Calculate height of drawer.\n    var $document = $('.document-view, .pane-nbcore-toc-filmstrip-pane_with_thumbnails, .document-view__obit-enhanced-data-ha');\n    var drawerHeight = $drawer.outerHeight();\n\n    //console.log($drawer);\n\n    // Set height to zero.\n    $drawer.css({'height' : '0px'});\n\n    // Remove inline height triggers animation.\n    $drawer.css({'height' : ''});\n\n    // Animate down the document body.\n    $document.css({'margin-top' : drawerHeight + 'px'});\n  };\n\n  /*\n   * PRM Articles - Create.\n   */\n  Drupal.behaviors.prmArticleCreate = {\n    attach: function (context, settings) {\n      var $articleCreate = $('#nbcore-action-button-prm-article-create', context);\n      var $articleCreateDrawer = $articleCreate.find('.actions-bar__drawer');\n      var mySavedArticlesURI = settings.nbbase.drupalBasePath + 'my-folder?p=' + settings.nbbase.product + '&prm-articles=';\n      var docRef = settings.nbbase.docref;\n      var hasDocref;\n      var readyToContinue;\n      var savedArticles;\n      var $drawerContent;\n      var $drawerContentContainer;\n      var errorMsg;\n\n      if ($($articleCreate).length) {\n        readyToContinue = $.Deferred();\n        $drawerContentContainer = $('<div/>', { class: 'actions-bar__drawer__content' });\n        $articleCreateDrawer.append($drawerContentContainer);\n\n        $articleCreate.on('nbcore_action_button.alterSettings', function (e, buttonSettings) {\n          // Add to defer array to pause and wait for user feedback.\n          buttonSettings.defer.push(readyToContinue);\n\n          // Set the default drawer content to the save button.\n          $drawerContent = $('<p/>')\n            .append($('<button/>', { class: 'prm-article-create__submit form-submit', text: Drupal.t('Save Article') }));\n\n          if (!Drupal.settings.gnus_prm.isAnonymous) {\n\n            // Get saved articles indexed by docref to check if this is already saved.\n            savedArticles = nbcore_prm_articles.getIndexedArticles();\n            hasDocref = prmHasDocref(savedArticles, docRef);\n            if (hasDocref) {\n\n              // If article is already saved, reset the drawer content to display message.\n              $drawerContent = $('<p/>', { text: 'This article is already saved to ' })\n                .append($('<a/>', { href: mySavedArticlesURI, text: Drupal.t('My Saved Articles') }))\n                .append('.');\n              // Add disabled class to button.\n              $('button.actions-bar__button--prmadddoc', context).addClass('actions-bar__action--disabled');\n            }\n          }\n\n          // Append content to drawer.\n          $drawerContentContainer.append($drawerContent);\n\n          // Function to add to the complete section at the end of the action button lifecycle.\n          function prmSaveArticleOnSubmit(btnSettings) {\n            if (btnSettings.returnData.success) {\n              $drawerContent = $('<p/>', { text: 'This article has been saved to ' })\n                .append($('<a/>', { href: mySavedArticlesURI, text: Drupal.t('My Saved Articles') }))\n                .append('.');\n              // Disable reset because this is a single use button.\n              $articleCreate.disableReset();\n            } else {\n              errorMsg = btnSettings.returnData.response.error;\n              if (btnSettings.returnData.response.error_message !== 'null') {\n                errorMsg += btnSettings.returnData.response.error_message;\n              }\n              $drawerContent = $('<p/>', { class: 'prm-message__error', text: 'There was an error saving this article: ' + errorMsg + '.' });\n              $drawerContentContainer.html($drawerContent);\n            }\n            $drawerContentContainer.html($drawerContent);\n            Drupal.behaviors.gnus_actions_bar_drawer_slide($articleCreateDrawer, context);\n          }\n\n          buttonSettings.functions.complete.push(prmSaveArticleOnSubmit);\n\n          // Click handler for save button that was inserted earlier. Will trigger login form if\n          // necessary and will otherwise resolve Deferred object so article can be saved.\n          $('.prm-article-create__submit').on('click', function handleSaveArticle() {\n            if (Drupal.settings.gnus_prm.isAnonymous) {\n              // Trigger the PRM login popup form if the user is not logged into PRM.\n              Drupal.gnusFunctions.gnus_prm_gnusPrmLogin(function handlePrmLoginSuccess() {\n                readyToContinue.resolve();\n              });\n            } else {\n              readyToContinue.resolve();\n            }\n          });\n        });\n      }\n    }\n  };\n\n  /*\n   * Determine if an article is already saved. Does a deep decoding for comparison.\n   *\n   * @param object savedarticles - nbcore_prm_articles.getIndexedArticles().\n   * @param string docref.\n   *\n   * @return boolean\n   *\n   */\n  function prmHasDocref(savedarticles, docref) {\n    var decodedDocRef = prmDecodeFull(docref);\n    var hasDocref = false;\n\n    if (savedarticles) {\n      $.each( savedarticles, function(key) {\n        var decodedSavedDocref = prmDecodeFull(key);\n        if (decodedSavedDocref == decodedDocRef) {\n          hasDocref = true;\n          return false;\n        }\n      });\n    }\n    return hasDocref;\n\n    function prmDecodeFull(str){\n      try{\n        var decoded = decodeURIComponent(str.replace(/\\+/g, '%20'));\n        if(decoded == str){\n          return decoded;\n        }\n        return prmDecodeFull(decoded);\n      } catch(e){\n        return str;\n      }\n    }\n\n  }\n\n})(jQuery);\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
          "_error": null,
          "_fetchedViaServiceWorker": false
        },
