            "mimeType": "application/javascript",
            "text": "if (typeof nbcore_prm == 'undefined') {\n  var nbcore_prm = (function($) {\n\n\n    /**\n     * Create a new PRM account.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function createUser(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_global.user_create_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Update an existing PRM account.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function updateUser(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_global.user_update_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Get info about current prm account.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function getInfo(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_global.getinfo_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Login prm account.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function login(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_global.login_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Logout prm account.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function logout(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_global.logout_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Simple helper function to make the request and return a response.\n     */\n    function fetch(url, data, async) {\n      var response = '';\n\n      // POST the data asynchronously.\n      $.ajax({\n        type: \"POST\",\n        url: url,\n        data: data,\n        //contentType: 'application/json',\n        async: async,\n        dataType: \"json\",\n        timeout: 5000,\n        success: function(data, text) {\n          response = data;\n        },\n        error: function(request, status, error) {\n          response = {success: false, response: {\n            error: \"Ajax Error\", error_message: \"Status = \" + request.status + ': ' + error\n          }};\n          console.error('nbcore_prm.fetch() error', response, url, data, request);\n        }\n      });\n\n      return response;\n    }\n\n  return {\n    createUser: createUser,\n    updateUser: updateUser,\n    login: login,\n    logout: logout,\n    getInfo: getInfo,\n    fetch: fetch\n  };\n\n  })(jQuery);\n}\n"
