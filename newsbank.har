            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  /*\n   * Move publication metadata / Email Alert button to different panel pane, and add alert bell icon.\n   */\n  Drupal.behaviors.gnus_browse_pub = {\n    attach: function (context, settings) {\n      if ($('.browsepub_meta', context).length >= 1 && $('.browsepub_meta--wrapper', context).length >= 1 ) {\n        $('.browsepub_meta', context).appendTo($('.browsepub_meta--wrapper', context));\n        Drupal.gnusFunctions.svgInline('icon-alert-bell.svg', $('.button-email-alert', context), 'append');\n      }\n    }\n  };\n})(jQuery);\n"
