          "content": {
            "size": 2877,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  Drupal.behaviors.gnusFatCatsMenu = {\n    attach: function (context, settings) {\n\n      $('.fat-cats__inner').gnusAccessibleMegaMenu({\n        /* prefix for generated unique id attributes, which are required\n         to indicate aria-owns, aria-controls and aria-labelledby */\n        uuidPrefix: \"accessible-megamenu\",\n\n        /* css class used to define the megamenu styling */\n        menuClass: \"fat-cats__list\",\n\n        /* css class for a top-level navigation item in the megamenu */\n        topNavItemClass: \"fat-cats__category__item\",\n\n        /* css class for a megamenu panel */\n        panelClass: \"fat-cats__topic__sub-category\",\n\n        /* css class for top level list */\n        menuOpenClass: \"has-open-menu\",\n\n        /* css class for a group of items within a megamenu panel */\n        panelGroupClass: \"fat-cats__topic__list\",\n\n        /* css class for the hover state */\n        hoverClass: \"has-hover\",\n\n        /* css class for the focus state */\n        focusClass: \"has-focus\",\n\n        /* css class for the open state */\n        openClass: \"is-open\",\n\n        /* css class for the open state */\n        closeButtonClass: \"fat-cats__topic__sub-category__close\"\n      });\n\n      // If there is a top-level category anchor in the URL, open it.\n      if (window.location.hash != 'undefined') {\n        $('[href=\"' + window.location.hash + '\"]').click();\n      }\n\n      // When clicking on a top-level category, move it to the top of the window.\n      $('.fat-cats__category__item__link', context).each(function() {\n        $(this).on('click', function() {\n          $('html,body', context).animate({scrollTop: $(this).offset().top}, 500);\n        })\n      });\n\n      // Calculate the width of the browser's scrollbar\n      var div = $('<div style=\"width:50px;height:50px;overflow:hidden;position:absolute;top:-200px;left:-200px;\"><div style=\"height: 50px;\"></div>');\n      $('body', context).append(div);\n      var w1 = $('div', div).innerWidth();\n      div.css('overflow', 'scroll');\n      $('div', div).css({'overflow' : 'hidden'}); // Adding this fixes weird Chrome bug\n      var w2 = $('div', div).innerWidth();\n      $(div).remove();\n      var scrollbarWidth = (w1 - w2);\n\n      // Set inline CSS styles on load and when window is resized.\n      $(window).on('resize', function() {\n        // Get offset of element that subcategory container is positioned off of.\n        var subcategoryOffset = $('.fat-cats__inner', context).offset();\n        var subcategoryOffsetLeft = (subcategoryOffset) ? subcategoryOffset.left : 0;\n\n        // Set offset and width of fat cats subcategory containers (taking into account the scrollbar width).\n        $('.fat-cats__topic__sub-category', context).css({'width' : 'calc(100vw - ' + scrollbarWidth + 'px)', 'left' : '-' + subcategoryOffsetLeft + 'px'});\n      }).resize();\n    }\n  };\n})(jQuery);\n"
          },
