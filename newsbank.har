            "mimeType": "application/javascript",
            "text": "var $ = jQuery.noConflict();\r\n\r\n/**\r\n * An object that wraps XMLHttpRequest in a Promise structure.\r\n * More Info on XMLHttpRequest here:\r\n *  - https://developer.mozilla.org/en-US/docs/Web/API/XMLHttpRequest\r\n */\r\nvar NBRequest = {\r\n  /**\r\n   * The function that makes the XMLHttpRequest.\r\n   *\r\n   * @param {object} payload\r\n   *   {url, data, params, responseType, method}\r\n   *    NOTE: payload.data can be anything that is passed directly into: XMLHttpRequest.send(data)\r\n   *       payload.params will be added to the URL (eg. using GET or POST with data).\r\n   *      (Use both when your request requires params and content data.).\r\n   *\r\n   * @return {Promise}\r\n   *   Returns resolve on success and reject on failure.\r\n   */\r\n  httpRequest: function(payload) {\r\n    // Return a new promise.\r\n    return new Promise(function(resolve, reject) {\r\n      try {\r\n        // Figure out what method of request this will be.\r\n        var method = (payload.method) ? payload.method : ((payload.data) ? 'POST' : 'GET');\r\n        // Keep track of response type for IE11 (lack of support).\r\n        var responseType = (payload.responseType) ? payload.responseType : 'json';\r\n        // Set data/params to null (instead of not undefined).\r\n        var data = (payload.data) ? payload.data : null;\r\n        var params = (payload.params) ? payload.params : null;\r\n        // If we have params lets make sure they are treated properly.\r\n        if (payload.params) {\r\n          // If this is a GET or data is set make a query string url.\r\n          if (method == 'GET' || data != null) {\r\n            payload.url = payload.url + '?' + $.param(payload.params);\r\n          }\r\n          // Create FormData for XMLHttpRequest.send(data) if possible or build query string.\r\n          else {\r\n            if (typeof window.FormData != 'undefined') {\r\n              data = new FormData();\r\n              for (var key in params) {\r\n                data.append(key, params[key]);\r\n              }\r\n            }\r\n            else {\r\n              data = (params) ? $.param(params) : null;\r\n            }\r\n          }\r\n        }\r\n\r\n        var xhr = new XMLHttpRequest();\r\n        xhr.open(method.toUpperCase(), payload.url, true);\r\n        xhr.responseType = responseType;\r\n        // Onload handler.\r\n        xhr.onload = function() {\r\n          // Check for a good response status.\r\n          if(xhr.readyState === XMLHttpRequest.DONE) {\r\n            var response = (xhr.response) ? xhr.response : {error: 'Empty http response received'};\r\n            // IE11 doesn't now how to handle json reponseType. :(\r\n            if (responseType == 'json' && typeof response == 'string') { response = JSON.parse(response); }\r\n            resolve(response);\r\n          }\r\n          else {\r\n            reject({\r\n              error: \"Request failure: \" + xhr.status + \" - \" + xhr.statusText,\r\n              xhr: xhr\r\n            });\r\n          }\r\n        };\r\n        // Handles network errors etc.\r\n        xhr.onerror = function() {\r\n          reject({\r\n            error: \"Network Error: \" + xhr.status + \" - \" + xhr.statusText,\r\n            xhr: xhr\r\n          });\r\n        };\r\n\r\n        // Make the request.\r\n        xhr.send(data);\r\n      } catch(e) {\r\n        console.error('NBGoogleRequest Exception', e);\r\n        reject(e);\r\n      }\r\n    });\r\n  }\r\n};\r\n"
