            "size": 2879,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Append navigator specific method to Drupal.behaviors.nbcoreReactBrowseLoad.\n */\n\n(function ($, Drupal) {\n  /**\n   * Perform gateway request to repopulate navigator row data.\n   *\n   * This is meant to be used when the existing context modifiers on the page\n   * conflict with the needs of the navigator data source.\n   *\n   * @see nbcore_react_browse_navigator_load_callback()\n   *\n   * @param {string} instanceId\n   *   The HTML id attribute of the React component container.\n   * @param {Object} extraParameters\n   *   Additional parameters to customize the gateway request:\n   *   limit, sort_field, sort_order\n   */\n  if (Drupal.behaviors.nbcoreReactBrowseLoad) {\n    Drupal.behaviors.nbcoreReactBrowseLoad.loadNavigatorData = function(instanceId, extraParams) {\n      const settings = Drupal.settings;\n      const reactSettings = settings['nbcore_react_browse__' + instanceId];\n      const callbackUrl = settings.nbbase.drupalBasePath\n        + settings.nbcore_react_browse.navigator.load_path;\n\n      $.ajax({\n        url: callbackUrl,\n        data: {\n          search_params: settings.nbapi.search_params,\n          search_options: settings.nbapi.search_options,\n          navigator_id: reactSettings.config.meta.id,\n          columns: reactSettings.cols,\n          params: extraParams,\n        },\n        success: function(response) {\n          // Error handling.\n          if (response.error) {\n            throw new Error('Could not load navigator data: ' + response.code + ' ' + response.error);\n          }\n          if (!response.rows.length) {\n            throw new Error('Empty navigator');\n          }\n\n          // Replace rows in the js settings for the react component instance.\n          reactSettings.rows = response.rows;\n\n          // Update sort in config to render with the correct default.\n          reactSettings.config.sort = response.sort;\n          let labelOverride = false;\n          if (typeof settings.rdx_navigators !== 'undefined') {\n            // There are some navigator labels that have an override in the PDEF\n            // do check to see if that is set and if so don't update with api response labels.\n            const navigatorSettings = settings.rdx_navigators;\n            for (let i = 0 ; i < navigatorSettings.overrides.length; i++) {\n              if (navigatorSettings.overrides[i] === reactSettings.config.meta.id) {\n                labelOverride = true;\n              }\n            }\n          }\n          // Update label and plural\n          if (labelOverride === false) {\n            reactSettings.config.label = response.meta.label;\n            reactSettings.config.plural = response.meta.plural;\n          }\n\n          // Custom event listener on completion of loading modal.\n          jQuery(document).trigger('nbcore_react_browse.loadDataComplete');\n        },\n      });\n    };\n  }\n\n}(jQuery, Drupal));\n"
