            "mimeType": "application/javascript",
            "text": "(function($) {\n  /*\n   * JavaScript interactions for the footer's \"Contact Customer Service\" link & modal.\n   */\n  Drupal.behaviors.custFeedbackModal = {\n    attach: function (context, settings) {\n      // Change URL in hidden field to current URL\n      var currentURL = window.location.href;\n      $('#customer-service-email .url input').val(currentURL);\n\n\n      $('.customer-service-modal', context).gnusModal($('.modal--cust-service', context), function() {\n        // Make sure any previous form submission success messages are not showing.\n        $('#customer-service-email', context).removeClass('email-form-success').css({'display' : ''});\n        $('#customer-service-email .messages', context).remove();\n        $('#customer-service-email input.error, #customer-service-email textarea.error, #customer-service-email select.error').removeClass('error');\n      });\n    }\n  };\n\n   /*\n   * JavaScript interactions for the footer's \"Help\" link & modal.\n   */\n  Drupal.behaviors.helpModal = {\n    attach: function (context, settings) {\n      $('.help-modal', context).gnusModal($('.modal--help', context), function() {\n        // Make sure any previous form submission success messages are not showing.\n        $('#help-email', context).removeClass('email-form-success').css({'display' : ''});\n        $('#help-email .messages', context).remove();\n        $('#help-email input.error, #help-email textarea.error, #help-email select.error').removeClass('error');\n      });\n    }\n  };\n\n  /*\n  * wait for html to load\n  */\n  $(window).on('load', function() {\n    $('.gnus_shared_editorial_doc__copy--success-message').hide();\n\n    /**\n     * Function to respond to local storage to show/hide xml\n     */\n    function toggleShowHideButton() {\n      let display = localStorage.getItem('display-report');\n      let showhideButton = '[Hide]';\n      if (display && display !== 'true') {\n        $('.special-reports-headlines-tool').hide();\n        showhideButton = '[Show]';\n      }\n      $('#show-special-report').text(showhideButton + \" List.xml entries\");\n    }\n\n    toggleShowHideButton();\n\n    /**\n     * Click event listenter function to toggle xml display.\n     */\n    $('#show-special-report').click(function() {\n      if ($('.special-reports-headlines-tool').is(':visible')) {\n        $('.special-reports-headlines-tool').hide();\n        localStorage.setItem('display-report', false);\n      }\n      else {\n        $('.special-reports-headlines-tool').show();\n        localStorage.setItem('display-report', true);\n      }\n      toggleShowHideButton();\n    });\n\n    // Copy Special Reports xml to clipboard\n    $('#special-reports-copy-button').click(function () {\n      window.navigator.clipboard.writeText($('.special-reports-tool__editorial-xml').text());\n      $('#special-reports-copy-button').addClass('success-button');\n      setTimeout(function () {\n        $('#special-reports-copy-button').removeClass('success-button');\n        $('.gnus_shared_editorial_doc__copy--success-message')\n          .text('Special Reports xml Copied to clipboard')\n          .show();\n      }, 1000);\n    });\n    // Copy Headlines/Activies xml to clipboard\n    $('#headlines-copy-button').click(function () {\n      window.navigator.clipboard.writeText($('.headlines-activities-tool__editorial-xml').text());\n      $('#headlines-copy-button').addClass('success-button');\n      setTimeout(function () {\n        $('#headlines-copy-button').removeClass('success-button');\n        $('.gnus_shared_editorial_doc__copy--success-message')\n          .text('Headlines/Activities xml Copied to clipboard')\n          .show();\n      }, 1000);\n    });\n  });\n\n})(jQuery);\n"
          },
