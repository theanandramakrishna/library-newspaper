          "content": {
            "size": 18246,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * JavaScript file for nbcore_pdf module.\n */\n(function($) {\n\n  // Updates a progress bar within this element with status information based on payload (as needed).\n  $.fn.updateProgress = function(payload) {\n    $target = this;\n    $target.find('progress.pdf-progressBar').show(0, function() {\n      var progress = payload.progress || 0;\n      $(this).val(progress);\n\n      var $progressStatus = $target.find('.progressStatus');\n      if ($progressStatus.length) {\n        if (payload.reset) {\n          $target.find('.pdf-status--list').empty();\n          $progressStatus.empty();\n          $progressStatusError.empty();\n        }\n        else {\n          $progressStatus.html(\" \" + progress + \"% - \" + payload.step);\n          var $progressStatusError = $target.find('.progressStatusError');\n          if (payload.error) {\n            $progressStatus.addClass(\"error\");\n            $progressStatusError.addClass(\"error\");\n            $progressStatusError.html(' : <b>' + payload.error + '</b>');\n          } else if (progress == 0) {\n            $(this).css(\"background\", \"\");\n            $progressStatus.removeClass(\"error\");\n            $progressStatusError.html('');\n            $progressStatusError.removeClass(\"error\");\n          }\n        }\n      }\n    });\n  };\n\n  // Updates the debug information with this element based on payload.\n  $.fn.updateDebug = function(payload) {\n    $(this).find('.pdf-status--container').show().find('.pdf-status--list').append(\n      '<li class=\"ok\">' + payload.function + ': ' + payload.info + '</li>');\n  };\n}(jQuery));\n\n/**\n * Class to represent the NBPDF object.\n * This object handles pdf generation, printing, and Google Drive functionality.\n *\n * @param {string} instanceId\n *   The instanceId for this instance (required for settings data).\n * @param {string} action\n *   The action that will be taken (eg. 'print', 'download', 'googledrive')\n */\nvar NBPDF = function(instanceId, action) {\n  // This is the 'event' properties to bind to.\n  var GOOGLEDRIVE_EVENT = Drupal.settings.nbcore_pdf_global.events.GOOGLEDRIVE;\n  var $ = jQuery;\n\n\n  // The data for this instance.\n  var instancedata = Drupal.settings.nbcore_pdf[instanceId];\n\n  // Create the NBFileDownload'r.\n  var fileDownloader = new NBFileDownload(\n    instanceId,\n    instancedata.filename,\n    (instancedata.__debugPDF) ? true : false\n  );\n\n  /**\n   * Starts the action .\n   *\n   * @param {object} options\n   *   An object containing properties for the pdf options.\n   *   NOTE: Pass empty {} object if not needed.\n   * @param {function} callback\n   *   An optional callback function to notify success (return: false/true).\n   */\n  function start(options, callback) {\n    var success = false;\n\n    // Merge existing options with custom app options.\n    $.extend(instancedata.options, options);\n\n    fileDownloader.init();\n    fileDownloader.updateProgress('action: ' + action, 0);\n\n    // Set the {filename, url, params} for this instance as needed.\n    setRequest(instancedata);\n    // Proceed if no errors found.\n    if (!fileDownloader.hasErrors()) {\n      switch(action) {\n        case 'print':\n          printPage(function(success) {\n            fileDownloader.updateProgress('finished', 100);\n            return callback(success);\n          });\n          break;\n        case 'download':\n          fileDownloader.downloadFile(function(success) {\n            if (success) {\n              fileDownloader.updateProgress('finished', 100);\n            }\n            return callback(success);\n          });\n          break;\n        case 'googledrive':\n          if (!instancedata.google_options.enabled) {\n            fileDownloader.reportError('downloadfailed', 'Google is not enabled for this instance.', null);\n            return callback(false);\n          }\n          googleGetAuth(true, function(resp) {\n            if (!resp.error) {\n              fileDownloader.storeBlob(true);\n              fileDownloader.downloadFile(function(success) {\n                if (success) {\n                  var folder = instancedata.google_options.folder;\n                  googleSave(folder, function(response) {\n                    fileDownloader.updateProgress('finished', 100);\n                    $('#' + instanceId).trigger(GOOGLEDRIVE_EVENT, response);\n                    if (response.error) {\n                      fileDownloader.reportError('downloadfailed', response.error, null);\n                    }\n                    return callback(!response.error);\n                  });\n                } else {\n                  fileDownloader.reportError('downloadfailed', 'Unknown Reason', null);\n                  return callback(false);\n                }\n              }, true);\n            } else {\n              fileDownloader.reportError('googleauth_error', resp.error.message, null);\n              return callback(false);\n            }\n          });\n          break;\n        default:\n          fileDownloader.reportError('unknownaction', \"Unknown action requested: \" + action);\n          return callback(false);\n      }\n    } else {\n      return callback(false);\n    }\n  };\n\n  /**\n   * Check for google authentication and prompt as needed.\n   *\n   * @param {boolean} promptForAuth\n   *   Setting to true will auto prompt for auth if needed.\n   * @param {function} callback\n   *   The callback function that returns the NBGoogleAuth.userProfile\n   *   or {error:message} object on failure.\n   */\n  function googleGetAuth(promptForAuth, callback) {\n    fileDownloader.incrementProgress('googledrive_authenticating', 5);\n    var clientAuth = NBGoogleClient.loginService;\n    if (!clientAuth.isSignedIn()) {\n      if (promptForAuth) {\n        clientAuth.signIn(function(resp) {\n          fileDownloader.incrementProgress('googledrive_authenticated', 1);\n          NBGoogleClient.updateSigninStatus(resp);\n          return callback(resp);\n        });\n      } else {\n        return callback({error: \"Google authentication failed\"});\n      }\n    } else {\n      return callback({authenticated:true});\n    }\n  }\n\n  /**\n   * Saves the file reference to google.\n   *\n   * @param {string} folderName\n   *   The folderName this file will be saved in.\n   * @param {function} callback\n   *   The callback function that returns the saved google file object reference...\n   *   or failure {error:'message'}.\n   */\n  function googleSave(folderName, callback) {\n    fileDownloader.incrementProgress('googledrive_starting', 5);\n    if (NBGoogleClient.loginService.isSignedIn()) {\n      fileDownloader.incrementProgress('googledrive_saving', 10);\n      var file = {\n        mimeType: 'application/pdf',\n        content: fileDownloader.getStoredBlob(),\n        name: fileDownloader.getFilename()\n      };\n      NBGoogleClient.driveService.saveFile(file, folderName, function(response){\n        fileDownloader.incrementProgress('googledrive_completed', 10);\n        NBGoogleClient.updateFileList();\n        return callback(response);\n      });\n    } else {\n      return callback({error: \"Google authentication required\"});\n    }\n  }\n\n  /**\n   * Generates a pdf using Gateway API (requires nbcore_pdf).\n   * NOTE: Gateway uses millimeters (mm) for dimensioning.\n   *\n   * @param {Object} imgInfo\n   *   The image info from returned from NBSiteLinks.fetchImageInfo().\n   * @param {Object} imgOptions\n   *   An object containing various propeties.\n   *   - widthOffset: in mm (to accomodate metada, margins, etc.) (default = 50).\n   *   - heightOffset: in mm (to accomodate metada, margins, etc.) (default = 175).\n   *\n   * @return {Object}\n   *   Returns url params for the pdf endpoint.\n   */\n  function getImageParams(imgInfo, imgOptions) {\n    // Offsets in mm (to accomodate metadata, margins, etc.)\n    var widthOffset = (imgOptions.widthOffset) ? imgOptions.widthOffset : 50; // 2\" approx.\n    var heightOffset = (imgOptions.heightOffset) ? imgOptions.heightOffset : 175; // 7\" approx.\n    // Calculating mm from pixels [length[mm] = (Pixel * 1 Inch[25.4mm]) / dpi] + page offsets.\n    var dpi = 96; // Use the default wkhtmltopdf dpi resolution.\n    var imageWidth = ((imgInfo.width * 25.4) / dpi);\n    var imageHeight = ((imgInfo.height * 25.4) / dpi);\n    // Add offsets for page dimensions.\n    var pageWidth = imageWidth + widthOffset;\n    var pageHeight = imageHeight + heightOffset;\n\n    // Setup params dimensional params first.  NOTE: Must be an integer.\n    var params = {\n      // Make small clippings fit at least 8.5x11 (215.9 x 279.4mm).\n      width: Math.ceil((pageWidth < 215.9) ? 215.9 : pageWidth),\n      height: Math.ceil((pageHeight < 279.4) ? 279.4 : pageHeight),\n      widthImage: Math.ceil(imageWidth),\n      heightImage: Math.ceil(imageHeight)\n    };\n\n    // Add in image src (either encoded (proxy obscured) or the normal src).\n    if (imgInfo.encoded_src) {\n      params.image_url_encoded = imgInfo.encoded_src;\n    }\n    else {\n      params.image_url = imgInfo.src;\n    }\n\n    return params;\n  }\n\n  /**\n   * A helper function for setting path/params that will be used for PDF and print.\n   *\n   * @param {Object} instancedata\n   *   The instance data for these params.\n   */\n  function setRequest(instancedata) {\n    var url = Drupal.settings.nbbase.drupalBasePath;\n\n    // Print bypasses the pdf download path for direct rendering of the page.\n    if (action == 'print') {\n      url += Drupal.settings.nbcore_pdf_global.pdf_render_path;\n    }\n    else {\n      url += Drupal.settings.nbcore_pdf_global.pdf_download_path;\n    }\n\n    // Build out the default request params and add to it as needed below.\n    var params = {\n      action: action,\n      '__debugPDF': instancedata.__debugPDF,\n      '__debugPDFHTML': instancedata.__debugPDFHTML,\n    };\n\n    // Merge params into one.\n    $.extend(params, instancedata.template_params);\n\n    // Page and image options.\n    var options = instancedata.options || {};\n    // Page information: eg. page: {orientation: 'portrait', size: 'letter'}\n    if (options.page) {\n      params.page = JSON.stringify(options.page);\n    }\n    // This overrides the default for an alternate page to render html content.\n    if (instancedata.override_render_path) {\n      params.path = instancedata.override_render_path;\n    }\n\n    // Get specific info based on the source.\n    switch(instancedata.pdf_source) {\n      case 'doc':\n        // Convert metadata to json string.\n        if (params.metadata) {\n          params.metadata = JSON.stringify(params.metadata);\n        }\n        // Image Docs require special handling through OSD sitelinks.\n        if (instancedata.doc_type == 'image' && typeof NBViewerStore !== 'undefined') {\n          // Get the current instance of the NBViewerStore.\n          var nbViewerStore = NBViewerStore;\n          // Progress always halts here... randomize this spot a little.\n          fileDownloader.incrementProgress('fetchingimage', Math.floor(Math.random() * 10) + 1);\n          // Get image reference and extra image params...\n          var imgOptions = options.image || {};\n          nbViewerStore.nbSiteLinks().fetchImageInfo(imgOptions, function(imgInfo) {\n            // Progress always halts here... randomize this spot a little.\n            fileDownloader.incrementProgress('imagefetched', Math.floor(Math.random() * 10) + 1);\n            var imageParams = getImageParams(imgInfo, imgOptions);\n            $.extend(params, imageParams);\n          });\n        }\n\n        fileDownloader.setURL(url);\n        fileDownloader.setParams(params);\n        break;\n      case 'sitelinks_pdf':\n        // Requires special handling through OSD sitelinks.\n        if (instancedata.doc_type == 'image' && typeof NBViewerStore !== 'undefined') {\n          // Get the current instance of the NBViewerStore.\n          var nbViewerStore = NBViewerStore;\n          var pdfOptions = options.sitelinks_pdf || {};\n          var url = Drupal.settings.nbbase.drupalBasePath +\n            Drupal.settings.nbcore_pdf_global.pdf_sitelinks;\n          params = nbViewerStore.nbSiteLinks().getParams(pdfOptions);\n          fileDownloader.setFilename(options.filename);\n          fileDownloader.setURL(url);\n          fileDownloader.setParams(params);\n        }\n        else {\n          fileDownloader.reportError('downloadfailed', 'Requires OSD image document.', null);\n        }\n        break;\n      case 'sitelinks_img':\n        // Requires special handling through OSD sitelinks.\n        if (instancedata.doc_type == 'image' && typeof NBViewerStore !== 'undefined') {\n          // Get the current instance of the NBViewerStore.\n          var nbViewerStore = NBViewerStore;\n          // Get image reference and extra image params...\n          var imgOptions = options.image || {};\n          nbViewerStore.nbSiteLinks().fetchImageInfo(imgOptions, function(imgInfo) {\n            if (!imgInfo.error) {\n              var ext = imgInfo.src.split('.').pop();\n              var filename = fileDownloader.getFilename() + '.' + ext;\n              fileDownloader.setFilename(filename);\n              fileDownloader.setURL(imgInfo.src);\n            }\n            else {\n              fileDownloader.reportError('downloadfailed',\n                'Download failed: ' + imgInfo.error.message, null);\n            }\n          });\n        }\n        else {\n          fileDownloader.reportError('downloadfailed', 'Requires OSD image document.', null);\n        }\n        break;\n      // Just set the url and params as needed.\n      default:\n        fileDownloader.setURL(url);\n        fileDownloader.setParams(params);\n    }\n  }\n\n  /**\n   * function print image\n   *\n   * @param {function} callback\n   *   A callback function to notify success (return: false/true).\n   */\n  function printPage(callback) {\n    fileDownloader.incrementProgress('printstarting', 10);\n\n    // Fetch the HTML to print.\n    getHTML(function(responseText) {\n      if (responseText) {\n        // creating a new\n        var ifr = $('<iframe/>', {\n          id: 'nbpdf-print-frame-' + (new Date()).getTime(),\n          //sandbox: \"allow-scripts allow-same-origin\",\n          srcdoc: responseText,\n          src: \"data:text/html;charset=utf-8,\" + escape(responseText), // Legacy browsers.\n          style: 'width: 0px; height: 0px;',\n          scrolling: 'no'\n        })\n        .appendTo($('#' + instanceId));\n\n        // Add content (srcdoc and src data:text/html is not supported by IE.\n        // Unfortunately this does not work in FF either, so we load the src/srcdoc above and fallback here for IE11/Edge\n        if (!(\"srcdoc\" in document.createElement(\"iframe\"))) {\n          ifr.contents().find('html').html(responseText);\n        }\n        // Once the iframe loads, we can proceed to print.\n        ifr.on(\"load\", function() {\n          fileDownloader.incrementProgress('printing_iframeloaded', 20);\n\n          var ifrWindow = this.contentWindow;\n\n          // Check that we don't have an error in the iframe (Error pages are valid).\n          var ifTitle = ifrWindow.document.title;//this.contentDocument.title;\n          if (ifTitle.indexOf('404') >= 0 || ifTitle.indexOf('500') >= 0) {\n            fileDownloader.reportError('iframeerror', \"Error Loading Iframe: \" + ifTitle);\n          }\n          else {\n            fileDownloader.incrementProgress('printing', 10);\n\n            var beforePrint = function() {\n              fileDownloader.incrementProgress('printing_started', 10);\n            };\n\n            var afterPrint = function() {\n\n              // Not removing the iframe here fixes the FF bug but leaves orphaned iframe(s) in the DOM.\n              // But it's necessary for other browsers to avoid double zustats.\n              if (navigator.userAgent.indexOf(\"Firefox\") == -1) {\n                // On Android, this iframe removal seems to happen too soon, right before rendering\n                // the page preview. We have to wait a few seconds to avoid Android not reading\n                // the iframe contents.\n                setTimeout(function() {\n                  $(ifr).remove();\n                }, 2000);\n              }\n              fileDownloader.incrementProgress('printing_completed', 10);\n              // Notify completed via callback.\n              callback(true);\n            };\n\n            // Listen for before/after print to update interface status.\n            if (ifrWindow.matchMedia) {\n              var mediaQueryList = ifrWindow.matchMedia('print');\n              mediaQueryList.addListener(function(mql) {\n                if (mql.matches) beforePrint();\n                else afterPrint();\n              });\n            }\n\n            // Required for FF/IE\n            ifrWindow.onbeforeprint = beforePrint;\n            ifrWindow.onafterprint = afterPrint;\n\n            ifrWindow.focus(); // Required for older versions of IE.\n            ifrWindow.print();\n          }\n        })\n        .error(function(e){\n          fileDownloader.reportError('iframeerror', \"Error Loading Iframe: \" + e.message);\n          callback(false);\n        });\n      } else {\n        callback(false);\n      }\n    });\n  }\n\n  /**\n   * Gets the HTML for this instance when printing.\n   *\n   * @param {function} callback\n   *   A callback function upon completion (return: false/true or xhr response html).\n   */\n  function getHTML(callback) {\n    var xhr = new XMLHttpRequest();\n    var path = fileDownloader.getURL();\n    var params = fileDownloader.getParams();\n    var data = (params) ? fileDownloader.getXHRData(params) : {};\n    fileDownloader.incrementProgress('fetchinghtml', 5);\n    var dTimer = window.setInterval(function(){\n      fileDownloader.incrementProgress('renderinghtml', 1)\n    }, 500);\n\n    xhr.onreadystatechange = function() {\n      if(xhr.readyState === XMLHttpRequest.DONE) {\n        window.clearInterval(dTimer);\n        if (xhr.status == 200) {\n          callback(xhr.responseText);\n        }\n        else {\n          fileDownloader.reportError('getHTML', \"Fetching HTML failed: status = \" +\n            xhr.status + \": \" + xhr.statusText, xhr);\n          if (typeof callback == 'function') { return callback(false); }\n        }\n      }\n    };\n    xhr.open('POST', path);\n    xhr.send(data);\n  }\n\n  // Revealed public methods and properties for this module instance.\n  return {\n    start: start,\n    abort: function() { fileDownloader.abort(); },\n  };\n\n};\n"
