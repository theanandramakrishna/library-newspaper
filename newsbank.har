          "content": {
            "size": 16482,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  Drupal.behaviors.gnus_multidoc = {\n    attach: function(context, settings) {\n      var documentPath = Drupal.settings.nbbase.drupalBasePath + Drupal.settings.nbcore_multidocs_global.get_path;\n      var overlayActiveClass = 'js-overlay--active';\n      var modalActiveClass = 'js-modal--active';\n      var product = Drupal.settings.nbbase.product;\n\n      Drupal.settings.gnus_multidoc = Drupal.settings.gnus_multidoc || {};\n      Drupal.settings.gnus_multidoc.pagerLastDocOnPage = Drupal.settings.gnus_multidoc.pagerLastDocOnPage || '';\n      Drupal.settings.gnus_multidoc.pagerTotalDocs = Drupal.settings.gnus_multidoc.pagerTotalDocs || '';\n\n      // Check that we have an action bar before attempting to add jQuery .on() handlers.\n      //  - This prevents drupal admin form (old jquery version) from blowing up.\n      if ($('.actions-bar__button').length) {\n        // The use of context is important to prevent events being stacked up.\n        $('.pane-action-bar-search-results .actions-bar__button', context).on('click', function() {\n          var action = (function(elem) {\n            // Determine the appropriate action for this event.\n            if (elem.hasClass('actions-bar__button--email'))\n              return 'email';\n            else if (elem.hasClass('actions-bar__button--print'))\n              return 'print';\n            else if (elem.hasClass('actions-bar__button--download'))\n              return 'download';\n            else if (elem.hasClass('actions-bar__button--cite'))\n              return 'cite';\n          }($(this)));\n\n          if (action) {\n            $('body', context).trigger('gnus_multidoc.action', {\n              actionParam: action\n            });\n          }\n        });\n\n        // The gnus_multidoc.action handler.\n        $('body', context).on('gnus_multidoc.action', function(event, payload) {\n          var actionParam = payload.actionParam,\n              citations = ['aglc', 'apa', 'asa', 'cms', 'harvard', 'mla', 'turabian'],\n              urlParams = {};\n          switch (actionParam) {\n            case 'email':\n              urlParams = {\n                action: actionParam,\n                p: product,\n                maxresults: 20,\n                zustat_category_override: 'co_sc_email'\n              };\n              break;\n            case 'print':\n              urlParams = {\n                action: actionParam,\n                p: product,\n                citations: citations.join('|||'),\n                maxresults: 20,\n                zustat_category_override: 'co_sc_print_preview'\n              };\n              break;\n            case 'download':\n              urlParams = {\n                action: actionParam,\n                p: product,\n                // Do not include citations param automatically or all will be shown when downloading with unchecked citations state.\n                // citations: citations.join('|||'),\n                pdf_path: 'multidocs',\n                maxresults: 20,\n                pdf_params: 'action=pdf&format=pdf&pdf_enabled=false&load_pager=false&maxresults=100',\n                zustat_category_override: 'co_sc_pdf_download'\n              };\n              break;\n            case 'cite':\n              urlParams = {\n                action: actionParam,\n                p: product,\n                citations: citations.join('|||'),\n                maxresults: 20,\n                zustat_category_override: 'co_sc_citation'\n              }\n              break;\n            default:\n              console.error(\"Invalid actionParam\", actionParam);\n          }\n\n          // Add in prod_docrefs param for proper productization of citations.\n          if (payload.prodDocrefs) {\n            urlParams.prod_docrefs = payload.prodDocrefs;\n          }\n\n\n          // Append a container div at the bottom of the page into which\n          // multidoc modal will be loaded and append loader animation div.\n          $('body', context).append('<div class=\"gnus-multidoc-container\"></div><div class=\"loader__animation loader__animation--multidoc\"></div>');\n          $('body', context).addClass(overlayActiveClass);\n\n          // Load the data and generate the multidoc modal\n          $('.gnus-multidoc-container', context).load(documentPath, urlParams, function() {\n            if (actionParam == 'download' || actionParam == 'print') {\n              multidocModalSelectChange();\n            }\n            $('.modal-multidoc', context).addClass(modalActiveClass);\n            $('.modal-multidoc', context).attr('aria-hidden', false);\n            $('.loader__animation--multidoc', context).remove();\n            if (actionParam == 'email') {\n              modalInsertEmailForm();\n            }\n          });\n\n          // Trigger function when print or download button is pressed.\n          if (actionParam == 'print') {\n            $(document).on('click.multidocModal', '.multidoc-print__button', PrintElem);\n          } else if (actionParam == 'download') {\n            $(document).on('click.multidocModal', '.multidoc-download__button', DownloadElem);\n          }\n\n          // Trigger function to close modal when close button or overlay is clicked.\n          $(document).on('click.multidocModal', '.modal-close, .site-overlay', function () {\n            multidocModalClose(actionParam);\n          });\n\n          // Trigger function to close modal when ESC is pressed.\n          $(document).on('keyup.multidocModal', function (e) {\n            if (e.keyCode == 27) {\n              multidocModalClose(actionParam);\n            }\n          });\n\n          // Listen for loading event. Show/hide loader animation within the modal.\n          $(document).on('nbcore_multidocs_pager.toggleLoading.multidocModal', function(e, args) {\n            var $modal = $('.modal-multidoc', context);\n            var $modalContent = $('.modal-content', $modal);\n\n            if (args.status == 'begin') {\n              $modal.addClass('js-loading');\n              $modalContent.append('<div class=\"modal-load\"><div class=\"loader__animation\"></div></div>');\n            }\n            else {\n              $modal.removeClass('js-loading');\n              $('.modal-load', $modalContent).remove();\n            }\n          });\n\n          if (actionParam == 'email') {\n            // Execute when pager is rebuilt for email\n            $(document).on('nbcore_multidocs_pager.updateState.multidocModal', function(e, args) {\n              insertMultidocHeaderData();\n              formMessageClear();\n              emailFormChanges();\n              insertMultidocData();\n\n              // Update global variable with current pager's values.\n              Drupal.settings.gnus_multidoc.pagerLastDocOnPage = args.lastDocOnPage;\n              Drupal.settings.gnus_multidoc.pagerTotalDocs = args.totalDocs;\n            });\n          }\n          else {\n            if (actionParam == 'download' || actionParam == 'print') {\n              // Enable select if \"Include citation\" is checked.\n              $(document).on('click.multidocModal', '.multidocs__cite--checkbox, .multidocs__cite--label', multidocModalSelectEnable);\n              // Event Listener to Select element to add attribute to show/hide citation styles\n              $(document).on('change.multidocModal', '.multidocs__cite--select', multidocModalSelectChange);\n            }\n            else if (actionParam == 'cite') {\n              // Event Listener to show citations when style is clicked.\n              $(document).on('click.multidocModal', '.multidocs__citation-link', citationSelectionClick);\n            }\n\n            // Execute when pager is rebuilt\n            $(document).on('nbcore_multidocs_pager.updateState.multidocModal', insertMultidocHeaderData);\n          }\n        });\n      }\n\n      // Move the email form into the modal\n      function modalInsertEmailForm() {\n        var $emailForm = $('.multidoc-email-form', context);\n        // Clear any text that may be in form elements (except for the email_article_data textarea).\n        $('input[type=\"text\"], textarea:not([name=\"email_article_data\"])',$emailForm).val('');\n\n        // Move form to modal, and remove hidden class.\n        $emailForm.appendTo('.modal-multidoc-email .modal-content');\n        $('.modal-content .multidoc-email-form', context).removeClass('hidden');\n      }\n\n      // Clear any success or error messages from form.\n      function formMessageClear() {\n        $('.multidoc-email-form .messages').remove();\n        $('.multidoc-email-form .error').removeClass('error');\n      }\n\n      // Insert the data from the AJAX call into the textarea. Gets run on pager load.\n      function insertMultidocData() {\n        $('.modal-multidoc-email .email-article-data textarea').html('');\n        $('.email-article-data textarea').val($('.multidocs_container').html());\n      }\n\n      // Make changes to email form on every AJAX call.\n      function emailFormChanges() {\n        // Move submit button to modal footer.\n        if ($('.modal-multidoc-email').length && $('.multidoc-email-form input[type=\"submit\"]').length) {\n          // Remove any input[type=submit] elements that currently exist in the modal footer.\n          $('.modal-multidoc-email .modal-footer input[type=\"submit\"]').remove();\n\n          // Move any new buttons that are generated from Drupal AJAX system into the modal footer.\n          $('.multidoc-email-form input[type=\"submit\"]').insertBefore($('.modal-multidoc-email .multidocs_progress__wrapper'));\n        }\n\n        // When form is submitted, remove \"Please hit the Next button to navigate to the next group of documents\"\n        // message if there is no next group of documents.\n        if ((Drupal.settings.gnus_multidoc.pagerLastDocOnPage >= Drupal.settings.gnus_multidoc.pagerTotalDocs) && ($('.multidoc-email-form .messages.status').length)) {\n          $('.multidoc-email-form .navigate_next').remove();\n        }\n      }\n\n      // Actions after citation is selected\n      function citationSelectionClick() {\n        var $modalCiteSelectorContainer = $('.multidocs__citations--info', context);\n        var $modalResultsContainer = $('.multidocs__citations__results', context);\n\n        // Get citation style off of link parent's data-attribute.\n        var citeStyle = $(this).parent().attr('data-cite-style');\n\n        // Hide citation selection container.\n        $modalCiteSelectorContainer.hide();\n\n        // Add attribute to results container and show it.\n        $modalResultsContainer.attr('data-cite-style', citeStyle).show();\n\n        // Show the footer which is hidden.\n        $('.modal-multidoc .modal-footer', context).show();\n      }\n\n      // Enable / disable select citation style dropdown based on whether checkbox is checked.\n      function multidocModalSelectEnable() {\n        if ($('.multidocs__cite--checkbox', context).is(':checked')) {\n          multidocModalSelectChange();\n        }\n        else {\n          $('.multidocs__cite--select', context).attr('disabled', 'disabled');\n          $('.multidocs_container', context).removeAttr('data-cite-style');\n        }\n      }\n\n      // Change citation attribute in DOM based on select list value.\n      function multidocModalSelectChange() {\n        var $select = $('.modal-multidoc .multidocs__cite--select', context);\n        $select.removeAttr('disabled');\n        $('.multidocs_container', context).removeAttr('data-cite-style')\n          .attr('data-cite-style', $select.val());\n      }\n\n      // Insert titles of the documents into the multidoc modal's header.\n      function insertMultidocHeaderData() {\n        // Remove old data from modal header in the event of paging\n        $('.modal-doclist', context).remove();\n        $('.modal-title__list-button', context)\n          .removeClass('js-open').text('Show List')\n          .off('click')\n          .on('click', expandCollapseShowList);\n\n        // Place list and count in multidoc modal header.\n        var $docList = $('<ul />').addClass('modal-doclist').css({'display' : 'none'});\n        $('.multidocs_container .document-view__title', context).each(function() {\n          $docList.append('<li>' + $(this).text() + '</li>');\n        });\n\n        $('.modal-multidoc .modal-header', context).append($docList);\n\n        // Expand/collapse header's \"show list\" button to reveal titles.\n        function expandCollapseShowList() {\n          var $toggleButton = $(this);\n          var $toggleList = $('.modal-doclist');\n\n          if (!$toggleButton.hasClass('js-open')) {\n            $toggleButton.addClass('js-open').text('Hide List');\n            $toggleList.slideDown();\n          }\n          else {\n            $toggleButton.removeClass('js-open').text('Show List');\n            $toggleList.slideUp();\n          }\n        }\n      }\n\n      // Opens new window to be printed, puts data in said window, prints said data.\n      function PrintElem() {\n        var printWindow = window.open('', 'PRINT', 'height=600,width=400');\n        var citationAttr = $('.multidocs_container', context).attr('data-cite-style');\n        var el = $('.multidocs_container', context).html();\n        var html = '<html><head><title>NewsBank Multidocument Print</title>' +\n          '<link rel=\"stylesheet\" type=\"text/css\" href=\"' + Drupal.settings.nbbase.drupalBasePath + 'sites/all/themes/nb_gnus/css/style.css?cache=' + Math.random().toString(36).substring(7) + '\">' +\n          '</head><body class=\"window-multidoc-print\" data-cite-style=\"' + citationAttr + '\">' + el + '</head><body >';\n\n        printWindow.document.write(html);\n        printWindow.document.close(); // necessary for IE >= 10\n        printWindow.focus(); // necessary for IE >= 10\n\n        $(printWindow).load(function() {\n          window.setTimeout(function() {\n            printWindow.print();\n            printWindow.close();\n          }, 1000);\n        });\n      }\n\n      // Downloads the PDF.\n      function DownloadElem() {\n        var $button = $(this);\n        $button.append('<span class=\"multidoc__button-spinner\"></span>');\n        // Grab the hidden PDF link.\n        var pdfLink = $('.multidocs_container .multidocs_container__pdf-link a', context).attr('href');\n\n        // Check to see if a citation is selected.\n        if ($('.multidocs__cite--checkbox', context).is(':checked')) {\n          var citeSelection = $('.modal-multidoc .multidocs__cite--select').val();\n          pdfLink = pdfLink + '&citations=' + citeSelection;\n        }\n\n        var isIE11 = !!window.MSInputMethodContext && !!document.documentMode;\n        if (isIE11) {\n          // Go get it!\n          window.location.href = pdfLink;\n          return;\n        }\n\n        // Parse filename from URL.\n        var baseurl = window.location.origin + window.location.pathname;\n        var url = new URL(baseurl + pdfLink);\n        var filename = url.searchParams.get('filename');\n\n        // Fetch and download.\n        // See: https://stackoverflow.com/a/9970672/477949\n        fetch(pdfLink)\n          .then(function(resp) {\n            return resp.blob()\n          })\n          .then(function(blob) {\n            var url = window.URL.createObjectURL(blob);\n            var a = document.createElement('a');\n            a.style.display = 'none';\n            a.href = url;\n            a.download = filename;\n            document.body.appendChild(a);\n            a.click();\n            a.remove();\n            window.URL.revokeObjectURL(url);\n            $button.find('.multidoc__button-spinner').remove();\n          })\n          .catch(function() {\n            $button.find('.multidoc__button-spinner').remove();\n          });\n      }\n\n      // Close multidoc modal, remove multidoc data from DOM\n      function multidocModalClose(actionParam) {\n        if (actionParam == 'email') {\n          // Move submit button back to original location.\n          $('.modal-multidoc-email .modal-footer input[type=\"submit\"]').appendTo($('.multidoc-email-form form > div'));\n\n          // Move email form back to its original position and hide it. This is needed in the event the modal is closed and reopened.\n          $('.multidoc-email-form').addClass('hidden');\n          $('.actions-bar__button--email').after($('.multidoc-email-form'));\n        }\n\n        // Close modals and remove overlay\n        $('body', context).removeClass(overlayActiveClass);\n        $('.gnus-multidoc-container', context).remove();\n\n        // Remove event bindings\n        $(document).off('.multidocModal');\n      }\n      emailFormChanges();\n    }\n  };\n\n}(jQuery));\n"
