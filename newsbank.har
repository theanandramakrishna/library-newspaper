            "text": "/**\n * @file\n * Tooltips for shortcuts using jQueryUI.\n *\n * @see http://api.jqueryui.com/tooltip/\n * @see https://api.jqueryui.com/position/\n */\n\n(function ($) {\n  Drupal.behaviors.shortcutsTooltips = {\n    attach: function (context, settings) {\n      if (typeof settings.gnus_shortcut !== 'undefined') {\n        var i;\n        var tooltips = Object.keys(settings.gnus_shortcut.tooltips);\n\n        for (i = 0; i < tooltips.length; i += 1) {\n          if (Object.prototype.hasOwnProperty.call(settings.gnus_shortcut.tooltips, tooltips[i])) {\n            if (typeof settings.gnus_shortcut.tooltips[tooltips[i]] !== 'undefined') {\n              $('.shortcut-link--' + tooltips[i], context)\n                .attr('title', settings.gnus_shortcut.tooltips[tooltips[i]])\n                .on('touchend', function () {\n                  window.open($(this).attr('href'), '_blank');\n                })\n                .tooltip({\n                  content: settings.gnus_shortcut.tooltips[tooltips[i]],\n                  tooltipClass: 'gnus-tooltip-popup',\n                  position: {\n                    my: 'center bottom-20',\n                    at: 'left+17 top',\n                    collision: 'fit flipfit',\n                    using: Drupal.gnusFunctions.addToolTipClass\n                  }\n                });\n            }\n          }\n        }\n      }\n    }\n  };\n}(jQuery));\n"
