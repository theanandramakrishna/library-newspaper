: [\"General Outage\", \"Ecommerce\", \"ASCII Obituaries\"], \"message\": \"We are currently in the process of upgrading our systems. We apologize for the inconvenience. Please check back shortly.\"}, \"allsearch\": {\"name\": \"Readex AllSearch\", \"headline\": \"Important notice\", \"enabled\": false, \"href\": \"https:\\/\\/infoweb.newsbank.com\\/apps\\/readex\\/?p=ARDX\", \"dependencies\": [\"General Outage\", \"Image Retrieval\", \"EAI\", \"EAN\", \"ASCII Obituaries\", \"ASCII News\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"Page images are currently not loading for several Readex products. Thank you for your patience as we work to resolve the problem. Note that Readex historical newspaper products and historical imprints products are not impacted and are fully functional.\"}, \"gb4\": {\"name\": \"GenealogyBank 4.0\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/www.genealogybank.com\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"EAI\", \"Serial Set\\/ASP\", \"SSDI\"], \"message\": \"We are experiencing issues with image content. Thank you for your patience.\"}, \"pf\": {\"name\": \"Platform\", \"headline\": \"Product Migration\", \"enabled\": false, \"href\": \"http:\\/\\/infoweb.newsbank.com\\/resources\\/?p=AMNEWS\", \"dependencies\": [\"General Outage\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"ASCII News\"], \"message\": \"Later this month, America’s Obituaries and Death Notices (AODN) will be replaced by HeritageHub, NewsBank’s flagship genealogy product. HeritageHub contains all the content in AODN . . . and a lot more. Users will be redirected to HeritageHub automatically. \"}, \"gb3\": {\"name\": \"GenealogyBank 3.0\", \"headline\": \"Content issues\", \"enabled\": false, \"href\": \"http:\\/\\/wma-gb001.genealogybank.com\\/\", \"dependencies\": [\"General Outage\", \"Ecommerce\", \"Image Retrieval\", \"EAN\", \"ASCII Obituaries\", \"EAI