          "content": {
            "size": 1798,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * JavaScript file for nbcore_google module.\n */\n\nvar $ = jQuery.noConflict();\n\n/**\n * A simple global object to bridge and wrap the Google business.\n */\nvar NBGoogleClient = {\n  signinTrigger: 'google.signin_status',\n  filesUpdated: 'google.files_updated',\n  folderName: '',\n  driveService: new NBGoogleDrive(),\n  loginService: new NBGoogleAuth(),\n  isSignedIn: function() { return this.loginService.isSignedIn(); },\n  updateFileList: function() {\n    if (this.loginService.isSignedIn() && this.folderName) {\n      this.driveService.listFiles(this.folderName, function(files) {\n        $(document).trigger(NBGoogleClient.filesUpdated, {\n          function: 'NBGoogleClient.updateFileList',\n          files: files\n        });\n      });\n    } else {\n      $(document).trigger(NBGoogleClient.filesUpdated, {});\n    }\n  },\n  // Remember this will be a callback from another context and this no longer refers to itself.\n  updateSigninStatus: function(response) {\n    if (response) {\n      that = NBGoogleClient;\n      console.debug(\"NBGoogleClient.UpdateSigninStatus status response: \", response);\n      $(document).trigger(that.signinTrigger, {\n        function: 'NBGoogleClient.updateSigninStatus',\n        isSignedIn: that.loginService.isSignedIn(),\n        profile: that.loginService.userProfile(),\n        error: (response.error) ? response.error : null\n      });\n      // Once signed in... signal filelist updating as necessary.\n      NBGoogleClient.updateFileList();\n    }\n  },\n  initClient: function() {\n    // We pass a callback function to init that updates the signin status.\n    this.loginService.init(this.updateSigninStatus);\n  },\n  setFolderName: function(folderName) {\n    this.folderName = folderName;\n  }\n};\n\n// Initialize the google client.\nNBGoogleClient.initClient();\n"
          },
