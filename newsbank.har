            "mimeType": "application/javascript",
            "text": "(function ($) {\n\n  Drupal.behaviors.gnusActionGoogleDrive = {\n    attach: function (context, settings) {\n\n      var instanceId = '';\n      var folderName = '';\n        if ($('body.page-document-view--ascii', context).length) {\n          instanceId = 'nbcore-pdf-ascii-bar';\n        }\n        else if ($('body.page-document-view--ha', context).length) {\n          instanceId = 'nbcore-pdf-ha-bar';\n        }\n\n      if (instanceId != '') {\n      var instancedata = Drupal.settings.nbcore_pdf[instanceId];\n      var folderName = instancedata.google_options.folder;\n          NBGoogleClient.setFolderName(folderName);\n      }\n\n      // Binds to the NBGoogleClient signin trigger event.\n      $(document).on(NBGoogleClient.signinTrigger, function(event, payload) {\n        if (payload.isSignedIn) {\n          // Make visible.\n          $('.google-client').addClass('google-client--authenticated');\n          // Populate profile.\n          var profile = NBGoogleClient.loginService.userProfile();\n          $('.google-client__profile-img').empty().prepend($('<img>',{\n            src: profile.image,\n            alt: 'Profile picture for ' + profile.name,\n          }));\n          $('.google-client__profile-name').html(profile.name);\n          $('.google-client__profile-email').html(profile.email);\n          // Add folder link.\n          googleDriveFolderLink();\n          // Match document margin with drawer height.\n          var $drawer = $('.actions-bar__drawer[aria-hidden=\"false\"]');\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n        }\n      });\n\n      $('.google-client').on('click', '.google-client__toggle', function(event) {\n        var text = $(this).text() == $(this).attr('data-show') ? $(this).attr('data-hide') : $(this).attr('data-show');\n        $(this).text(text);\n        var $googleClient = $(this).closest('.google-client');\n        $googleClient.toggleClass('js-expanded');\n        var $googleClientFileList = $googleClient.find('#google-client__file-list');\n        $googleClientFileList.attr('aria-hidden', function(i, val) {\n          return val == \"true\" ? false : true;\n        });\n        $googleClientFileList.toggleClass('google-client__display');\n        var $drawer = $(this).closest('.actions-bar__drawer');\n        Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n      });\n\n      // Binds to the NBGoogleClient filesUpdated trigger event.\n      $(document).on(NBGoogleClient.filesUpdated, function(event, payload) {\n        if (typeof payload.files !== 'undefined' && payload.files.length) {\n          if (!payload.files.error) {\n            var files = payload.files;\n            $('.google-client__files-list').removeClass('google-client__files-list--empty').html('');\n            // Add folder link.\n            googleDriveFolderLink();\n            // Add files.\n            $.each(files, function(index, file) {\n              var downloadlink = '';\n              if (file.webContentLink) {\n                downloadlink = $('<a />', {\n                  href : file.webContentLink,\n                  class: 'google-client__download-link',\n                  'data-id': file.id,\n                  'data-name': file.name,\n                  'data-mimeType': file.mimeType,\n                  text: 'Download'\n                });\n              }\n              var viewlink = $('<a />', {\n                href : file.webViewLink,\n                class: 'google_drive__view_link',\n                target: '_blank',\n                text: 'View'\n              });\n              // Example of converting createdTime (\"Wed Apr 4 2018 09:52:48 GMT-0700 (PDT)\").\n              var date = new Date(file.createdTime);\n              var dateString = date.toString().split(' ').slice(0, 5).join(' ');\n              var $li = $('<div class=\"google-client__file-inner\" />')\n                .append('<strong class=\"google-client__file-name\">' + file.name + '</strong> | ')\n                .append(dateString + ' | ')\n                .append(file.mimeType + ' | ')\n                .append(downloadlink)\n                .append(((downloadlink) ? ' | ' : ''))\n                .append(viewlink)\n                .wrap('<li class=\"google-client__file\" />')\n                .parent();\n\n              $('.google-client__files-list').append($li);\n            });\n\n            // Act if a new file has been downloaded to Google Docs.\n            if (Drupal.behaviors.gnusActionDrawer.newGoogleDocsDownload) {\n              var $filesList = $('.actions-bar__drawer[aria-hidden=\"false\"]').find('.google-client__files-list');\n              $filesList.scrollTop(0).scrollLeft(0);\n              var $firstItem = $filesList.find('li:first .google-client__file-inner');\n              $firstItem.addClass('js-new-content');\n              setTimeout(function() {\n                $firstItem.removeClass('js-new-content');\n                Drupal.behaviors.gnusActionDrawer.newGoogleDocsDownload = false;\n              }, 2500);\n            }\n          } else if(typeof payload.files !== 'undefined' && payload.files.error) {\n            $('.google-client__folder-link').remove();\n            $('.google-client__files-list')\n              .addClass('google-client__files-list--empty')\n              .html('<span class=\"error\">Error Loading Files: ' + payload.files.error.message + '</span>');\n          }\n        } else {\n          $('.google-client__folder-link').remove();\n          $('.google-client__files-list')\n            .addClass('google-client__files-list--empty')\n            .html('<span class=\"info\">No files found.</span>');\n        }\n        // Update document margin to match drawer.\n        var $drawer = $('.actions-bar__drawer[aria-hidden=\"false\"]');\n        // Only trigger drawer slide update when files list is expanded.\n        if ($drawer.find('.google-client__files-list').length) {\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n        }\n      });\n\n      // Adds a Google Drive folder link.\n      var googleDriveFolderLink = function() {\n\n        if (typeof instanceId !== 'undefined') {\n          NBGoogleClient.driveService.getFolderByName(folderName, function(payload) {\n            if (payload[0] && payload[0].name == folderName) {\n              $('.google-client__folder-link').remove();\n              $('<a />', {\n                href : payload[0].webViewLink,\n                class: 'google-client__folder-link',\n                text: 'View Folder',\n                target: '_blank',\n              }).insertAfter('.google-client__files-title');\n            }\n          });\n        }\n      };\n    }\n  };\n\n})(jQuery);\n"
          },
