            "size": 5088,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  Drupal.behaviors.gnusSimpleSearchClearFields = {\n    attach: function (context, settings) {\n      $('.simple-search__item--text', context).append('<button class=\"simple-search__close-icon\" type=\"reset\" aria-label=\"Clear Input\">' +\n        '<svg data-name=\"Layer 1\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15.68\" height=\"15.68\" viewBox=\"0 0 15.68 15.68\">' +\n        '<rect class=\"cls-1\" x=\"-1.18\" y=\"6.35\" width=\"18.64\" height=\"3.52\" transform=\"translate(7.82 -3.65) rotate(45)\"/>' +\n        '<rect class=\"cls-1\" x=\"-1.18\" y=\"6.35\" width=\"18.64\" height=\"3.52\" transform=\"translate(19.33 7.82) rotate(135)\"/></svg></button>');\n\n      var closeIcon = $('.simple-search__close-icon', context);\n      var textField = $('.simple-search__text-field', context);\n\n      textField.on('propertychange keyup input paste', function() {\n        var io = $(this).val().length ? 1 : 0;\n        io ? closeIcon.stop().fadeIn(200, function(){$(this).css('opacity', 1)}) : closeIcon.stop().fadeOut(200);\n      });\n      closeIcon.on('click', function(event) {\n        $(this).delay(200).fadeOut(200,0);\n        textField.val('');\n        return false;\n      });\n\n      textField.trigger('input');\n    }\n  };\n\n  Drupal.behaviors.gnusMobilePlaceholder = {\n    attach: function (context, settings) {\n      var simpleSearch = $('.simple-search__text-field');\n      var placeholder = simpleSearch.attr('placeholder');\n      var mobile_placeholder = 'Enter any keyword';\n\n      // For products with an empty string PDEF override (e.g. Military Collection).\n      if (placeholder == '') {\n        mobile_placeholder = '';\n      }\n\n      enquire.register(\"screen and (max-width: 500px)\", {\n        match : function() {\n          simpleSearch.attr('placeholder', mobile_placeholder);\n        },\n        unmatch : function() {\n          simpleSearch.attr('placeholder', placeholder);\n        }\n      });\n    }\n  };\n\n  Drupal.behaviors.mapAnchor = {\n    attach: function (context, settings) {\n      // Rewrite Map Search link to add anchor link.\n      $('.simple-search__footer--map', context).each(function () {\n        $(this).attr('href', $(this).attr('href') + '#more-search-options');\n      });\n    }\n  };\n\n  Drupal.behaviors.gnusSimpleSearchSetInitialHideDuplicatesField = {\n    attach: function (context, settings) {\n      const { DEDUPED_VALUES } = Drupal.settings['nbcore_search_hits_pane__gnus-search-hits-pane'];\n      // Get the form fields for duplicates and max results.\n      // Get the form fields for duplicates and max results.\n      let $hideDuplicatesField = $('input[name=\"hide_duplicates\"]', context);\n      let $maxResultsField = $('input[name=\"maxresults\"]', context);\n\n      // Check if the fields exist on the page before processing.\n      if (!$hideDuplicatesField.length || !$maxResultsField.length || !context.URL || !window) return;      \n    \n      // Load the toggle value from url, local storage, or default to true, in that order.\n      const dedupedToggle = context.URL.includes(`hide_duplicates=${DEDUPED_VALUES.DEDUPES_ON}`) || \n        Boolean(window.localStorage.getItem('deduped_toggle') !== 'false');\n\n      // Set the initial values for the dedupe slider field.\n      $hideDuplicatesField.val(dedupedToggle ? DEDUPED_VALUES.DEDUPES_ON  : DEDUPED_VALUES.DEDUPES_OFF);\n      $maxResultsField.val(dedupedToggle ? DEDUPED_VALUES.DEDUPED_MAX : DEDUPED_VALUES.DEFAULT_MAX);\n    }\n  }\n\n  /**\n   * Adds a tooltip to the Advanced Search link.\n   */\n\n  /* Tooltip removed per request https://newsbank.atlassian.net/browse/NNI-1095\n  Drupal.behaviors.advancedSearchTooltip = {\n    attach: function (context, settings) {\n      var tooltipMarkup = '\\\n      <div>\\\n        <p>Advanced Search Options</p>\\\n      </div>';\n      $('.page-easy-search .simple-search__footer--advanced', context)\n        .on('touchend', function() {\n          window.location = $(this).attr('href');\n        })\n        .tooltip({\n          content: tooltipMarkup,\n          items: '*',\n          tooltipClass: \"gnus-tooltip-popup\",\n          position: {\n            my: \"center bottom+55\",\n            at: \"center bottom\",\n            collision: \"fit flipfit\",\n            using: Drupal.gnusFunctions.addToolTipClass\n          }\n        });\n    }\n  }\n  */\n\n  /**\n   * Adds a tooltip to the Map Search link.\n   */\n\n  /* Tooltip removed per request https://newsbank.atlassian.net/browse/NNI-1095\n  Drupal.behaviors.mapSearchTooltip = {\n    attach: function (context, settings) {\n      var tooltipMarkup = '\\\n      <div>\\\n        <p>Map Search Options</p>\\\n      </div>';\n      $('.page-easy-search .simple-search__footer--map', context)\n        .on('touchend', function () {\n          window.location = $(this).attr('href');\n        })\n        .tooltip({\n          content: tooltipMarkup,\n          items: '*',\n          tooltipClass: \"gnus-tooltip-popup\",\n          position: {\n            my: \"center bottom+55\",\n            at: \"center bottom\",\n            collision: \"fit flipfit\",\n            using: Drupal.gnusFunctions.addToolTipClass\n          }\n        });\n    }\n  }\n  */\n\n})(jQuery);\n\n"
