          "content": {
            "size": 1810,
            "mimeType": "application/javascript",
            "text": "(function ($) {\n\n  Drupal.behaviors.gnusActionGoogleDrivePane = {\n    attach: function (context, settings) {\n      // Binds to the NBGoogleClient signin trigger event.\n      $(document).on(NBGoogleClient.signinTrigger, function(event, payload) {\n        if (payload.isSignedIn) {\n          var profile = NBGoogleClient.loginService.userProfile();\n          $('.google-client-banner').addClass('google-client-banner--authenticated');\n          $('.google-client-banner__name').text(profile.name);\n        }\n        else {\n          $('.google-client-banner--authenticated').removeClass('google-client-banner--authenticated');\n          $('.google-client--authenticated').removeClass('google-client--authenticated');\n        }\n      });\n\n      $(document).on('click', '.google-client-banner__signout, .google-client__signout', function(event) {\n\n          NBGoogleClient.loginService.signOut(NBGoogleClient.updateSigninStatus);\n          $('.google-client-banner--authenticated').removeClass('google-client-banner--authenticated');\n          $('.google-client--authenticated').removeClass('google-client--authenticated');\n          if (confirm(Drupal.t('You have removed this NewBank app from accessing your Google account. Clicking OK will logout of all Google services on this computer.'))) {\n            var logoutLocation = 'https://www.google.com/accounts/Logout?' +\n              $.param({continue: 'https://appengine.google.com/_ah/logout?' +\n              $.param({continue: window.location.href})});\n            window.location.href = logoutLocation;\n          }\n\n      });\n\n      $(document).on('click', '.google-client-banner__change-user, .google-client__change-user', function(event) {\n        NBGoogleClient.loginService.signIn(NBGoogleClient.updateSigninStatus);\n      });\n    }\n  };\n\n})(jQuery);\n"
