          "content": {
            "size": 8964,
            "mimeType": "application/javascript",
            "text": "(function ($) {\n  /**\n   * Adds a tooltip to the viewer help (keyboard navigation) icon.\n   */\n  Drupal.behaviors.viewerHelpTooltip = {\n\n    attach: function (context, settings) {\n\n      // Show the viewer keyboard navigation help.\n      $(document).on('click', '.openseadragon__zoom-toolbar--button--help', function () {\n\n          // To interact via the keyboard, the focus must be on the viewer.\n          $('.openseadragon-canvas').focus();\n\n          $(this).addClass(\"on\");\n\n          var tooltipMarkup = '\\\n            <div>\\\n              <p>Viewer Keyboard & Mouse Controls</p>\\\n              <p><small>If using a screen reader, hold CAPS LOCK and press SPACE to enable keyboard shortcuts.</small></p>\\\n              <button class=\"actions-bar__drawer__close osd-kb-nav-x\">Close Drawer</button>\\\n            </div>\\\n            <div class=\"dt\">\\\n              <div class=\"dtb\">\\\n                <div class=\"dtr\">\\\n                  <div>Pan Up</div>\\\n                  <div>[ w ]</div>\\\n                  <div>[ Up Arrow ]</div>\\\n                  <div>[ Mouse Wheel Up ]</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Pan Down</div>\\\n                  <div>[ s ]</div>\\\n                  <div>[ Down Arrow ]</div>\\\n                  <div>[ Mouse Wheel Down ]</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Pan Left</div>\\\n                  <div>[ a ]</div>\\\n                  <div>[ Left Arrow ]</div>\\\n                  <div>[ Shift + Mouse Wheel Up ]</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Pan Right</div>\\\n                  <div>[ d ]</div>\\\n                  <div>[ Right Arrow ]</div>\\\n                  <div>[ Shift + Mouse Wheel Down ]</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Fit Page</div>\\\n                  <div>[ 0 ]</div>\\\n                  <div>&nbsp;</div>\\\n                  <div>&nbsp;</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Zoom Out</div>\\\n                  <div>[ - ]</div>\\\n                  <div>[ Shift  + w ]</div>\\\n                  <div>[ Shift + Up Arrow  ]</div>\\\n                </div>\\\n                <div class=\"dtr\">\\\n                  <div>Zoom In</div>\\\n                  <div>[ + ]</div>\\\n                  <div>[ Shift + s ]</div>\\\n                  <div>[ Shift + Down Arrow ]</div>\\\n                </div>\\\n            </div>';\n\n          $(this).tooltip({\n            content: tooltipMarkup,\n            items: '.openseadragon__zoom-toolbar--button--help.on',\n            tooltipClass: \"gnus-tooltip-popup-viewer-help\",\n            position: {\n              my: \"left+25 center-55\",\n              at: \"right center\",\n              of: \"button.openseadragon__zoom-toolbar--button--help.on\",\n              collision: \"\"\n            }\n          });\n\n          $(this).trigger('mouseenter');\n\n      });\n\n      // On X. Close the Viewer Help Tooltip.\n      $(document).on('click', '.osd-kb-nav-x', function () {\n        $('.openseadragon__zoom-toolbar--button--help.on').click();\n      });\n\n       // On ESC key press. Close the viewer keyboard navigation help tooltip.\n      $(document).on('keyup', function (evt) {\n        if (evt.keyCode == 27) {\n          $('.openseadragon__zoom-toolbar--button--help.on').click();\n        }\n      });\n\n      // Hide the viewer keyboard navigation help.\n      $(document).on('click', '.openseadragon__zoom-toolbar--button--help.on', function () {\n        $(this).tooltip('close');\n        $(this).removeClass(\"on\");\n      });\n\n      // On windows resize. Close the viewer keyboard navigation help.\n      $(window).on('resize', function () {\n        $('.openseadragon__zoom-toolbar--button--help.on').tooltip('close');\n        $('.openseadragon__zoom-toolbar--button--help.on').removeClass(\"on\");\n      })\n\n      // Prevent mouseout and other related events from firing their handlers.\n      $(\".openseadragon__zoom-toolbar--button--help\").on('mouseout', function (e) {\n        e.stopImmediatePropagation();\n      });\n\n    }\n\n  };\n\n  /**\n   * digital Microfilm.\n   */\n  Drupal.behaviors.displayDigitalMicrofilm = {\n    attach: function (context, settings) {\n\n      // Filmstrip status.\n      if (!localStorage.getItem('filmStripStatus')) {\n        localStorage.setItem('filmStripStatus', 'opened');\n      }\n\n      // Filmstrip controls behavior.\n      $(document).on('click', '.filmstrip__close-button, .filmstrip__tab-button', function(e) {\n        e.preventDefault();\n        var $documentView = $('.document-view--image');\n        if ($documentView.hasClass('document-view--filmstrip-closed')) {\n          // Open.\n          $documentView.removeClass('document-view--filmstrip-closed').addClass('document-view--filmstrip-opened');\n          localStorage.setItem('filmStripStatus', 'opened');\n          setStatus();\n        }\n        else {\n          // Close.\n          $documentView.removeClass('document-view--filmstrip-opened').addClass('document-view--filmstrip-closed');\n          localStorage.setItem('filmStripStatus', 'closed');\n          setStatus();\n        }\n      });\n\n      // Filmstrip status listener.\n      if (window.nbcoreTocSelect) {\n        window.nbcoreTocSelect.subscribe('TOC_FILMSTRIP_STATUS', function (event, payload) {\n          const containerInstance = document.getElementById(payload.instanceId);\n          const parentContainer = containerInstance.parentNode.parentNode;\n          if (payload.status == 'loading') {\n            // Loading.\n          }\n          else if (payload.status == 'success') {\n            parentContainer.classList.remove('loading');\n            parentContainer.classList.remove('pane-nbcore-toc-filmstrip-pane');\n            parentContainer.classList.add('pane-nbcore-toc-filmstrip-pane_with_thumbnails');\n            $('.document-view--image').addClass(\"document-view--image_with_thumbnails\");\n\n            // Add controls.\n            var filmStripTitle = $('body').hasClass('nb-product__JRKP') ? Drupal.t('Pages') : Drupal.t('Page Thumbnails');\n            $('.filmstrip__inner')\n              .prepend('<button class=\"filmstrip__close-button\">' + Drupal.t('Close Filmstrip') + '</button>')\n              .prepend('<div class=\"filmstrip__tab\"><button class=\"filmstrip__tab-button\"><span class=\"element-invisible\"></span>' + filmStripTitle + '</button></div>');\n\n            // Set document-view classes.\n            if (localStorage.getItem('filmStripStatus') == 'opened') {\n              $('.document-view--image').addClass('document-view--filmstrip-opened');\n            }\n            else {\n              $('.document-view--image').addClass('document-view--filmstrip-closed');\n            }\n\n            // Set a11y status.\n            setStatus();\n          }\n          else if (payload.status == 'failure') {\n            $('.document-view--image').addClass(\"document-view--image_no_thumnbnails\");\n          }\n        }, 'nbcore-toc-filmstrip-gnus');\n      }\n\n      // Set closed/opened status for screen readers.\n      function setStatus() {\n        var status = localStorage.getItem('filmStripStatus') == 'opened' ? Drupal.t('Close') : Drupal.t('Open');\n        status += ' ';\n        $('.filmstrip__tab-button').find('.element-invisible').text(status);\n      }\n    }\n  };\n\n  /**\n   * Family relationships.\n   */\n  Drupal.behaviors.displayFamilyRelationships = {\n    attach: function (context, settings) {\n\n      if ($('.document-view__obit-enhanced-data').length) {\n        var $documentView = $('.document-view--image');\n\n        // Enhanced data controls behavior.\n        $(document).on('click', '.obit-enhanced-data__close-button, .obit-enhanced-data__tab-button', function(e) {\n          e.preventDefault();\n\n          if ($documentView.hasClass('document-view--enhanced-data-closed')) {\n            // Open.\n            $documentView.removeClass('document-view--enhanced-data-closed').addClass('document-view--enhanced-data-opened');\n            setStatus();\n          }\n          else {\n            // Close.\n            $documentView.removeClass('document-view--enhanced-data-opened').addClass('document-view--enhanced-data-closed');\n            setStatus();\n          }\n        });\n\n        $(window).on('load', function(){\n          var win = $(this); //this = window\n          if (win.width() < 700) {\n            // Close.\n            $documentView.removeClass('document-view--enhanced-data-opened').addClass('document-view--enhanced-data-closed');\n            setStatus();\n          }\n        });\n      }\n\n      // Set closed/opened status for screen readers.\n      function setStatus() {\n        var status = $documentView.hasClass('document-view--enhanced-data-opened') ? Drupal.t('Close') : Drupal.t('Open');\n        status += ' ';\n        $('.obit-enhanced-data__tab-button').find('.element-invisible').text(status);\n      }\n    }\n  };\n\n})(window.parent.jQuery);\n\n"
          },
