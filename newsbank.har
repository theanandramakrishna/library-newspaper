          "content": {
            "size": 22082,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  // Print, PDF, Google Drive, and clipping actions.\n  Drupal.behaviors.gnusActionDrawer = {\n    attach: function (context, settings) {\n\n      // Extend jQuery prototype object with custom methods.\n      $.fn.extend({\n        initAction: function(msg) {\n          var $drawer = $(this).closest('.actions-bar__drawer');\n          var $buttons = $drawer.find('.actions-bar__drawer-buttons');\n          var $progress = $drawer.find('.progress');\n\n          $buttons.hide();\n          $progress.children('.progress__task').html(msg);\n          $progress.show();\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n        },\n      });\n\n      var citationModal = !$('body').hasClass('nb-product__HHUB');\n\n      // Ascii doc.\n      if ($('body.page-document-view--ascii', context).length) {\n        var instanceId = 'nbcore-pdf-ascii-bar';\n\n        // Download ASCII full page PDF.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download--full', function(event) {\n          var self = this;\n          var asciiDownload = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'download',\n            docType: 'ascii',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Downloading Page');\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_pdf_download');\n            },\n          });\n          asciiDownload.start();\n        });\n\n        //  Print meta\n        $('.actions-bar__hhub-info-actions', context).on('click', 'button.actions-bar__hhub-printtext-button', function(event) {\n          var self = this;\n          var metaDocPrintFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'print',\n            docType: 'metadoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Printing Meta');\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_print_preview');\n              $(self).removeClass('actions-bar__hhub-printtext-button-clicked');\n            },\n          });\n          metaDocPrintFull.start();\n        });\n\n        //  Print Ascii\n        $('.actions-bar__item--print', context).on('click', 'button.actions-bar__button--print', function(event) {\n          var self = this;\n          var asciiDocPrintFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'print',\n            docType: 'asciidoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Printing Full Page');\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_print_preview');\n            },\n          });\n          asciiDocPrintFull.start();\n        });\n\n        // Save to google drive.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download--googledrive', function(event) {\n          var self = this;\n          var asciiGoogleDrive = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'googledrive',\n            docType: 'ascii',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Saving Page to Google Drive');\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_pdf_download_google_drive', 'google-drive');\n            },\n          });\n          asciiGoogleDrive.start();\n        });\n      }\n\n      // Activity doc.\n      if ($('body.page-document-view--headlines-activity', context).length) {\n        var instanceId = 'nbcore-pdf-activity-bar';\n\n        // Download activity to PDF.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download--full', function(event) {\n          $(this).initAction('Downloading Page');\n          var pdf = new NBPDF(instanceId, 'download');\n          pdf.start({}, function(success) {\n            completeAction(success, 'co_sc_headlines_activity_pdf');\n          });\n        });\n\n        // Save to google drive.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download--googledrive', function(event) {\n          $(this).initAction('Saving Page to Google Drive');\n          var pdf = new NBPDF(instanceId, 'googledrive');\n          pdf.start({}, function(success) {\n            completeAction(success, 'co_sc_headlines_activity_google_drive', 'google-drive');\n          });\n        });\n      }\n\n      // HA doc.\n      var haDoc = $('body.page-document-view--ha', context).length;\n      if (haDoc) {\n\n        //  Print meta\n        $('.actions-bar__hhub-info-actions', context).on('click', 'button.actions-bar__hhub-printtext-button', function(event) {\n          var self = this;\n          var metaDocPrintFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'print',\n            docType: 'metadoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Printing Meta');\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_print_preview');\n              $(self).removeClass('actions-bar__hhub-printtext-button-clicked');\n            },\n          });\n          metaDocPrintFull.start();\n        });\n\n        // If this is an HA doc, initialize PDF and OSD functionality for clip / print / save in the actions bar.\n        var instanceId = 'nbcore-pdf-ha-bar';\n        var nbViewerSelection = NBViewerStore.nbSelection();\n        var nbViewerId = NBViewerStore.getData().nbViewerID;\n\n        // If content is not clippable, disable clip buttons and add messaging.\n        if (!nbViewerSelection.canCrop()) {\n          var disabledMessage = Drupal.t('Clipping is not currently available for this content.');\n          $('.js-clipping-ui', context).remove();\n          $('.actions-bar__step-2-download', context).removeClass('js-hide').attr('aria-hidden', false);\n\n          $('button.actions-bar__button--clip', context).addClass('actions-bar__action--disabled');\n          $('.gnus-actions-bar-clip.actions-bar__drawer', context).append('<span class=\"actions-bar__disabled-msg\">' + disabledMessage + '</span>');\n        }\n\n        // Extend jQuery prototype object with custom methods.\n        $.fn.extend({\n          setSelected: function() {\n            this.each(function() {\n              $(this).html($(this).data('selected'));\n              $(this).removeClass('actions-bar__action--select');\n              $(this).data('state', 'download');\n            });\n          },\n          setDefault: function() {\n            this.each(function() {\n              $(this).html($(this).data('default'));\n              $(this).addClass('actions-bar__action--select');\n              $(this).data('state', 'select');\n            });\n          }\n        });\n\n        // Binds to the OSD Viewer for the selection toggle event.\n        $('#' + nbViewerId).on(window.NBVIEWER_SELECTION_TOGGLE, function(event, payload) {\n          if (payload.isSelecting) {\n            $('.actions-bar__action--clip', context).setSelected();\n          }\n          else {\n            $('.actions-bar__action--clip', context).setDefault();\n          }\n        });\n\n        // Multistep buttons: opens a new step.\n        $('.actions-bar__drawer', context).on('click', '[data-open-id]', function(event) {\n          var id = '#' + $(this).attr('data-open-id');\n          // Hide all.\n          $(id).closest('.actions-bar__drawer-buttons').find('.actions-bar__step').addClass('js-hide').attr('aria-hidden', true);\n          // Unhide target ID.\n          $(id).removeClass('js-hide').attr('aria-hidden', false);\n        });\n\n        // Activates the selection/clipping overlay for download clip.\n        // heightOffset is adjusted to fit image on the page with header\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download_ha--clip', function(event) {\n          if ($(this).data('state') === 'select') {\n            nbViewerSelection.toggle(true, 270, 300);\n            $(window).trigger('openSeaDragonControlsToggle', { show: false });\n          } else {\n            var self = this;\n            var haDocDownloadClip = new Drupal.gnusFunctions.Dopringle(context, settings, {\n              action: 'download',\n              docType: 'hadoc',\n              instanceId: instanceId,\n              modalTitle: $(self).text(),\n              citationModal: citationModal,\n              callbackStart: function() {\n                $(self).initAction('Downloading Clip');\n              },\n              callbackEnd: function(success) {\n                completeAction(success, 'co_sc_pdf_download');\n              },\n            });\n            haDocDownloadClip.start();\n          }\n        });\n\n        // Activates the selection/clipping overlay for download clip.\n        // heightOffset is adjusted to fit image on the page with header\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__googledrive_ha--clip', function(event) {\n          if ($(this).data('state') === 'select') {\n            nbViewerSelection.toggle(true, 270, 300);\n            $(window).trigger('openSeaDragonControlsToggle', { show: false });\n          } else {\n            var self = this;\n            var haDocGoogleDriveClip = new Drupal.gnusFunctions.Dopringle(context, settings, {\n              action: 'googledrive',\n              docType: 'hadoc',\n              instanceId: instanceId,\n              modalTitle: $(self).text(),\n              citationModal: citationModal,\n              callbackStart: function() {\n                $(self).initAction('Save Clip to Google Drive');\n              },\n              callbackEnd: function(success) {\n                completeAction(success, 'co_sc_pdf_download_google_drive', 'google-drive');\n              },\n            });\n            haDocGoogleDriveClip.start();\n          }\n        });\n\n        // Download HA full page PDF.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download_ha--full', function(event) {\n          var self = this;\n          var haDocDownloadFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'download',\n            docType: 'hadoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Downloading Full Page');\n              nbViewerSelection.toggle(false);\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_pdf_download');\n            },\n          });\n          haDocDownloadFull.start();\n        });\n\n        // Save to google drive.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__download_ha--full-googledrive', function(event) {\n          var self = this;\n          var haDocGoogleDriveFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'googledrive',\n            docType: 'hadoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Saving Full Page to Google Drive');\n              nbViewerSelection.toggle(false);\n              $(window).trigger('openSeaDragonControlsToggle', { show: true });\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_pdf_download_google_drive', 'google-drive');\n            },\n          });\n          haDocGoogleDriveFull.start();\n        });\n\n        // Activates the selection/clipping overlay for print clip.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__print_ha--clip', function(event) {\n          if ($(this).data('state') === 'select') {\n            nbViewerSelection.toggle(true, 270, 300);\n            $(window).trigger('openSeaDragonControlsToggle', { show: false });\n            // Show clipping zone info.\n            $clippingZoneInfo = $('.actions-bar__drawer[aria-hidden=\"false\"] .actions-bar__clipping-zone-info', context);\n            $clippingZoneInfo.show();\n            // Trigger drawer bar resize.\n            var $drawer = $clippingZoneInfo.parents('.actions-bar__drawer');\n            Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n          } else {\n            var self = this;\n            var haDocPrintClip = new Drupal.gnusFunctions.Dopringle(context, settings, {\n              action: 'print',\n              docType: 'hadoc',\n              instanceId: instanceId,\n              modalTitle: 'Print Clip',\n              citationModal: citationModal,\n              callbackStart: function() {\n                $(self).initAction('Printing Clip');\n              },\n              callbackEnd: function(success) {\n                completeAction(success, 'co_sc_print_preview');\n              },\n            });\n            haDocPrintClip.start();\n          }\n        });\n\n        // Print full page.\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__print_ha--full', function(event) {\n          var self = this;\n          var haDocPrintFull = new Drupal.gnusFunctions.Dopringle(context, settings, {\n            action: 'print',\n            docType: 'hadoc',\n            instanceId: instanceId,\n            modalTitle: $(self).text(),\n            citationModal: citationModal,\n            callbackStart: function() {\n              $(self).initAction('Printing Full Page');\n              nbViewerSelection.toggle(false);\n              $(window).trigger('openSeaDragonControlsToggle', { show: true });\n            },\n            callbackEnd: function(success) {\n              completeAction(success, 'co_sc_print_preview');\n            },\n          });\n          haDocPrintFull.start();\n        });\n\n        // Cancel button closes cropping tool and goes back to step 1 button(s).\n        $('.actions-bar__drawer', context).on('click', 'button.actions-bar__action--cancel', function() {\n          // Hide clipping zone info.\n          $clippingZoneInfo = $('.actions-bar__clipping-zone-info', context);\n          $clippingZoneInfo.hide();\n          // Trigger drawer bar resize.\n          var $drawer = $clippingZoneInfo.parents('.actions-bar__drawer');\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n          openStepOne();\n        });\n      }\n\n      // Binds to the NBPDF progress tracker.\n      if (typeof instanceId !== 'undefined') {\n        $('#' + instanceId).on('NBPDF.progress', function(event, payload) {\n          var progress = payload.progress || 0,\n              $progressBar = $('progress.progress__bar'),\n              $progressStatus = $('span.progress__percent');\n\n          $progressBar.val(progress).show();\n          $progressStatus.html(' ' + progress + '%');\n\n          if (payload.error) {\n            $progressStatus.addClass('progress__error');\n            $progressStatus.html('<b>An error occurred.</b>');\n            throw new Error(payload.error);\n          }\n        });\n      }\n\n      // Success callback for NBPDF call.\n      var completeAction = function(success, zustatCat, type) {\n        if (success) {\n          // Log zustat for this action.\n          try {\n            nbbase.logZustat({\n              'product': settings.nbbase.product,\n              'auth': settings.nbbase.authToken,\n              'zustat_category': zustatCat,\n              'pbi': settings.nbbase.pbi,\n              'docid': settings.nbbase.docref\n            });\n          }\n          catch (ex) {}\n\n          // Google Drive new content notification.\n          if (typeof type !== 'undefined' && type === 'google-drive') {\n            var $openDrawer = $('.actions-bar__drawer[aria-hidden=\"false\"]');\n            if ($openDrawer.length) {\n              var $googleClient = $openDrawer.find('.google-client');\n              if (!$googleClient.hasClass('js-expanded')) {\n                var $toggle = $openDrawer.find('.google-client__toggle');\n                $toggle.addClass('js-new-content');\n                setTimeout(function() {\n                  $toggle.removeClass('js-new-content');\n                }, 1000);\n              }\n              else {\n                // Flag that a new file has been downloaded to Google Drive.\n                Drupal.behaviors.gnusActionDrawer.newGoogleDocsDownload = true;\n              }\n            }\n\n          }\n          // Reset drawer, progress bar and buttons.\n          $('.actions-bar__drawer .progress', context).hide();\n          $('.actions-bar__drawer .actions-bar__drawer-buttons', context).show();\n          // Open step 1.\n          openStepOne();\n          // Update document margin to match drawer.\n          var $drawer = $('.actions-bar__drawer[aria-hidden=\"false\"]');\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer);\n          // Disable crop.\n          if (typeof nbViewerSelection !== 'undefined') {\n            nbViewerSelection.toggle(false);\n            $(window).trigger('openSeaDragonControlsToggle', { show: true });\n          }\n        }\n      };\n\n      // Reset to step 1.\n      var openStepOne = function() {\n        if (typeof nbViewerSelection !== 'undefined') {\n          nbViewerSelection.toggle(false);\n          $(window).trigger('openSeaDragonControlsToggle', { show: true });\n        }\n        // Hide all.\n        var $drawerButtons = $('.actions-bar__drawer-buttons');\n        $drawerButtons.find('.actions-bar__step').addClass('js-hide').attr('aria-hidden', true);\n        // Unhide first step.\n        if ($drawerButtons.find('.actions-bar__step-1').length) {\n          $('.actions-bar__drawer-buttons').find('.actions-bar__step-1').removeClass('js-hide').attr('aria-hidden', false);\n        }\n        else {\n          // Use alternative no-clipping step 1.\n          $('.actions-bar__drawer-buttons').find('.actions-bar__no-clipping-step-1').removeClass('js-hide').attr('aria-hidden', false);\n        }\n      };\n\n      // Drawer functionality shared between both ASCII and HA document views.\n      var closeAllDrawers = function() {\n        $('.actions-bar__button[aria-expanded]', context).attr('aria-expanded', 'false');\n        $('.actions-bar__drawer', context).attr('aria-hidden', 'true').css({'height' : ''});\n        $('.document-view, .pane-nbcore-toc-filmstrip-pane_with_thumbnails, .document-view__obit-enhanced-data-ha').css({'margin-top' : ''}); // Context intentionally omitted.\n        // Close google drive drawers.\n        var $googleClient = $('.google-client');\n        var $googleClientToggle = $('.google-client__toggle');\n        $googleClientToggle.text($googleClientToggle.attr('data-show'));\n        $googleClient.removeClass('js-expanded');\n        $googleClient.find('#google-client__file-list').attr('aria-hidden', true);\n        // Hide clipping zone info.\n        $clippingZoneInfo = $('.actions-bar__clipping-zone-info', context);\n        $clippingZoneInfo.hide();\n        // Reset buttons to step 1.\n        openStepOne();\n        if (haDoc) {\n          nbViewerSelection.toggle(false);\n          $(window).trigger('openSeaDragonControlsToggle', { show: true });\n        }\n      };\n\n      // Close drawers.\n      $('.actions-bar__button[aria-expanded]', context).click(function() {\n        var $drawer = $(this).parent().find('.actions-bar__drawer');\n\n        if ($(this).attr('aria-expanded') === 'false') {\n          closeAllDrawers();\n\n          // Animate the drawer and push down the document body.\n          Drupal.behaviors.gnus_actions_bar_drawer_slide($drawer, context);\n\n          $(this).attr('aria-expanded', 'true');\n          $(this).next().attr('aria-hidden', 'false');\n        }\n        else {\n          closeAllDrawers();\n        }\n      });\n\n      // When non-drawer buttons (except HA controls toggle button) are clicked, close all drawers\n      $('.actions-bar__button:not([aria-expanded]):not(.actions-bar__button--toggle)', context).click(function() {\n        closeAllDrawers();\n      });\n\n      // Close all drawers when a drawer's X is clicked.\n      $('.actions-bar__drawer__close', context).click(function() {\n        closeAllDrawers();\n      });\n\n      // Close all drawers when ESC is hit.\n      $(document, context).keyup(function(e) {\n        if (e.keyCode === 27) $('.actions-bar__drawer__close', context).click();\n      });\n\n    },\n    newGoogleDocsDownload: false,\n  };\n\n  /*\n   * Simple print.\n   */\n  Drupal.behaviors.actionDrawerSimplePrint = {\n    attach: function (context, settings) {\n      $(document).on('click', '.actions-bar__button--simple-print', function() {\n        if ($(\".page-headlines-activity\").length) {\n          try {\n            nbbase.logZustat({\n              'product': settings.nbbase.product,\n              'auth': settings.nbbase.authToken,\n              'zustat_category': 'co_sc_headlines_activity_print',\n            });\n          } catch (ex) {}\n          // Trigger system print dialog.\n          window.print();\n        }\n\n        else {\n        //move zustat to citation modal Drupal.behaviors.actionBarPrint\n        /*\n          try {\n            nbbase.logZustat({\n              'product': settings.nbbase.product,\n              'auth': settings.nbbase.authToken,\n              'zustat_category': 'co_sc_print_preview',\n            });\n          } catch (ex) {}\n        */\n          // Trigger system print dialog.\n          window.print();\n        }\n      });\n    }\n  }\n\n})(jQuery);\n"
