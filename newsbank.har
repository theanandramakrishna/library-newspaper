            "mimeType": "application/javascript",
            "text": "/**\n * Mobile Menu JavaScript Events.\n */\n\n(function($) {\n  'use strict';\n  Drupal.behaviors.gnus_menu_mobile_menu = {\n    attach: function (context, settings) {\n      var $body = $('body', context);\n      var $mobileMenuButton = $('.button__mobile-menu', context);\n      var $offCanvas = $('.layout__offcanvas', context);\n      var $overlay = $('.site-overlay', context);\n      var cssClass = 'js-overlay--mobile-menu-active';\n\n      $body.append('<div class=\"site-overlay--mobile-menu\"></div>');\n\n\n      if ($mobileMenuButton.length && $offCanvas.length) {\n        $mobileMenuButton.on('click', toggleMenuVisibility);\n        $(document).on('click', '.' + cssClass, toggleMenuVisibility);\n      }\n\n      function toggleMenuVisibility() {\n        if (!$body.hasClass(cssClass)) {\n          $mobileMenuButton.addClass(cssClass);\n          $offCanvas.addClass(cssClass);\n          $body.addClass(cssClass).addClass(cssClass);\n          $overlay.addClass(cssClass);\n        }\n        else {\n          $mobileMenuButton.removeClass(cssClass);\n          $offCanvas.removeClass(cssClass);\n          $body.removeClass(cssClass).removeClass(cssClass);\n          $overlay.removeClass(cssClass);\n        }\n      }\n    }\n  };\n\n})(jQuery);\n"
          },
