            "mimeType": "application/javascript",
            "text": "/**\n * This file contains JavaScript-based zustat_category overrides for\n * Readex cross-search\n */\n\n(function($) {\n\n  // WELCOME PAGE\n\n  Drupal.behaviors.gnus_zustat_welcome_page = {\n    attach: function(context, settings) {\n      $('.page-easy-search', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_simple_form'\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n    // Hot Topics\n\n  Drupal.behaviors.gnus_zustat_hottopics_page = {\n    attach: function(context, settings) {\n      $('.page-hot-topics', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_hot_topics',\n            'hot_topics_main_category': settings.gnus_hot_topics.main_category,\n            'hot_topics_date': settings.gnus_hot_topics.date,\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n  // Timeline page.\n  Drupal.behaviors.gnus_zustat_timeline_page = {\n    attach: function(context, settings) {\n      $('.page-node.node-type-timeline', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_timeline',\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n  // Essay page.\n  Drupal.behaviors.gnus_zustat_essay_page = {\n    attach: function(context, settings) {\n      $('.page-node.node-type-essay', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_timeline',\n            'timeline_topic_id': settings.gnus_timeline.timeline_topic_id,\n            'timeline_era': settings.gnus_timeline.timeline_era,\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n    // Daily Headlines Landing\n\n  Drupal.behaviors.gnus_zustat_headlines_landing_page = {\n    attach: function(context, settings) {\n      $('.page-headlines--landing-page', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_headlines',\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n    // Daily Headlines archive\n\n  Drupal.behaviors.gnus_zustat_headlines_archive_page = {\n    attach: function(context, settings) {\n      $('.page-headlines--archives', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_headlines_archive',\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n    // Daily Headlines activities archive\n\n  Drupal.behaviors.gnus_zustat_headlines_activities_archive_page = {\n    attach: function(context, settings) {\n      $('.page-headlines--activities', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_headlines_activities_archive',\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n    // Daily Headlines activity page\n\n  Drupal.behaviors.gnus_zustat_headlines_activity_page = {\n    attach: function(context, settings) {\n      $('.page-document-view--headlines-activity', context).once('zustat-logged', function() {\n        if (!$(this).hasClass(\"api-pdf\")) {  //when pdf are made zustat is managed in actionbar.js pdf section\n          try {\n            nbbase.logZustat({\n              'product': settings.nbbase.product,\n              'auth': settings.nbbase.authToken,\n              'zustat_category': 'co_sc_headlines_activity',\n              'headlines_activity_title': settings.gnus_headlines.headlines_activity_title,\n              'headlines_activity_curricular_areas': settings.gnus_headlines.headlines_activity_curricular_areas,\n            });\n          } catch (ex) {}\n        }\n      });\n    }\n  };\n\n\n  // ADVANCED SEARCH PAGE\n\n\n  Drupal.behaviors.gnus_zustat_advanced_page = {\n    attach: function(context, settings) {\n      $('.page-advanced-search', context).once('zustat-logged', function() {\n        try {\n          nbbase.logZustat({\n            'product': settings.nbbase.product,\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_advanced_form'\n          });\n        } catch (ex) {}\n      });\n    }\n  };\n\n  // SEARCH RESULTS PAGE\n\n\n  // override zustat_category for pager clicks\n  Drupal.behaviors.gnus_zustat_result_pager = {\n    attach: function(context, settings) {\n      $('.page-results .pager__item a', context).click(function() {\n        var href = $(this).attr('href');\n        nbbase.addZustatOverride(href, 'co_sc_jump');\n      });\n    }\n  };\n\n\n  // override zustat_category for print clicks\n\n\n  // DOC PAGE\n\n  // override zustat_category for back to results link\n  Drupal.behaviors.gnus_zustat_back_to_results = {\n    attach: function(context, settings) {\n      $('.doc-view--back-to-results', context).click(function() {\n        var href = $(this).attr('href');\n        nbbase.addZustatOverride(href, 'co_sc_return');\n      });\n    }\n  };\n\n  // log zustat when download page link is clicked\n  Drupal.behaviors.gnus_zustat_download_page_click = {\n    attach: function(context, settings) {\n      $('.doc-view__downloadlink', context).click(function() {\n        try {\n          var href = $(this).attr('href'),\n              exp = /xpages=([^&]*)/,\n              matches = href.match(exp),\n              statLogCount = (matches != null) ? matches[1] : 1;\n\n          nbbase.logZustat({\n            'auth': settings.nbbase.authToken,\n            'zustat_category': 'co_sc_pdf_download',\n            'product': settings.nbbase.product,\n            'pbi': settings.nbbase.pbi,\n            'docid': settings.nbbase.docref,\n            'statLogCount': statLogCount\n          });\n        } catch(ex) {}\n      });\n    }\n  };\n\n})(jQuery);\n"
