          "content": {
            "size": 4954,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * JavaScript implementation of PrmArticlesActionButtonPlugin,\n * a target plugin for the nbcore_action_button component.\n */\n\n(function definePlugin($) {\n  var plugin = 'PrmArticlesActionButtonPlugin';\n\n  function getUrlParams() {\n    var urlParams = window.location.search.substr(1).split('&').reduce(function (q, query) {\n      var chunks = query.split('=');\n      var key = chunks[0];\n      var value = chunks[1];\n\n      q[key] = value;\n\n      return q;\n    }, {});\n\n    return urlParams;\n  }\n\n  /**\n   * Compile sendData object based on the source plugin type and the target endpoint.\n   *\n   * Adds parameters to buttonSettings.sendData depending on the source.\n   */\n  function compileSendData(buttonSettings) {\n    var urlParams;\n    var saveParams;\n    var articleIds;\n    var stageData = buttonSettings.stageData[buttonSettings.source_type];\n\n    // @TODO Tech debt:\n    // It would be nice to have a better way to manage this that didn't require additional\n    // case statements when new source plugins are added.\n    switch (buttonSettings.source_type) {\n      case 'ReactBrowseActionButtonPlugin':\n        // Join saved article IDs from React checkboxes using the '|||' delimiter\n        // expected by the endpoints.\n        buttonSettings.sendData.saved_article_id = stageData.selectedKeys.join('|||');\n        break;\n\n      case 'PageUrlActionButtonPlugin':\n        urlParams = stageData.urlParams;\n\n        // Pass through url params as serialized search_query string safe for ajax.\n        if (urlParams) {\n          buttonSettings.sendData.search_query = $.param(urlParams);\n        }\n\n        // Explicitly save some param values used by endpoints.\n        saveParams = ['description', 'docref', 'tag', 'tags'];\n        saveParams.forEach(function (param) {\n          if (Object.prototype.hasOwnProperty.call(urlParams, param)) {\n            buttonSettings.sendData[param] = urlParams[param];\n          }\n        });\n\n        // Renamed from 'p' to 'product' intentionally.\n        if (Object.prototype.hasOwnProperty.call(urlParams, 'p')) {\n          buttonSettings.sendData.product = urlParams.p;\n        }\n        break;\n\n      case 'SelectedSearchHitsActionButtonPlugin':\n        articleIds =\n          Object.keys(stageData.articlesToSave);\n\n        if (articleIds.length < 1) {\n          buttonSettings.sendData.bypassSubmitToEndpoint = true;\n\n          buttonSettings.sendData.bypassSubmitToEndPointMessage =\n            Drupal.t('The selected article(s) have already been saved to your folder.')\n        } else {\n          urlParams = getUrlParams();\n\n          buttonSettings.sendData.docref = articleIds.join('|||');\n          buttonSettings.sendData.product = urlParams.p;\n          buttonSettings.sendData.search_query = $.param(urlParams);\n        }\n\n        break;\n\n      default:\n        // Debug error to indicate source plugin is not defined.\n        console.error(\n          plugin + '.compileSendData',\n          'Missing source type definition ' + buttonSettings.source_type + ' for sendData compilation.'\n        );\n        // Returning false will halt the entire lifecycle.\n        return false;\n    }\n\n    if (buttonSettings.debug) {\n      console.info(plugin + '.compileSendData', 'sendData:', buttonSettings.sendData);\n    }\n\n    return true;\n  }\n\n  /**\n   * Submit to endpoint and store returned data.\n   *\n   * Adds ajax response to returnData.\n   */\n  function submitToEndpoint(buttonSettings) {\n    var functionCRUD;\n\n    var bypassSubmit = Object.prototype.hasOwnProperty.call(\n      buttonSettings.sendData,\n      'bypassSubmitToEndpoint'\n    );\n\n    if (typeof nbcore_prm_articles === 'undefined') {\n      // Debug error to indicate JavaScript endpoint object is not defined.\n      console.error(\n        plugin + '.submitToEndpoint',\n        'Unable to access JavaScript object nbcore_prm_articles that exposes endpoints.'\n      );\n      // Returning false will halt the entire lifecycle.\n      return false;\n    }\n\n    // Check to see if plugin has opted to bypass the submit to endpoint.\n    if (bypassSubmit) {\n      buttonSettings.returnData = {\n        bypassSubmitToEndpoint: true,\n        info: buttonSettings.sendData.bypassSubmitToEndPointMessage,\n        success: false\n      };\n    } else {\n      // Determine the function to use in nbcore_prm_articles.\n      functionCRUD = nbcore_prm_articles[buttonSettings.target_prm_articles_endpoint + 'Article'];\n\n      // Submit to endpoint synchronously and save results to returnData.\n      buttonSettings.returnData = functionCRUD(buttonSettings.sendData, false);\n    }\n\n    if (buttonSettings.debug) {\n      console.info(plugin + '.submitToEndpoint', 'returnData:', buttonSettings.returnData);\n    }\n\n    return true;\n  }\n\n  // Define the plugin object with lifecycle functions.\n  Drupal.behaviors.nbcoreActionButton.PrmArticlesActionButtonPlugin = {\n    process: [compileSendData],\n    submit: [submitToEndpoint]\n  };\n}(jQuery));\n"
