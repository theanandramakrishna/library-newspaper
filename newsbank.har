 <div class=\"col-xs-12 col-sm-12 col-md-4\">\n\t\t\t\t\t\t<form autocomplete=\"off\" method='POST'>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"form-group\">\n\t\t\t\t\t\t\t\t<label for=\"barcode-input\">Barcode or Student Account Login:</label>\n\t\t\t\t\t\t\t\t<input type=\"text\" class=\"form-control\" \n\t\t\t\t\t\t\t\t\tname=\"username\" id=\"barcode-input\" required/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"form-group\">\n\t\t\t\t\t\t\t\t<label for=\"password-input\">Password or PIN</label>\n\t\t\t\t\t\t\t\t<input type=\"password\" class=\"form-control\" \n\t\t\t\t\t\t\t\t\tname=\"password\" id=\"password-input\" required/>\n\n                <small style=\"margin-top: 10px; text-decoration:underline\">\n\t\t\t\t\t\t\t    <a href=\"https://kcls.bibliocommons.com/user/forgot\">\n\t\t\t\t\t\t\t\t    Forgot your Password or PIN?\n\t\t\t\t\t\t\t    </a>\n                </small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<button type=\"submit\" class=\"btn btn-primary\" style=\"background: rgb(0,63,107)\">Log In</button>\n              <a href=\"https://kcls.org/library-cards/\">Get a Library Card</a>\n\n              <!--\n\t\t\t\t\t\t\t<input type=\"hidden\" name=\"url\" value=\"\"/>\n\t\t\t\t\t\t\t<input type=\"hidden\" name=\"qurl\" value=\"\"/>\n              -->\n              \n              <input type='hidden' name='redirect_to' value='/eg/opac/sso/openathens?returnData=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0YXJnZXRVUkwiOiIvc2FtbC8yL3Nzby9rY2xzLm9yZy9vLzgxMjYzOTc1L2MvcHJveHkub3BlbmF0aGVucy5uZXQ_.5sTBCY9_etVmwWF7JGViSJrxK3h2Kq6gDzeFXLM8VCM'/>\n\t\t\t\t\t\t</form>\n            <br/>\n          </div>\n          <div class=\"col-xs-12 col-sm-12 col-md-4\">\n            <b>Are you trying to log in with a Student Account?</b>\n            <br/>\n            <ul>\n              <li>You will not be able to register a catalog account</li>\n              <li>\n                <a href=\"https://kcls.org/students/\">\n                  <u>Visit our Student Accounts webpage to use databases, ebooks, and more</u>\n                </a>\n              </li>\n            </ul>\n            <b>Need to register?</b>\n            <br/>\n            <ul>\n              <li>Enter your Library card barcode and PIN</li>\n              <li>Log In to create your username</li>\n            </ul>\n            <b>Trouble logging in?</b>\n            <br>\n            <ul>\n              <li>\n                <a href=\"https://help.bibliocommons.com/000getting/005logging-in/\">\n                  <u>Find answers to common questions</u>\n                </a>\n              </li>\n            </ul> \n          </div>\n          <div class=\"col-xs-12 col-sm-12 col-md-4\">\n          </div>\n        </div> <!-- row -->\n      </div> <!-- ezproxy-container -->\n    </div> <!-- ezproxy-container-wrapper --> \n\n    <!-- BC FOOTER -->\n    \n  <div class=\"bc_core_external\">\n\n  <div class=\"footer_wrapper\">\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700\" /><link rel=\"stylesheet\" href=\"https://cdn-web-main.bibliocms.com/wp-content/themes/biblioweb/css/footer_all.css?ver=3596bd9208b648a4e0f48ffe23f60936\" /><div id=\"cms_external_footer\"><style>.footer-wrapper {--font-color-base:#000;--font-color-base-variant:#1a1a1a;--font-color-headings:#000000;--font-color-headings-variant:#000000;--link-color-secondary:#003f6b;--link-color-secondary-variant:#002138;--primary-brand-color:#434faf;--primary-brand-color-variant:#353e8a;--secondary-brand-color:#000000;--secondary-brand-color-variant:#000000;--link-color-default:#434faf;--link-color-default-variant:#353e8a;--link-color-default-lighten:#878fd1;--link-color-default-darken:#272e65;--font-family-base:'Lato', Helvetica, Arial, sans-serif;--font-family-headings:'Lato', Helvetica, Arial, sans-serif;--font-weight-headings:600;--sidebar-menu-color:#000000;--sidebar-menu-color-variant:#000000;-