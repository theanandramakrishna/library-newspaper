            "mimeType": "application/javascript",
            "text": "/**\n * React browse table.\n */\n\n/* globals Drupal, jQuery */\n\n(function($) {\n\n 'use strict';\n\n  Drupal.behaviors.gnus_browse_pub_react_browse = {\n    attach: function (context, settings) {\n\n      // Add SVG to filter clear button.\n      $('.nbcore-react-browse__filter-input').on('change paste keyup', function() {\n        if ($(this).val() && $('.nbcore-react-browse__filter-clear svg').length === 0) {\n          var svgString = '<svg data-name=\"Layer 1\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15.68\" height=\"15.68\" viewBox=\"0 0 15.68 15.68\">' +\n            '<rect class=\"cls-1\" x=\"-1.18\" y=\"6.35\" width=\"18.64\" height=\"3.52\" transform=\"translate(7.82 -3.65) rotate(45)\"/>' +\n            '<rect class=\"cls-1\" x=\"-1.18\" y=\"6.35\" width=\"18.64\" height=\"3.52\" transform=\"translate(19.33 7.82) rotate(135)\"/></svg>';\n          $('.nbcore-react-browse__filter-clear', context).html(svgString).show();\n        }\n      });\n\n    }\n  };\n\n//source-list\nDrupal.behaviors.reactBrowseSourceListApply = {\n    attach: function (context, settings) {\n      if ($('#nbcore-react-browse-table-pane-source-list-page').length) {\n\n        $(document).on('nbcore_react_browse.applyMultiSelect', function(e, args) {\n\n          var react_settings = settings['nbcore_react_browse__' + args.instance_id];\n\n          var url = settings.nbbase.drupalBasePath + settings.nbcore_react_browse.navigator.apply_path;\n\n          $.ajax({\n            url: url,\n            data: {\n              haystack: args.selected_haystack,\n              url_query: react_settings.config.url_query,\n            },\n            success: function(response) {\n              var redirect = settings.nbbase.drupalBasePath + 'browse-multi/?' + response.query + '&action=browse';\n              window.location.href = redirect;\n            },\n          });\n        });\n      }\n    }\n  };\n\n})(jQuery);\n"
