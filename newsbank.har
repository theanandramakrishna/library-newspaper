            "size": 3511,
            "mimeType": "application/javascript",
            "text": "if (typeof nbcore_cache == 'undefined') {\n  var nbcore_cache = (function($) {\n    /**\n     * Set cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function setCache(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_set_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Get cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function getCache(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_get_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Removes cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function removeCache(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_remove_path;\n\n      return fetch(url, data, async);\n    }\n\n\n\n    /**\n     * Set document cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function setCacheDoc(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_doc_set_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Get document cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function getCacheDoc(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_doc_get_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Removes document cache data.\n     * If you wish to wait for a return result, then set async to false.\n     * Otherwise the result won't be available (because of asynchronization).\n     */\n    function removeCacheDoc(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_cache_global.cache_doc_remove_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Simple helper function to make the request and return a response.\n     */\n    function fetch(url, data, async) {\n      var response = '';\n\n      var nbbase = Drupal.settings.nbbase;\n      if (!data.hasOwnProperty('p') && nbbase.hasOwnProperty('product')) {\n        data.p = nbbase.product;\n      }\n\n      // POST the data asynchronously.\n      $.ajax({\n        type: \"POST\",\n        url: url,\n        data: data,\n        //contentType: 'application/json',\n        async: async,\n        dataType: \"json\",\n        timeout: 5000,\n        success: function(data, text) {\n          response = data;\n        },\n        error: function(request, status, error) {\n          console.log(error);\n          return false;\n        }\n      });\n\n      return response;\n    }\n\n  return {\n    setCache: setCache,\n    getCache: getCache,\n    removeCache: removeCache,\n    setCacheDoc: setCacheDoc,\n    getCacheDoc: getCacheDoc,\n    removeCacheDoc: removeCacheDoc\n  };\n\n  })(jQuery);\n}\n"
