            "text": "function processDowntimeMessage(data) {\n  // Get NewsBank Environment variable set in nbcore_downtime module.\n  var nbcoreDowntime = Drupal.settings.nbcore_downtime;\n  var nbcoreEnvironment = nbcoreDowntime.environment;\n  var nbcoreDowntimeForce = nbcoreDowntime.force;\n\n  // Check for enabled downtime message and display results if enabled.\n  if (nbcoreEnvironment in data.sites) {\n    if (data.sites[nbcoreEnvironment].enabled || nbcoreDowntimeForce) {\n      jQuery('<div/>')\n        .addClass('nbcore-downtime__message-heading')\n        .appendTo(jQuery('.nbcore-downtime__message'))\n        .html(data.sites[nbcoreEnvironment].headline + ':');\n\n      jQuery('<div/>')\n        .addClass('nbcore-downtime__message-body')\n        .appendTo(jQuery('.nbcore-downtime__message'))\n        .html(data.sites[nbcoreEnvironment].message);\n      jQuery('.nbcore-downtime__container').addClass(\"nbcore-downtime__container--on\");\n    }\n    else {\n      jQuery('.nbcore-downtime__container').addClass(\"nbcore-downtime__container-off\");\n    }\n  }\n}\n\n// Downtime tool requires a function called process_downtime_message to exist.\nvar process_downtime_message = processDowntimeMessage;\n\n(function ($) {\n\n  /**\n   * Check NewsBank Downtime Message\n   *\n   */\n  function checkDowntimeMessage() {\n    var nbcoreDowntimeUrl = Drupal.settings.nbcore_downtime.url;\n\n    $.ajax({\n      type: 'GET',\n      url: nbcoreDowntimeUrl,\n      success: processDowntimeMessage,\n      dataType: 'jsonp'\n    });\n  }\n\n  // We'll use a variable to make sure behaviors only get attached once, instead\n  // of using .once() throughout the code below.\n  var behaviorsAttached = false;\n\n  Drupal.behaviors.nbcoreDowntimeCheckMessage = {\n    attach: function (context, settings) {\n      if (!behaviorsAttached) {\n        checkDowntimeMessage();\n        behaviorsAttached = true;\n      }\n    }\n  };\n\n})(jQuery);\n"
          },
