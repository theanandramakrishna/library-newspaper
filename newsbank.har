            "text": "if (typeof nbcore_prm_alerts == 'undefined') {\n  var nbcore_prm_alerts = (function($) {\n\n    var create_form_wrapper = Drupal.settings.nbcore_prm_alerts_global.alerts_form_create_wrapper;\n    if (Drupal.settings.nbcore_prm_alerts_form) {\n      var alert_form_visible = Drupal.settings.nbcore_prm_alerts_form.form_visible;\n      if (!alert_form_visible)\n        $('#' + create_form_wrapper).hide();\n\n      Drupal.behaviors.nbcore_example_cache = {\n        attach: function (context, settings) {\n          // Listen for set link click.\n          $('a#nbcore_prm_alerts__create_form_link', context).click(function() {\n            $('#' + create_form_wrapper).toggle();\n          });\n        }\n      };\n    }\n\n    /**\n     * Get alert data.\n     */\n    function getAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_get_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Create an alert.\n     */\n    function createAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_create_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Update one ore more alerts (use ||| delimeter for multiple).\n     */\n    function updateAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_update_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Unsubscribe to an alert.\n     */\n    function unsubscribeAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_unsubscribe_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Delete an alert.\n     */\n    function deleteAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_delete_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Resend one ore more alerts (use ||| delimeter for multiple).\n     * NOTE: Only data.alert_id will be recognized for this method.\n     */\n    function resendAlert(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_alerts_global.alerts_update_path;\n\n      // Make a very specific data packet for the update endpoint.\n      var theData = {\n        alert_id: data.alert_id,\n        last_run: 1\n      };\n\n      return fetch(url, theData, async);\n    }\n\n    /**\n     * Alias helper function from nbcore_prm to make the request and return a response.\n     */\n    var fetch = nbcore_prm.fetch;\n\n  return {\n    getAlert: getAlert,\n    createAlert: createAlert,\n    updateAlert: updateAlert,\n    unsubscribeAlert: unsubscribeAlert,\n    deleteAlert: deleteAlert,\n    resendAlert: resendAlert,\n    /* Alias functions (for backwards compatibility) */\n    get: getAlert,\n    create: createAlert,\n    update: updateAlert,\n    unsubscribe: unsubscribeAlert\n  };\n\n  })(jQuery);\n}\n"
