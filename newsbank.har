          "content": {
            "size": 18056,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Ajax loading of presearch map on advanced search page.\n */\n\n/* global NBCore */\n\n(function ($) {\n\n  'use strict';\n\n  Drupal.behaviors.moreSearchOptionsAnchorElement = {\n    attach: function (context, settings) {\n      $('a[name=\"more-search-options\"]').parent().replaceWith('<span name=\"more-search-options\"></span>');\n    }\n  };\n\n  Drupal.behaviors.suggestedTopicsAnchor = {\n    attach: function (context, settings) {\n      // Rewrite Suggested Topics links to add anchor link.\n      $('.advanced-form-footer-topics', context).each(function () {\n        $(this).attr('href', $(this).attr('href') + '#suggested-topics');\n      });\n    }\n  };\n\n  Drupal.behaviors.gnusAdvancedSearchSetInitialHideDuplicatesField = {\n    attach: function (context, settings) {\n      const { DEDUPED_VALUES } = settings['nbcore_search_hits_pane__gnus-search-hits-pane'];\n      // Get the form fields for duplicates and max results.\n      let $hideDuplicatesField = $('input[name=\"hide_duplicates\"]', context);\n      let $maxResultsField = $('input[name=\"maxresults\"]', context);\n\n      // Check if the fields exist on the page before processing.\n      if (!$hideDuplicatesField.length || !$maxResultsField.length || !context.URL || !window) return;      \n    \n      // Load the toggle value from url, local storage, or default to true, in that order.\n      const dedupedToggle = context.URL.includes(`hide_duplicates=${DEDUPED_VALUES.DEDUPES_ON}`) || \n        Boolean(window.localStorage.getItem('deduped_toggle') !== 'false');\n\n      // Set the initial values for the dedupe slider field.\n      $hideDuplicatesField.val(dedupedToggle ? DEDUPED_VALUES.DEDUPES_ON  : DEDUPED_VALUES.DEDUPES_OFF);\n      $maxResultsField.val(dedupedToggle ? DEDUPED_VALUES.DEDUPED_MAX : DEDUPED_VALUES.DEFAULT_MAX);\n    }\n  }\n\n  Drupal.behaviors.gnusAdvancedSearchPresearchMap = {\n    attach: function (context, settings) {\n      $('body.page-advanced-search .pane-gnus-advanced-search-form-adv-pane', context).once('gnusAdvancedSearchPresearchMap', function () {\n        // Do not attempt to process products without maps feature\n        if (typeof settings.nbcore_maps === 'undefined') return;       \n         \n        var documentPath = Drupal.settings.nbbase.drupalBasePath +\n          Drupal.settings.gnus_advanced_search.ajax_path;\n        var mapId = settings.gnus_advanced_search.map_id;\n        var listId = settings.gnus_advanced_search.list_id;\n        var mapSettings = settings.nbcore_maps.maps[mapId];\n        var reactSettings = settings['nbcore_react_browse__' + listId];\n        var uniqueIdx;\n        var labelIdx;\n        var map;\n        var linkable;\n        var $searchForm = $('#gnus-advanced-search-form-advanced-form', context);\n        var loadingText;\n        var cookieName = 'gnus_advanced_search_map';\n        var mapExists;\n\n        /**\n         * Helper function to synchronize states between map and list.\n         * @param selectedKeys\n         */\n        function syncMap(selectedKeys, source) {\n          var label;\n\n          map.R.forEach(function (el) {\n            var step = el.data('step');\n            if (step) {\n              // Override default mouseover.\n              el.node.onmouseover = function () {\n                // Only use hover state if map item is linkable to a new map.\n                if ($.inArray(step, linkable) !== -1) {\n                  map.changeState(el, 'hover');\n                }\n              };\n\n              // Override default mouseout\n              el.node.onmouseout = function () {\n                if ($.inArray(step, linkable) !== -1) {\n                  if (el.data('select-active') === false) {\n                    map.changeState(el, 'active');\n                  } else {\n                    map.changeState(el, 'selected');\n                  }\n                }\n              };\n\n              if (selectedKeys.indexOf(step) >= 0) {\n                el.data('select-active', true);\n                el.data('click-active', true);\n                if (source === 'list') {\n                  map.changeState(el, 'selected');\n                }\n              } else {\n                el.data('select-active', false);\n                el.data('click-active', false);\n                if (source === 'list') {\n                  map.changeState(el, 'active');\n                }\n              }\n            }\n          }, this);\n\n          // Update selected items list.\n          if (selectedKeys.length) {\n            label = selectedKeys.length + ' Location';\n            label += (selectedKeys.length > 1) ? 's' : '';\n            label += ' Selected';\n            $('.presearch-map__selected').html(label).show();\n          } else {\n            $('.presearch-map__selected').html('').hide();\n          }\n        }\n\n        /**\n         * Get height of the map svg and use it as max height for table body.\n         */\n        function resetMapHeight() {\n          var mapHeight = Math.round($('.nbcore-maps__presearch-map__map svg').height());\n          if (mapHeight > 0) {\n            $('#presearch-map__list-table > tbody').css({ 'max-height': mapHeight + 'px' });\n          } else {\n            $('#presearch-map__list-table > tbody').css({ 'max-height': 'unset' });\n          }\n        }\n\n        /**\n         * Get the map entities that can link to a more specific map.\n         * @param mapObj\n         * @return {Array}\n         */\n        function getLinkableMapItems(mapObj) {\n          var linkableArray = [];\n          var jsonFileList = settings.nbcore_maps.global.jsonFileList;\n\n          Object.keys(mapObj.navData).forEach(function (idx) {\n            var step;\n            var label;\n            var filename;\n\n            if (Object.prototype.hasOwnProperty.call(mapObj.navData, idx)) {\n              step = mapObj.navData[idx].step.split(':');\n              label = map.navData[idx].label.replace(/ |\\//g, '');\n              filename = step[0] + '-' + label + '.json';\n\n              if ($.inArray(filename, Object.keys(jsonFileList).map(function (file) {\n                return jsonFileList[file];\n              })) >= 0) {\n                linkableArray.push(map.navData[idx].step);\n              }\n            }\n          });\n\n          return linkableArray;\n        }\n\n        /**\n         * Initialization functionality for the map and list minipanel.\n         */\n        function initMap() {\n          map = Drupal.behaviors.nbcoreMaps.maps[mapId];\n          linkable = getLinkableMapItems(map);\n\n          if (settings.cssVariables) {\n            map.colors.activeFill = settings.cssVariables['--primary-98'];\n            map.colors.activeStroke = settings.cssVariables['--primary-90'];\n            map.colors.activeLabel = settings.cssVariables['--primary-60'];\n\n            map.colors.hoverFill = settings.cssVariables['--primary-90'];\n            map.colors.hoverStroke = settings.cssVariables['--primary-90'];\n            map.colors.hoverLabel = settings.cssVariables['--primary-60'];\n\n            map.colors.selectedFill = settings.cssVariables['--primary-50'];\n            map.colors.selectedStroke = settings.cssVariables['--primary-50'];\n            map.colors.selectedLabel = settings.cssVariables['--button-gradient-start'];\n          }\n\n          // Reset svg width and height to 100%.\n          map.R.setSize('100%', '100%');\n\n          // Run through initial sync so it sets up mouse over and out correctly.\n          syncMap([], 'list');\n\n          // Add class to map items that do not link to a new map.\n          map.R.forEach(function (el) {\n            var step = el.data('step');\n            if (step && $.inArray(step, linkable) === -1) {\n              el.node.setAttribute('class', 'presearch-map__map-item--nolink');\n            }\n          });\n\n          // Rewrite breadcrumb links to add anchor link.\n          $('.map_breadcrumbs__stepback', context).each(function () {\n            $(this).attr('href', $(this).attr('href') + '#map');\n          });\n\n          setTimeout(resetMapHeight, 200);\n        }\n\n        /**\n         * Helper function to get a single cookie value.\n         * @param cName\n         * @return {string}\n         */\n        function getCookie(cName) {\n          var name = cName + '=';\n          var cookie = document.cookie;\n          var ca = cookie.split(';');\n          var i;\n          var c;\n          for (i = 0; i < ca.length; i += 1) {\n            c = ca[i];\n            while (c.charAt(0) === ' ') {\n              c = c.substring(1);\n            }\n            if (c.indexOf(name) === 0) {\n              return c.substring(name.length, c.length);\n            }\n          }\n          return '';\n        }\n\n        // Start the procedural code that will run on page load.\n\n        mapExists = getCookie(cookieName);\n        loadingText = (!mapExists) ? 'Checking for Map' : 'Loading Map';\n\n        // If cookie already says there's no map, no point in proceeding.\n        if (mapExists === 'false') {\n          return;\n        }\n\n        $('body', context).addClass('map-loading');\n\n        // Add container around both list and map panes.\n        $('.pane-nbcore-maps-pane, .pane-nbcore-react-browse-table-pane', context)\n          .wrapAll($('<div/>', { class: 'presearch-map__container' }));\n\n        // Insert container for the selected items list.\n        $('.presearch-map__container', context)\n          .before($('<div/>', { class: 'presearch-map__selected' }));\n\n        // Create the container for the map list since it will not render on its own.\n        $('.pane-nbcore-maps-pane', context)\n          .before($('<div/>', { class: 'panel-pane pane-nbcore-react-browse-table-pane' })\n            .append($('<div/>', { id: listId, class: 'nbcore-react-browse-container' })));\n\n        // Set up loader animation.\n        $('.presearch-map__container', context)\n          .prepend($('<div/>', { class: 'loader__animation--presearch_map--container' }));\n        $('.loader__animation--presearch_map--container', context)\n          .append($('<div/>', { class: 'loader__animation loader__animation--presearch_map' }))\n          .append($('<div/>', { class: 'loader__animation--presearch_map--label', text: loadingText }));\n\n        // Main ajax call to retrieve navigator data.\n        $.ajax({\n          url: documentPath,\n          data: {\n            auth: settings.nbbase.authToken,\n            product: settings.nbbase.product,\n            query: settings.nbcore_maps.global.urlQuery,\n            haystack: settings.nbcore_maps.global.urlQuery.t,\n            pub_list_disabled: settings.gnus_shared.pub_list_disabled,\n          },\n          success: function (data) {\n\n            if (data.nomap) {\n              // If data returned indicates no map, set the cookie and fade out panel with message.\n              document.cookie = cookieName + '=false';\n              $('.loader__animation').remove();\n              $('.loader__animation--presearch_map--label').text('No maps found.');\n              setTimeout(function () {\n                $('.presearch-map__container').fadeOut(800);\n              }, 3000);\n              return;\n            }\n\n            document.cookie = cookieName + '=true';\n\n            $('body', context).removeClass('map-loading');\n\n            $('.loader__animation--presearch_map--container').remove();\n\n            $('.pane-advanced-search-presearch-map .pane__title').show();\n            $('#presearch-map__breadcrumbs').show();\n\n            mapSettings.mapData.mapId = data.map.mapId;\n            mapSettings.mapData.mapType = data.map.mapType;\n            mapSettings.navData = data.map.navData;\n\n            Drupal.behaviors.nbcoreMaps.maps[mapId] = new NBCore.Map(mapSettings);\n\n            initMap();\n\n            reactSettings.config = data.list.config;\n            reactSettings.cols = data.list.cols;\n            reactSettings.rows = data.list.rows;\n\n            uniqueIdx = reactSettings.config.multi.uniqueIndex;\n            labelIdx = reactSettings.config.multi.labelIndex;\n\n            // Render React list instance.\n            Drupal.behaviors.nbcoreReactBrowseLoad.renderInstance(listId);\n\n            // Make non-link text rows in React table act like label for preceding checkbox.\n            $('.presearch-map__primary-label--text').each(function () {\n              $(this).on('click', function () {\n                var checkbox = $(this).parent().prev().children('input');\n                checkbox.click();\n              });\n            });\n\n            // We landed here from the Map Search link.\n            if (window.location.hash == '#more-search-options') {\n              $('html, body').animate({\n                scrollTop: $('.advanced-search---inner').offset().top}, 500);\n            }\n\n            // Add zustat logging for link rows in React table.\n            $('.presearch-map__primary-label--link').each(function () {\n              $(this).on('click', function () {\n                // Log zustat when drilling down map.\n                try {\n                  nbbase.logZustat({\n                    product: settings.nbbase.product,\n                    auth: settings.nbbase.authToken,\n                    zustat_category: 'co_sc_navigator_presearch'\n                  }, false);\n                } catch (ex) {\n                  console.error(ex);\n                }\n              });\n            });\n\n            /**\n             * Event listener for map click\n             */\n            $(document).on('nbcore_maps.click', function (e, mapItem) {\n              var url = settings.nbbase.drupalBasePath + settings.nbcore_maps.global.clickPath;\n              var step;\n              var matches;\n              var match;\n              var selectedKeys;\n\n              // Setting this to true will override the default behavior.\n              mapItem.data('event-override', true);\n\n              step = mapItem.data('step');\n\n              if ($.inArray(step, linkable) !== -1) {\n                $.ajax({\n                  url: url,\n                  data: {\n                    haystack: step,\n                    url_query: settings.nbcore_maps.global.urlQuery\n                  },\n                  success: function (response) {\n                    var redirect = settings.nbbase.drupalBasePath + settings.gnus_advanced_search.search_path + '?' + response.query + '#map';\n\n                    // Log zustat when drilling down map.\n                    try {\n                      nbbase.logZustat({\n                        product: settings.nbbase.product,\n                        auth: settings.nbbase.authToken,\n                        zustat_category: 'co_sc_navigator_presearch'\n                      }, false);\n                    } catch (ex) {\n                      console.error(ex);\n                    }\n\n                    window.location.href = redirect;\n                  }\n                });\n              } else {\n                matches = reactSettings.rows.filter(function (row) {\n                  return row[uniqueIdx] === step;\n                });\n                match = matches[0];\n                if (mapItem.data('click-active')) {\n                  reactSettings.config.multi.selectedRows[match[uniqueIdx]] = match[labelIdx];\n                  map.changeState(mapItem, 'selected');\n                } else {\n                  delete reactSettings.config.multi.selectedRows[match[uniqueIdx]];\n                  map.changeState(mapItem, 'active');\n                }\n                selectedKeys = Object.keys(reactSettings.config.multi.selectedRows);\n                Drupal.behaviors.nbcoreReactBrowseLoad.renderInstance(listId);\n            