          "content": {
            "size": 8551,
            "mimeType": "application/javascript",
            "text": "(function($) {\n\n  function Dopringle(context, settings, options) {\n    this.context = context || null;\n    this.settings = settings || null;\n    this.options = {\n      action: 'print',\n      docType: 'ascii',\n      modalTarget: $('.modal-document-citation', context),\n      modalTitle: null,\n      callbackStart: null,\n      callbackEnd: null,\n      instanceId: null,\n      citationModal: true\n    };\n    $.extend(this.options, options);\n\n    this.metadata = {};\n    this.citationMarkup = '';\n    this.defaultLabels = {\n      print: { title: 'Print Document', button: 'Print' },\n      download: { title: 'Download PDF', button: 'Download' },\n      googledrive: { title: 'Save to Google Drive', button: 'Save' },\n    };\n  }\n\n  Dopringle.prototype.start = function() {\n    var self = this;\n\n    if (self.options.citationModal) {\n      Drupal.gnusFunctions.gnusModalGenerate(self.options.modalTarget, $(this), {\n        origin: 'gnusModal'\n      });\n      self.setModalLabels();\n      self.getMetadata();\n      self.initEventListeners();\n      self.populatePrintCiteSelect();\n    }\n    else {\n      if (self.options.docType === 'metadoc') {\n        Drupal.settings.nbcore_pdf[self.options.instanceId].template_params.printrecord = 'true';\n        self.processDocument();\n        delete Drupal.settings.nbcore_pdf[self.options.instanceId].template_params.printrecord;\n      } else {\n        self.processDocument();\n      }\n    }\n  };\n\n  Dopringle.prototype.setModalLabels = function() {\n    var self = this;\n    var title = (self.options.modalTitle || (self.defaultLabels[self.options.action] && self.defaultLabels[self.options.action].title)) || 'Add Citation';\n    var button = (self.defaultLabels[self.options.action] && self.defaultLabels[self.options.action].button) || 'Submit';\n    $('.modal-document-citation .modal-title', self.context).text(title);\n    $('.modal-document-citation__submit', self.context).text(button);\n  };\n\n  Dopringle.prototype.getMetadata = function() {\n    var self = this;\n    if (self.options.docType === 'ascii') {\n      var $docMeta = $('#document-view--ascii');\n      this.metadata.docref = $docMeta.data('docref') || null;\n      this.metadata.pbi = $docMeta.data('pbi') || null;\n    }\n    if (self.options.docType === 'hadoc') {\n      var $docMeta = $('#actions-bar-info');\n      this.metadata.docref = $docMeta.data('docref') || null;\n      this.metadata.pbi = $docMeta.data('pbi') || null;\n    }\n  };\n\n  Dopringle.prototype.initEventListeners = function() {\n    var self = this;\n    // If exist, remove any existing event listeners (if the citation modal was opened multiple times).\n    $('.multidocs__cite--checkbox', self.context).off('change.gnusSingleDocCitation');\n    $('.modal-document-citation__submit', self.context).off('click.gnusSingleDocCitation');\n\n    // Event listener to enable/disable citation dropdown.\n    $('.multidocs__cite--checkbox', self.context).on('change.gnusSingleDocCitation', this.toggleCiteDropdown.bind(this));\n\n    // Event listener to citation when clicking the print/download/save button.\n    $('.modal-document-citation__submit', self.context).on('click.gnusSingleDocCitation', function() {\n      self.processCitationModalDocument();\n    });\n  };\n\n  Dopringle.prototype.toggleCiteDropdown = function(e) {\n    var self = this;\n    if (e.target.checked === true) {\n      $('.multidocs__cite--select', self.context).removeAttr('disabled');\n    }\n    else {\n      $('.multidocs__cite--select', self.context).attr('disabled', 'disabled');\n    }\n  };\n\n  Dopringle.prototype.populatePrintCiteSelect = function() {\n    var self = this;\n    var $citationContainer = $('.citations-copy', self.context); // This is the container of the citation element that exists in the citations pane.\n    var $printCitationDropdown = $('.modal-content__citation .multidocs__cite--select', self.context); // Select list that will show list of citations to include when printing.\n    var citationTypes = ['AGLC', 'APA', 'ASA', 'CMS', 'Harvard', 'MLA', 'Turabian'];\n\n    // Loop through citations within citations pane. Create an <option> in the citation dropdown for each.\n    for (var i = 0; i < citationTypes.length; i++) {\n      var citationType = citationTypes[i];\n      var $citationCiteElement = $('.' + citationType.toLowerCase() + ' > a', $citationContainer);\n\n      if ($citationCiteElement.length && !$printCitationDropdown.hasClass('js-citations-processed')) {\n        var citationValue = $citationCiteElement.data('clipboard-text');\n        $printCitationDropdown.append('<option data-citation-type=\"' + citationType + '\" data-citation-text=\"' + encodeURI(citationValue) + '\" value=\"' + citationType + '\">' + citationType + '</option>');\n      }\n    }\n\n    // If citations exist, add a CSS class. Else, tell the user that they're not available.\n    if ($('option', $printCitationDropdown).length) {\n      $printCitationDropdown.addClass('js-citations-processed');\n    }\n    else {\n      $printCitationDropdown.append('<option>No citation available.</option>');\n      $('.multidocs__cite--checkbox', self.context).attr('disabled', 'disabled');\n    }\n  };\n\n  Dopringle.prototype.createCitationMarkup = function() {\n    var self = this;\n    if ($('.multidocs__cite--checkbox:checked', self.context).length) {\n      var citationTypeOption = $('.modal-content__citation .multidocs__cite--select', self.context).find(\":selected\")[0];\n      var citationType = citationTypeOption.dataset.citationType;\n      var citationText = decodeURI(citationTypeOption.dataset.citationText);\n      return '<div class=\"document-view__citations document-view__citations--doc-view\">' +\n              '<ul>' +\n              '<li class=\"document-view__citation-item--' + citationType + '\">' +\n              '<span class=\"document-view__citation-type\" > Citation (' + citationType + ' Style)</span>' +\n              '<div class=\"document-view__citation-data\">' + citationText + '</div>' +\n              '</li>' +\n              '</ul>' +\n              '</div>';\n    }\n    return false;\n  };\n\n  Dopringle.prototype.processCitationModalDocument = function() {\n    var self = this;\n    var citationMarkup = self.createCitationMarkup();\n\n    // HA Doc print/download/googledrive or ascii download/googledrive.\n    if (self.options.docType === 'hadoc' || self.options.action === 'download' || self.options.action === 'googledrive' || self.options.docType === 'asciidoc' || self.options.docType === 'metadoc') {\n      if (Drupal.settings.nbcore_pdf[self.options.instanceId]) {\n        Drupal.gnusFunctions.gnusModalClose();\n        if (typeof self.options.callbackStart === 'function') {\n          self.options.callbackStart();\n        }\n        Drupal.settings.nbcore_pdf[self.options.instanceId].template_params.citation = citationMarkup;\n        var pdf = new NBPDF(self.options.instanceId, self.options.action);\n        // HA Doc PDF options.\n        var pdfOptions = (self.options.docType === 'hadoc') ? {\n          image: { widthOffset: 50, heightOffset: 175 , maxWidth: 900 },\n          page: { orientation: 'portrait', size: 'letter' }\n        } : {};\n        pdf.start(pdfOptions, function(success) {\n          delete Drupal.settings.nbcore_pdf[self.options.instanceId].template_params.citation;\n          if (typeof self.options.callbackEnd === 'function') {\n            self.options.callbackEnd(success);\n          }\n        });\n      }\n    }\n  };\n\n  Dopringle.prototype.processDocument = function() {\n    var self = this;\n\n    // HA Doc print/download/googledrive or ascii download/googledrive.\n    if (self.options.docType === 'hadoc' || self.options.action === 'download' || self.options.action === 'googledrive' || self.options.docType === 'asciidoc' || self.options.docType === 'metadoc') {\n      if (Drupal.settings.nbcore_pdf[self.options.instanceId]) {\n        if (typeof self.options.callbackStart == 'function') {\n          self.options.callbackStart();\n        }\n        var pdf = new NBPDF(self.options.instanceId, self.options.action);\n        // HA Doc PDF options.\n        var pdfOptions = (self.options.docType === 'hadoc') ? {\n            image: { widthOffset: 50, heightOffset: 175 , maxWidth: 900 },\n            page: { orientation: 'portrait', size: 'letter' }\n          } : {};\n        pdf.start(pdfOptions, function(success) {\n          if (typeof self.options.callbackEnd === 'function') {\n            self.options.callbackEnd(success);\n          }\n        });\n      }\n    }\n  };\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.Dopringle = Dopringle;\n\n})(jQuery);\n"
          },
