          "content": {
            "size": 1326,
            "mimeType": "application/javascript",
            "text": "(function ($) {\n\n  Drupal.behaviors.nbcoreZustatLogLinks = {\n    attach: function(context, settings) {\n      $('a.'+settings.nbcore_zustatlog_global.class_zustat_link, context).click(function() {\n        var instanceid = $(this).data('instanceid');\n        var zustatcat = (settings.nbcore_zustatlog[instanceid].zustatCategoryOverride) ?\n          settings.nbcore_zustatlog[instanceid].zustatCategoryOverride : null;\n\n        if (zustatcat) {\n          // External link handler\n          if ($(this).hasClass(settings.nbcore_zustatlog_global.class_external_link)) {\n            // Mandatory external link values.\n            var data = {\n              'product': settings.nbbase.product,\n              'zustat_category': zustatcat,\n            };\n            // Optional zustat data values.\n            $.each($(this).data(), function(index, value) {\n              data[index] = value;\n            });\n            // Set async argument to false to capture a response (if needed).\n            var async = !$(this).hasClass(\"download\")\n            var response = nbbase.logZustat(data, async);\n            if (response) { $(this).addClass(\"logged\"); }\n          }\n          // Normal link handler.\n          else\n            nbbase.addZustatOverride($(this).attr('href'), zustatcat);\n        }\n      });\n    }\n  };\n\n})(jQuery);\n"
