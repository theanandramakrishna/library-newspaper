            "text": "/**\r\n * @file\r\n * JavaScript file for nbcore_google module.\r\n */\r\n\r\n/**\r\n * Class to represent the NB Google Auth object.\r\n * Manage: https://console.developers.google.com/apis/dashboard\r\n * See:\r\n *  - https://developers.google.com/api-client-library/javascript/\r\n *  - https://developers.google.com/api-client-library/javascript/samples/samples\r\n *  - https://developers.google.com/api-client-library/javascript/features/authentication\r\n *  - https://developers.google.com/api-client-library/javascript/features/promises\r\n */\r\nvar NBGoogleAuth = function() {\r\n  // Globally accessible credentials state.\r\n  var credentials = {\r\n    isSignedIn: false,\r\n    profile: {}\r\n  };\r\n\r\n  /**\r\n   * Initializes the authentication.\r\n   *\r\n   * @param {function} callback\r\n   *   A function to callback for init notifications.\r\n   */\r\n  function init(callback) {\r\n    // Allow time for DOM to complete.\r\n    setTimeout(function() {\r\n      var url = Drupal.settings.nbcore_google.endpoints.status;\r\n      NBGoogleRequest.httpRequest({url: url}).then(function(response) {\r\n        updateCredentials(response.result, callback);\r\n      }, function(error) {\r\n        console.warn(\"Google Initialization Failed!\", error);\r\n        updateCredentials(error, callback);\r\n      });\r\n    }, 50);\r\n  }\r\n\r\n   /**\r\n   * Initializes the authentication.\r\n   *\r\n   * @param {object} response\r\n   *   The google status response result.\r\n   * @param {function} callback\r\n   *   A function to callback for init notifications.\r\n   */\r\n  function updateCredentials(response, callback) {\r\n    // Always reset the localStorage flag.\r\n    localStorage.removeItem(Drupal.settings.nbcore_google.google_auth_complete);\r\n    // Update the credentials if we have a response result.\r\n    if (response && !response.error) {\r\n      credentials.isSignedIn = response.isSignedIn;\r\n      if (response.profile) {\r\n        credentials.profile = response.profile;\r\n      };\r\n    } else {\r\n      credentials = {\r\n        isSignedIn: false,\r\n        profile: {}\r\n      };\r\n    }\r\n    callback(response);\r\n  }\r\n\r\n  /**\r\n   * Handles the oauth2 signIn from google.\r\n   * See: https://developers.google.com/identity/sign-in/web/reference#googleauthsignin.\r\n   * NOTE: There is a known limitation with IE/Edge browsers.  Closing the window\r\n   *       Can not be captured correctly because of redirects in the opened window.\r\n   *\r\n   * @param {function} callback\r\n   *   A function to callback for siginin notifications.\r\n   */\r\n  function signIn(callback) {\r\n    var google_auth_complete = Drupal.settings.nbcore_google.google_auth_complete;\r\n    // Always reset google auth status.\r\n    localStorage.removeItem(google_auth_complete);\r\n    if (!window.location.origin) {\r\n      window.location.origin =\r\n        window.location.protocol + '//' + window.location.hostname +\r\n        (window.location.port ? ':' + window.location.port: '');\r\n    }\r\n    var loginParams = {\r\n      origin: window.location.origin\r\n    };\r\n    var loginURL = Drupal.settings.nbcore_google.endpoints.login + '?' + $.param(loginParams);\r\n    var googleAuthWindow = window.open(\r\n      loginURL,\r\n      'googleTarget',\r\n      'toolbar=no, location=no, status=no, menubar=no, scrollbars=no, resizable=yes, ' +\r\n      'width=500, height=600, dialog=yes'\r\n    );\r\n\r\n    var isIE = /MSIE|Trident\\/|Edge\\//.test(window.navigator.userAgent);\r\n    var start = Date.now();\r\n    var timeoutThreshold = 180; // In seconds.\r\n\r\n    var checkStatus = function() {\r\n      // If we haven't received the notifcation that auth is complete.\r\n      var auth_complete_status = localStorage.getItem(google_auth_complete);\r\n      if (auth_complete_status) {\r\n        var status = JSON.parse(auth_complete_status);\r\n        updateCredentials(status.result, callback);\r\n      } else {\r\n        var elapsed = (Date.now() - start) / 1000;\r\n        // Handle certain scenarios.\r\n        if (!isIE && googleAuthWindow.closed) {\r\n          return updateCredentials({error: {message: 'popup_closed_by_user'}}, callback);\r\n        } else if (elapsed > timeoutThreshold) {\r\n          if (confirm(Drupal.t(\"Time limit has been reached. Do you want to close the Google signin window?\"))) {\r\n            googleAuthWindow.close();\r\n            return updateCredentials({error: {message: 'timeout_reached'}}, callback);\r\n          } else {\r\n            start = new Date();\r\n            return checkStatus();\r\n          }\r\n        } else {\r\n          return setTimeout(function() { checkStatus(); }, 500);\r\n        }\r\n      }\r\n    };\r\n    // Begin checking the status of authentication process and opened window.\r\n    setTimeout(function() { checkStatus(); }, 1000);\r\n  }\r\n\r\n  /**\r\n   * Handles the oauth2 signOut.\r\n   *\r\n   * @param {function} callback\r\n   *   A function to callback for signout notifications.\r\n   */\r\n  function signOut(callback) {\r\n    var url = Drupal.settings.nbcore_google.endpoints.logout;\r\n    NBGoogleRequest.httpRequest({url: url}).then(function(response) {\r\n      updateCredentials(response.result, callback);\r\n    }, function(error) {\r\n      console.warn(\"Failed signout!\", error);\r\n      updateCredentials(error, callback);\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Helper function to get current authentication state.\r\n   *\r\n   * @return {boolean}\r\n   *   Will return true if a user is signed in.\r\n   */\r\n  function isSignedIn() {\r\n    return credentials.isSignedIn;\r\n  }\r\n\r\n  /**\r\n   * Get the current query profile as a simple object of properties.\r\n   * see: https://developers.google.com/identity/sign-in/web/reference#googleusergetbasicprofile\r\n   *\r\n   * @return {Object}\r\n   *   The profile information {id, name, email, image} for the current user.\r\n   */\r\n  function userProfile() {\r\n    return credentials.profile;\r\n  }\r\n\r\n  // Revealed public methods and properties for this module instance.\r\n  return {\r\n    init: init,\r\n    signIn: signIn,\r\n    signOut: signOut,\r\n    userProfile: userProfile,\r\n    isSignedIn: isSignedIn\r\n  };\r\n\r\n};\r\n"
          },
