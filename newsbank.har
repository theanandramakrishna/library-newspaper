          "content": {
            "size": 1024,
            "mimeType": "application/javascript",
            "text": "/**\n * Change Databases dropdown menu\n */\n\n/* globals Drupal, jQuery */\n\n(function($) {\n\n  'use strict';\n\n  Drupal.behaviors.gnus_menu_change_db = {\n    attach: function (context, settings) {\n\n      $('#nbcore-products-pane-change-databases-mobile', context)\n        .not('.nbcore-products-single-link')\n        .before('<button type=\"button\" class=\"changeDbToggle\">Change Databases</button>');\n\n      $('body', context).append('<div class=\"js-modal-changeDbToggle\"></div>');\n\n      var $toggleButton = $('.changeDbToggle', context),\n        $body = $('body', context);\n\n      $toggleButton.click(function() {\n        if ($body.hasClass('js-changeDbToggle-open')) {\n          $body.removeClass('js-changeDbToggle-open');\n        }\n        else {\n          $body.addClass('js-changeDbToggle-open');\n        }\n      });\n\n      // Close the Nav if the user clicks on the body\n      $('.js-modal-changeDbToggle', context).click(function() {\n        $body.removeClass('js-changeDbToggle-open');\n      });\n    }\n  };\n\n})(jQuery);\n"
