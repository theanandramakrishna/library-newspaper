            "size": 5564,
            "mimeType": "application/javascript",
            "text": "/**\n * @file\n * Gnus Branding JS.\n */\n\n(function ($) {\n\n  // Add child count class to header first div.\n  Drupal.behaviors.gnusBrandingHeaderItemCount = {\n    attach: function (context, settings) {\n      var headerHeader = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionHeader || []).header || [];\n      var headerDonors = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionHeader || []).donors || [];\n\n      // If there's no data, remove the placeholder, so we can count the child elements.\n      if (headerHeader.length == 0 && headerDonors.length == 0) {\n        $('.pane-gnus-branding-pane').remove();\n      }\n\n      var $headerFirst = $('.layout__header-first').first();\n      var children = $headerFirst.children().length;\n      var className = children == 1 ? 'layout__header-first--' + children + '-child' : 'layout__header-first--' + children + '-children';\n      $headerFirst.addClass(className);\n    }\n  };\n\n  // Branding dropdown.\n  Drupal.behaviors.gnusBrandingDropdown = {\n    attach: function (context, settings) {\n      var $gnusBrandingDonorHeader = $('.nbcore-branding-donor__header');\n      var mouseOutTimer = null;\n\n      // Move donor list.\n      $('.nbcore-branding-donor__header-donors').appendTo('.nbcore-branding-donor__header-info-content');\n\n      // Wrap all text list elements.\n      $('.nbcore-branding-donor__donor-simple').each(function() {\n        if ($(this).find('a').length === 0) {\n          $(this).html('<span class=\"nbcore-branding-donor__donor-simple-text\">' + $(this).text() + '</span>');\n        }\n      });\n\n      // Set initial aria-expanded.\n      $('.nbcore-branding-donor__header-info-trigger').once('header-info-trigger', function() {\n        $(this).attr('aria-expanded', false);\n      });\n\n      // Click.\n      $(document).on('click', '.nbcore-branding-donor__header-info-trigger', function(e) {\n        e.preventDefault();\n        if ($(this).attr('aria-expanded') == 'false') {\n          openGnusBrandingDropdown();\n        }\n        else {\n          closeGnusBrandingDropdown();\n        }\n      });\n\n      // Button & dropdown mouseover.\n      $(document).on('mouseover', '.nbcore-branding-donor__header-info-trigger, .nbcore-branding-donor__header-donors', function(e) {\n        e.preventDefault();\n        clearTimeout(mouseOutTimer);\n        openGnusBrandingDropdown();\n      });\n\n      // Button & dropdown mouseout.\n      $(document).on('mouseout', '.nbcore-branding-donor__header-info-trigger, .nbcore-branding-donor__header-donors', function(e) {\n        e.preventDefault();\n        mouseOutTimer = setTimeout(function() {\n          closeGnusBrandingDropdown();\n        }, 300);\n      });\n\n      // Open dropdown.\n      function openGnusBrandingDropdown() {\n        $gnusBrandingDonorHeader\n          .addClass('js-donors-list-expanded')\n          .find('.nbcore-branding-donor__header-info-trigger')\n          .attr('aria-expanded', true);\n        clearTimeout(mouseOutTimer);\n      }\n\n      // Close dropdown.\n      function closeGnusBrandingDropdown() {\n        $gnusBrandingDonorHeader\n          .removeClass('js-donors-list-expanded')\n          .find('.nbcore-branding-donor__header-info-trigger')\n          .attr('aria-expanded', false);\n      }\n    }\n  };\n\n  // Branding modal for Browse Pub.\n  Drupal.behaviors.gnusBrandingModalBrowsePub = {\n    attach: function (context, settings) {\n      // From: https://stackoverflow.com/a/4034468/477949\n      var contextHeader = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionContextSpecific || []).header || [];\n      var contextDonors = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionContextSpecific || []).donors || [];\n      var contextFooter = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionContextSpecific || []).footer || [];\n      var $browsePubMeta = $('.browsepub_meta');\n\n      if (contextHeader.length || contextDonors.length || contextFooter.length) {\n        // Show donor tagline and button.\n        $browsePubMeta.find('.gnus-branding__modal-line').addClass('gnus-branding__modal-line--show');\n        // Show donor intro line.\n        if (contextHeader.length && contextDonors.length) {\n          $browsePubMeta.find('.gnus-branding__donor-intro').addClass('gnus-branding__donor-intro--show');\n        }\n        // Init modal.\n        $('.gnus-branding__modal-button', context).gnusModal($('.modal--donors', context), function() {});\n      }\n    }\n  };\n\n  // Branding line: single line or modal for multiple donors.\n  Drupal.behaviors.gnusBrandingLine = {\n    attach: function (context, settings) {\n      // From: https://stackoverflow.com/a/4034468/477949\n      var contextDonors = ((((settings || []).nbcore_branding || []).donor_branding || []).sectionContextSpecific || []).donors || [];\n\n      if (contextDonors.length) {\n        if (contextDonors.length === 1) {\n          // Show donor tagline and value.\n          $('.gnus-branding__line', context).addClass('gnus-branding__line--show');\n        }\n        else {\n          var $lineModal = $('.gnus-branding__line-modal', context);\n          $lineModal.addClass('gnus-branding__line-modal--show');\n          $lineModal.find('.gnus-branding__modal-line').addClass('gnus-branding__modal-line--show');\n          $lineModal.find('.gnus-branding__modal-button').gnusModal($('.modal--donors', context), function() {});\n          $lineModal.find('.gnus-branding__donor-intro').addClass('gnus-branding__donor-intro--show');\n        }\n      }\n    }\n  };\n}(jQuery));\n"
          },
