            "mimeType": "application/javascript",
            "text": "if (typeof nbcore_prm_articles == 'undefined') {\n  var nbcore_prm_articles = (function($) {\n\n    /**\n     * Create a saved article.\n     */\n    function createArticle(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n        Drupal.settings.nbcore_prm_articles_global.articles_create_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Get saved article data.\n     */\n    function getArticle(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_articles_global.articles_get_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Update a saved article.\n     */\n    function updateArticle(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_articles_global.articles_update_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Delete saved article.\n     */\n    function deleteArticle(data, async) {\n      var url = Drupal.settings.nbbase.drupalBasePath +\n                Drupal.settings.nbcore_prm_articles_global.articles_delete_path;\n\n      return fetch(url, data, async);\n    }\n\n    /**\n     * Alias helper function from nbcore_prm to make the request and return a response.\n     */\n    var fetch = nbcore_prm.fetch;\n\n    /**\n     * Reduces an array of saved articles to an Object that maps docrefs to saved articles.\n     *\n     * @param {Object} savedArticles\n     */\n    function indexPrmSavedArticles(savedArticles) {\n      var returnVal;\n\n      try {\n        if (!$.isArray(savedArticles)) {\n          savedArticles = [savedArticles];\n        }\n\n        var savedArticlesIndex = savedArticles.reduce(function (indexObj, cur) {\n          indexObj[cur.docref] = cur;\n\n          return indexObj;\n        }, {});\n\n        returnVal = savedArticlesIndex;\n      } catch (ex) {\n        returnVal = {};\n      }\n\n      return returnVal;\n    }\n\n    /**\n     * Gets a set of PRM saved articles.\n     *\n     * @param {Object} props\n     *   Properties to pass to the getArticle call.\n     */\n    function getIndexedArticles() {\n      var resp = null;\n      var props = arguments.length > 0 && arguments[0] !== undefined ? arguments[0] : {};\n      var articles = getArticle(props, false);\n\n      if (articles.response.data !== null &&\n      !Object.prototype.hasOwnProperty.call(articles.response, 'error')) {\n        resp = indexPrmSavedArticles(articles.response.data.saved_article);\n      }\n\n      return resp;\n    }\n\n    return {\n      createArticle: createArticle,\n      getArticle: getArticle,\n      getIndexedArticles: getIndexedArticles,\n      updateArticle: updateArticle,\n      deleteArticle: deleteArticle\n    };\n\n  })(jQuery);\n}\n"
