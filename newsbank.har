            "mimeType": "application/javascript",
            "text": "/******/ (function() { // webpackBootstrap\n/*!***********************************************!*\\\n  !*** ./js/modules/drupal_behaviors_clever.js ***!\n  \\***********************************************/\n/*! unknown exports (runtime-defined) */\n/*! runtime requirements:  */\n(function ($) {\n\n  function getDisplayName() {\n    const cookieValue = $.cookie('lti_ci');\n\n    if (cookieValue) {\n      const parts = cookieValue.split('.');\n      const decoded_a = atob(parts[0]);\n      const decoded_b = atob(parts[1]);\n\n      return decoded_b.replace(decoded_a, '');\n    }\n\n    return '';\n  }\n\n  Drupal.behaviors.addCleverPortalLink = {\n    attach: function (context, settings) {\n      const windowRef = window;\n\n      $('body', context).once('hasCleverBanner', function () {\n        try {\n          const ltiIsClever = $.cookie('lti_is_clever');\n          const displayName = getDisplayName();\n\n          const logout =\n            'To log out, go to the <a class=\"clever-portal-link\" target=\"_blank\" href=\"https://clever.com/login\" title=\"Clever portal link\">Clever Portal</a>.';\n\n          const content = displayName !== ''\n            ? '&starf; You are logged in to Clever as <strong>' + getDisplayName() + '</strong>. ' + logout\n            : '&starf; You are logged in to Clever. ' + logout;\n\n          if (ltiIsClever === 'yes') {\n            $('body').addClass('is-clever');\n            $('.page').prepend('<div class=\"nbcore-clever-portal-link\">' + content + '</div>');\n          } else {\n            $('body').addClass('not-clever');\n          }\n\n          $('.clever-portal-link').click(function handleCleverLogout () {\n            setTimeout(function () {\n              windowRef.close();\n            }, 250);\n          });\n        } catch (err) {\n          console.log(err.message);\n        }\n      });\n    }\n  };\n\n})(jQuery);\n\n/******/ })()\n;\n//# sourceMappingURL=nbcore_lti.behaviors-clever.js.map