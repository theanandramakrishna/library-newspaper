          "content": {
            "size": 17830,
            "mimeType": "application/javascript",
            "text": "(function($) {\n  'use strict';\n\n  /*\n   * PRM Authentication utility\n   */\n  Drupal.behaviors.prmGenerateInfo = {\n    attach: function (context, settings) {\n\n      // @todo This gets called very often, frequently several times in a row.\n      //       Create a debouncer to limit how often this can be called within a certain time period.\n      //       Should this be in a Drupal behavior?\n      function prmGenerateInfo() {\n        var prminfo = nbcore_prm.getInfo(null, false);\n        Drupal.settings.gnus_prm = Drupal.settings.gnus_prm || {};\n        Drupal.settings.gnus_prm.isAnonymous = (prminfo && prminfo.response.data.hasOwnProperty('anon_id'));\n        Drupal.settings.gnus_prm.prmLoginForm = 'ajax/prm-login';\n        Drupal.settings.gnus_prm.prmRegistrationForm = 'ajax/prm-register';\n        Drupal.settings.gnus_prm.prmLogoutForm = 'ajax/prm-logout';\n        Drupal.settings.gnus_prm.prmAccountEditForm = 'ajax/prm-account';\n\n        if (Drupal.settings.gnus_prm.isAnonymous) {\n          $('body').removeClass('is-authenticated-prm');\n          Drupal.settings.gnus_prm.username = null;\n          Drupal.settings.gnus_prm.firstname = null;\n          Drupal.settings.gnus_prm.lastname = null;\n          Drupal.settings.gnus_prm.email = null;\n        }\n        else {\n          $('body').addClass('is-authenticated-prm');\n          Drupal.settings.gnus_prm.username = prminfo.response.data.username || null;\n          Drupal.settings.gnus_prm.firstname = prminfo.response.data.firstname || null;\n          Drupal.settings.gnus_prm.lastname = prminfo.response.data.lastname || null;\n          Drupal.settings.gnus_prm.email = prminfo.response.data.email || null;\n        }\n\n        // Trigger event to indicate that info has been updated.\n        // @TODO I found that this triggers to soon, before a few instances of\n        // $(document).on('gnus_prminfo_update', function() {}); are instantiated.\n        $(document).trigger('gnus_prm.info_update');\n      }\n\n      Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n      Drupal.gnusFunctions.gnus_prm_prmGenerateInfo = prmGenerateInfo;\n      Drupal.gnusFunctions.gnus_prm_prmGenerateInfo(); // Run once to do initial population.\n    }\n  };\n\n  /*\n   * Generate PRM Login Modal.\n   * @param {requestCallback} callbackSuccess - runs after the login is successful.\n   * @param {requestCallback} callbackFail - runs after the login fails (username, password error, etc).\n   */\n  function gnusPrmLogin(callbackSuccess, callbackFail) {\n\n    var prmLoginFormPath = Drupal.settings.nbbase.drupalBasePath +\n      Drupal.settings.gnus_prm.prmLoginForm;\n\n    // Get HTML and call function to generate modal and event handlers.\n    $.get(prmLoginFormPath, function (data) {\n      var $prmLoginFormFragment = $(data).find('.modal-general');\n\n      // Generate modal\n      Drupal.gnusFunctions.gnusModalGenerate($prmLoginFormFragment);\n\n      // Event handler for submitting the form.\n      $('form.prm-login__form').on('submit', errorCheck);\n\n      // Event handler for PRM registration link.\n      $('.prm_register-button').on('click', Drupal.gnusFunctions.gnusPrmRegister);\n    });\n\n    // Check that the username/password fields contain data. Show error if not.\n    function errorCheck(e) {\n      e.preventDefault();\n\n      var $messagesContainer = $('.prm-messages');\n      var data = {\n        'username': $('.modal--prm-login .field-username input').val().trim(),\n        'password': $('.modal--prm-login .field-password input').val().trim()\n      };\n\n      // Remove any previous messages.\n      $('> *', $messagesContainer).remove();\n\n      // If username field is empty, display error.\n      if (!data.username.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the username or email field is filled in.', 'error', ['prm-message prm-message__error']);\n      }\n\n      // If password field is empty display error.\n      if (!data.password.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the password field is filled in.', 'error', ['prm-message prm-message__error']);\n      }\n\n      // If exists, pass data to login function.\n      if (data.username.length && data.password.length) {\n        var response = nbcore_prm.login(data, false);\n        processPrmLogin(response.response);\n      }\n    }\n\n    // Shows/hides error messages, displays alert form.\n    function processPrmLogin(response) {\n      var successful = (response && response.data.account !== undefined);\n      var $messagesContainer = $('.prm-messages');\n      var msgLoginFail = 'Login Failed. Having trouble signing in? Please contact customer service.';\n\n      $('> *', $messagesContainer).remove();\n\n      if (successful) {\n        // Remove the login modal.\n        Drupal.gnusFunctions.gnusModalClose();\n\n        // Update PRM information settings.\n        Drupal.gnusFunctions.gnus_prm_prmGenerateInfo();\n\n        // Trigger login success event\n        $(document).trigger('gnus_prm.login_success');\n\n        // Execute success callback function if exists.\n        if (typeof callbackSuccess == 'function') {\n          callbackSuccess();\n        }\n\n        // Reload the page if on PRM Pages to reload the React Browse tables.\n        if (window.location.pathname == Drupal.settings.nbbase.drupalBasePath + 'my-folder') {\n          location.reload();\n        }\n      }\n      else {\n        $messagesContainer.gnusSetMessage(msgLoginFail, 'error', ['prm-message prm-message__login--fail']);\n\n        // Trigger login fail event\n        $(document).trigger('gnus_prm.login_fail');\n\n        // Execute failure callback function if exists.\n        if (typeof callbackFail == 'function') {\n          callbackFail();\n        }\n      }\n    }\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.gnus_prm_gnusPrmLogin = gnusPrmLogin;\n\n  /*\n   * Generate PRM Registration Modal.\n   * @param {requestCallback} callbackSuccess - runs after the login is successful.\n   * @param {requestCallback} callbackFail - runs after the login fails (username, password error, etc).\n   */\n  function gnusPrmRegister(callbackSuccess, callbackFail) {\n    var prmRegistrationFormPath =  Drupal.settings.nbbase.drupalBasePath +\n      Drupal.settings.gnus_prm.prmRegistrationForm;\n\n    // Get HTML and call function to generate modal and event handlers.\n    $.get(prmRegistrationFormPath, { p: Drupal.settings.nbbase.product }, function (data) {\n      var $prmRegistrationFormFragment = $(data).find('.modal-general');\n\n      // Generate modal\n      Drupal.gnusFunctions.gnusModalGenerate($prmRegistrationFormFragment);\n\n      // Tooltip in modal header\n      createAccountTooltip();\n\n      // Event handler for submitting the form.\n      $('form.prm-registration__form').on('submit', errorCheck);\n    });\n\n    // Check that the username/password fields contain data. Show error if not.\n    function errorCheck(e) {\n      e.preventDefault();\n\n      var message = '';\n      var $messagesContainer = $('.prm-messages');\n      var $registerModal = $('.modal--prm-register');\n      var errorCondition = false;\n      var data = {\n        'autologin': true,\n        'username': $('.field-email input', $registerModal).val().trim(),\n        'email': $('.field-email input', $registerModal).val().trim(),\n        'first_name': $('.field-firstname input', $registerModal).val().trim(),\n        'last_name': $('.field-lastname input', $registerModal).val().trim(),\n        'password': $('.field-password input', $registerModal).val().trim(),\n        'customer_id': $('.field-email input', $registerModal).val().trim()\n      };\n\n      // Remove any previous messages.\n      $('> *',$messagesContainer).remove();\n\n      // If username field is empty, display error.\n      if (!data.email.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the email field is filled in.', 'error', ['prm-message prm-message__error']);\n        errorCondition = true;\n      }\n\n      // If password field is empty display error.\n      if (!data.password.length || !$('.field-confirm input', $registerModal).val().length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the password fields are filled in.', 'error', ['prm-message prm-message__error']);\n        errorCondition = true;\n      }\n\n      if (!data.first_name.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the first name field is filled in.', 'error', ['prm-message prm-message__error']);\n        errorCondition = true;\n      }\n\n      if (!data.last_name.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the last name field is filled in.', 'error', ['prm-message prm-message__error']);\n        errorCondition = true;\n      }\n\n      if (data.password !== $('.field-confirm input', $registerModal).val()) {\n        $messagesContainer.gnusSetMessage('Please ensure that the password and confirm password fields match.', 'error', ['prm-message prm-message__error']);\n        errorCondition = true;\n      }\n\n      // If no errors, pass data to registration function.\n      if (errorCondition === false) {\n        var response = nbcore_prm.createUser(data, false);\n        processPrmRegistration(response.response);\n      }\n    }\n\n    // Shows/hides error messages, displays alert form.\n    function processPrmRegistration(response) {\n      var successful = response.data !== undefined;\n      var $messagesContainer = $('.prm-messages');\n      var msgRegisterFail = response.error + ' ' + response.error_message;\n\n      $('> *',$messagesContainer).remove();\n\n      if (successful) {\n        // Remove the modal.\n        Drupal.gnusFunctions.gnusModalClose();\n\n        // Update PRM information settings.\n        Drupal.gnusFunctions.gnus_prm_prmGenerateInfo();\n\n        // Trigger success event\n        $(document).trigger('gnus_prm.register_success');\n\n        // Execute success callback function if exists.\n        if (typeof callbackSuccess == 'function') {\n          callbackSuccess();\n        }\n      }\n      else {\n        $messagesContainer.gnusSetMessage(msgRegisterFail, 'error', ['prm-message prm-message__login--fail']);\n\n        // Trigger fail event\n        $(document).trigger('gnus_prm.register_fail');\n\n        // Execute failure callback function if exists.\n        if (typeof callbackFail == 'function') {\n          callbackFail();\n        }\n      }\n    }\n\n    function createAccountTooltip() {\n      var tooltipMarkup = '\\\n        <div class=\"create-account-icon__text\">\\\n          <p>Easily set up your account to:</p>\\\n          <ul>\\\n            <li>Save, organize and share documents</li>\\\n            <li>Save custom searches</li>\\\n            <li>Create and edit email alerts</li>\\\n          </ul>\\\n        </div>';\n\n      // Append the icon for the popup. The icon contains text for accessibility reasons.\n      $('.modal--prm-register .modal-header h2').append('<div class=\"create-account-icon\" title=\"Create Account Tooltip\" tabindex=\"0\"><span class=\"create-account-icon__text\">' + tooltipMarkup + '</span></div>');\n\n\n      $('.create-account-icon').tooltip({\n        content: tooltipMarkup,\n        tooltipClass: \"gnus-tooltip-popup\",\n        position: {\n          my: \"center bottom-10\",\n          at: \"center top\",\n          collision: \"fit flipfit\",\n          using: Drupal.gnusFunctions.addToolTipClass\n        }\n      });\n    }\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.gnusPrmRegister = gnusPrmRegister;\n\n\n  /*\n   * Generate PRM Account Edit Modal.\n   * @param {requestCallback} callbackSuccess - runs after the login is successful.\n   * @param {requestCallback} callbackFail - runs after the login fails (username, password error, etc).\n   */\n  function gnusPrmAccountEdit(callbackSuccess, callbackFail) {\n    var prmAccountEditFormPath =  Drupal.settings.nbbase.drupalBasePath +\n      Drupal.settings.gnus_prm.prmAccountEditForm;\n\n    // Get HTML and call function to generate modal and event handlers.\n    $.get(prmAccountEditFormPath, function (data) {\n      var $prmAccountEditFormFragment = $(data).find('.modal-general');\n\n      // Generate modal\n      Drupal.gnusFunctions.gnusModalGenerate($prmAccountEditFormFragment);\n\n      // Event handler for submitting the form.\n      $('form.prm-account__form').on('submit', errorCheck);\n\n      // Put the user's email address into the email (non-editable) field.\n      $('.prm-account__form .prm-account__email-text').text(Drupal.settings.gnus_prm.email);\n\n      // Populate first and last name fields with user's current data.\n      $('#prm-account__firstname').val(Drupal.settings.gnus_prm.firstname);\n      $('#prm-account__lastname').val(Drupal.settings.gnus_prm.lastname);\n\n      // If username is different than email address, then display the username.\n      if (Drupal.settings.gnus_prm.email !== Drupal.settings.gnus_prm.username) {\n        $('.prm-account__form .field-username').html(\n          '<label>Username:</label>\\\n          <span class=\"prm-account__username-text\">' + Drupal.settings.gnus_prm.username + '</span>'\n        );\n      }\n    });\n\n    // Check that fields contain data. Show error if not.\n    function errorCheck(e) {\n      e.preventDefault();\n\n      var message = '';\n      var $messagesContainer = $('.prm-messages');\n      var $accountModal = $('.modal--prm-account');\n      var isFormValid = true;\n      var response = null;\n\n      var valPassword = $('.field-password input', $accountModal).val().trim();\n      var valConfirm = $('.field-confirm input', $accountModal).val().trim();\n      var valFirstName = $('.field-firstname input', $accountModal).val().trim();\n      var valLastName = $('.field-lastname input', $accountModal).val().trim();\n\n      var data = {};\n\n      // Remove any previous messages.\n      $('> *',$messagesContainer).remove();\n\n      // Does firstname exist, and has it changed?\n      if (!valFirstName.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the first name field is filled in.', 'error', ['prm-message prm-message__error']);\n        isFormValid = false;\n      }\n      else if (valFirstName !== Drupal.settings.gnus_prm.firstname) {\n        data.first_name = valFirstName;\n      }\n\n      // Does lastname exist and has it changed?\n      if (!valLastName.length) {\n        $messagesContainer.gnusSetMessage('Please ensure that the last name field is filled in.', 'error', ['prm-message prm-message__error']);\n        isFormValid = false;\n      }\n      else if (valLastName !== Drupal.settings.gnus_prm.lastname) {\n        data.last_name = valLastName;\n      }\n\n      // If password field is filled in, make sure they match.\n      if (valPassword !== valConfirm) {\n        $messagesContainer.gnusSetMessage('Please ensure that the password and confirm password fields match.', 'error', ['prm-message prm-message__error']);\n        isFormValid = false;\n      }\n      else if (valPassword.length) {\n        data.password = valPassword;\n      }\n\n      // Pass data to Roger's magical Ajax edit account function.\n      if (isFormValid) {\n        response = nbcore_prm.updateUser(data, false);\n        processPrmAccountEdit(response);\n      }\n    }\n\n    // Shows/hides error messages, displays alert form.\n    function processPrmAccountEdit(response) {\n      var successful = (response && response.success);\n      var $messagesContainer = $('.prm-messages');\n      var msgAccountEditFail = response.error;\n\n      $('> *',$messagesContainer).remove();\n\n      if (successful) {\n        // Remove the login modal.\n        Drupal.gnusFunctions.gnusModalClose();\n\n        // Update PRM information settings.\n        Drupal.gnusFunctions.gnus_prm_prmGenerateInfo();\n\n        // Trigger success event\n        $(document).trigger('gnus_prm.account_success');\n\n        // Execute success callback function if exists.\n        if (typeof callbackSuccess == 'function') {\n          callbackSuccess();\n        }\n      }\n      else {\n        $messagesContainer.gnusSetMessage(msgAccountEditFail, 'error', ['prm-message prm-message__error prm-message__account-edit--fail']);\n\n        // Trigger fail event\n        $(document).trigger('gnus_prm.account_fail');\n\n        // Execute failure callback function if exists.\n        if (typeof callbackFail == 'function') {\n          callbackFail();\n        }\n      }\n    }\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.gnusPrmAccountEdit = gnusPrmAccountEdit;\n\n\n  /*\n   * Logout of PRM function\n   * @param {requestCallback} callbackSuccess - runs after the logout is successful.\n   * @param {requestCallback} callbackFail - runs after the logout fails.\n   */\n  function gnusPrmLogout(callbackSuccess, callbackFail) {\n    var response = nbcore_prm.logout(null, false);\n\n    processPrmLogout(response);\n\n    function processPrmLogout(response) {\n      if (response.success) {\n        // Update PRM information settings.\n        Drupal.gnusFunctions.gnus_prm_prmGenerateInfo();\n\n        // Trigger logout success event\n        $(document).trigger('gnus_prm.logout_success');\n\n        // Execute success callback function if exists.\n        if (typeof callbackSuccess == 'function') {\n          callbackSuccess();\n        }\n\n        // Reload the page if on PRM Pages to reload the React Browse tables.\n        if (window.location.pathname == Drupal.settings.nbbase.drupalBasePath + 'my-folder') {\n          location.reload();\n        }\n      }\n      else {\n        // Trigger logout fail event\n        $(document).trigger('gnus_prm.logout_fail');\n\n        console.error(response.error);\n\n        // Execute success callback function if exists.\n        if (typeof callbackFail == 'function') {\n          callbackFail();\n        }\n      }\n    }\n  }\n\n  Drupal.gnusFunctions = Drupal.gnusFunctions || {};\n  Drupal.gnusFunctions.gnus_prm_gnusPrmLogout = gnusPrmLogout;\n})(jQuery);\n"
          },
