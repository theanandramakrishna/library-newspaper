          "content": {
            "size": 2792,
            "mimeType": "application/javascript",
            "text": "(function($) {\n  'use strict';\n\n  /*\n   * Generate Email Alerts Modal\n   */\n  Drupal.behaviors.showEmailAlertsModal = {\n    attach: function (context, settings) {\n      var $alertModal = $('.modal--email-alert');\n\n      $('.button-email-alert', context).gnusModal($('.modal--email-alert'), initialState);\n\n      // Set initial state of the modal.\n      function initialState() {\n        if (typeof Drupal.settings.gnus_prm == 'undefined' || typeof Drupal.settings.gnus_prm.isAnonymous == 'undefined') {\n          Drupal.gnusFunctions.gnus_prm_prmGenerateInfo(); // Checks if user is authenticated to PRM.\n        }\n\n        // Remove any PRM Login succcess/error messages.\n        $('.modal--email-alert .prm-messages > *').remove();\n\n        // Set initial state. Initial state cannot be login form.\n        if (Drupal.settings.gnus_prm.isAnonymous) {\n          //show login form\n          switchView('guest');\n        }\n        else {\n          switchView('authenticated')\n        }\n      }\n\n      // Helper function to switch email alert views between initial, guest, login, and authenticated.\n      function switchView(view) {\n\n        // Remove any messages on email alert form.\n        $('.messages', $alertModal).remove();\n\n        switch(view) {\n          case 'guest':\n            insertLoginbutton();\n            break;\n\n          case 'login':\n            // trigger PRM login form creation\n            Drupal.gnusFunctions.gnus_prm_gnusPrmLogin(callbackSuccess);\n            break;\n\n          case 'authenticated':\n            $alertModal.addClass('is-prm-authenticated').addClass('js-modal--active');\n            $('.modal-footer .modal--email-alert__prm-login', $alertModal).remove();\n            break;\n        }\n      }\n\n      // Insert \"Sign In\" link to the bottom right of the alert form.\n      function insertLoginbutton() {\n        if (Drupal.settings.gnus_prm.isAnonymous && !$('.modal--email-alert__prm-login').length) {\n          $('.modal-footer', $alertModal).append('<div class=\"modal--email-alert__prm-login\">Or <button type=\"button\" class=\"modal--email-alert__prm-login-button\">Sign In to My Folder</button></div>');\n          $('.modal--email-alert__prm-login-button', $alertModal).on('click', function () {\n            switchView('login');\n          })\n        }\n      }\n\n      // Ensure that login button gets inserted when Drupal Behaviors run (when form is ajaxed in after error).\n      insertLoginbutton();\n\n      // Callback function to be executed on login success\n      function callbackSuccess() {\n        $('body').addClass('js-overlay--active');\n        switchView('authenticated');\n        $('.prm-messages', $alertModal).append('<div class=\"messages prm-message prm-message__login--success\">Login successful.</div>');\n      }\n    }\n  };\n\n})(jQuery);\n"
          },
